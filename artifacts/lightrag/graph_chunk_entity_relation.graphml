      <data key="d1">event</data>
      <data key="d2">A specific stage in the FIGO system for cervical cancer where the cancer has grown into the lower third of the vagina.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-136</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522138</data>
