    <node id="Menopause">
      <data key="d0">Menopause</data>
      <data key="d1">condition</data>
      <data key="d2">A natural biological process in women characterized by the cessation of menstruation and the end of fertility.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
