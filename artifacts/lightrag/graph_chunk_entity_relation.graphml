    <node id="Mohs surgery">
      <data key="d0">Mohs surgery</data>
      <data key="d1">method</data>
      <data key="d2">A surgical procedure that allows the surgeon to know right away whether all cancer was removed.&lt;SEP&gt;A surgical technique for removing cancerous tissue from the skin.&lt;SEP&gt;A surgical technique used for high-risk or very high-risk CSCC, where the cancer is removed layer by layer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-008&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-012&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-013</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522040</data>
