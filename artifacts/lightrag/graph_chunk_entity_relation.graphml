    <node id="Lymphatic or lymph system">
      <data key="d0">Lymphatic or lymph system</data>
      <data key="d1">system</data>
      <data key="d2">A network of tissues and organs that helps the body fight infections and disease.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-025</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522094</data>
