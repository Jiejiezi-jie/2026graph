    <node id="Digital rectal exam">
      <data key="d0">Digital rectal exam</data>
      <data key="d1">method</data>
      <data key="d2">A physical examination of the rectum and prostate gland performed by inserting a gloved finger into the rectum.&lt;SEP&gt;A procedure where a doctor inserts a finger into the rectum to feel the prostate for signs of cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-081&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-082</data>
