    <node id="Lactate dehydrogenase (LDH)">
      <data key="d0">Lactate dehydrogenase (LDH)</data>
      <data key="d1">method</data>
      <data key="d2">An enzyme found in most cells that is released into the blood by dying cells.&lt;SEP&gt;An enzyme that can be measured in the blood to assess the health of organs like the liver and kidneys.&lt;SEP&gt;An enzyme found in most cells, released by dying cells and fast-growing cells like tumor cells.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-034&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-068&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-155</data>
      <data key="d4">unknown_source</data>
