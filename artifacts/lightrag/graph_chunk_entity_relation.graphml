      <data key="d1">concept</data>
      <data key="d2">A specific genetic mutation in the BRAF gene, which can be associated with certain types of cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-048</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522134</data>
      <data key="d6" />
