    <node id="External beam radiation therapy (EBRT)">
      <data key="d0">External beam radiation therapy (EBRT)</data>
      <data key="d1">method</data>
      <data key="d2">A type of radiation therapy that uses high-energy waves to kill cancer cells.&lt;SEP&gt;A type of radiation therapy that uses high-energy x-rays to kill cancer cells.&lt;SEP&gt;A type of radiation therapy where high-energy x-rays or particles are used to destroy cancer cells.&lt;SEP&gt;A form of radiation therapy used for bladder cancer where a large machine aims radiation at the tumor area.&lt;SEP&gt;A type of radiation therapy that delivers radiation from outside the body using a large machine called a linear accelerator.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-148&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-183&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522138</data>
      <data key="d6" />
    </node>
    <node id="Intensity-modulated radiation therapy (IMRT)">
      <data key="d0">Intensity-modulated radiation therapy (IMRT)</data>
      <data key="d1">procedure</data>
      <data key="d2">An advanced type of EBRT that uses many small beams of different strengths to deliver radiation.&lt;SEP&gt;An advanced radiation technique used to treat anal cancer, which involves shaping the radiation beams to the tumor.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522138</data>
      <data key="d6" />
    </node>
