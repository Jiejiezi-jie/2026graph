    <node id="External beam radiation therapy">
      <data key="d0">External beam radiation therapy</data>
      <data key="d1">method</data>
      <data key="d2">A type of radiation therapy delivered outside the body to treat cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137</data>
      <data key="d4">unknown_source</data>
