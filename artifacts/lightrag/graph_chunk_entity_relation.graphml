    <node id="Scleroderma">
      <data key="d0">Scleroderma</data>
      <data key="d1">concept</data>
      <data key="d2">A chronic autoimmune disease that causes the skin and other organs to become thick and hard.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-009</data>
      <data key="d4">unknown_source</data>
