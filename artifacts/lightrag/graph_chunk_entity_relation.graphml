    <node id="Hormone therapy">
      <data key="d0">Hormone therapy</data>
      <data key="d1">method</data>
      <data key="d2">A treatment for prostate cancer that involves blocking the production of hormones that stimulate the growth of cancer cells.&lt;SEP&gt;A treatment option for advanced-stage prostate cancer that involves altering hormone levels.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-081&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-088</data>
