    <node id="Stage 1">
      <data key="d0">Stage 1</data>
      <data key="d1">concept</data>
      <data key="d2">The earliest stage of lung cancer, indicating growth from the airway into lung tissue.&lt;SEP&gt;Invasive breast cancer, rated stage 1, where the cancer has grown outside the ducts, lobules, or breast skin, and might be in the axillary lymph nodes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-017&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-108</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522082</data>
