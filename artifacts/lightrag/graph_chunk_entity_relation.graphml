      <data key="d1">other</data>
      <data key="d2">An EGFR inhibitor used to treat squamous cell skin cancer (CSCC) and other cancers.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-010</data>
