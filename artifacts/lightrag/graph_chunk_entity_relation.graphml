    <node id="Active surveillance">
      <data key="d0">Active surveillance</data>
      <data key="d1">method</data>
      <data key="d2">A management strategy for early-stage prostate cancer where regular tests are conducted to monitor the cancer without immediate treatment.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-081</data>
      <data key="d4">unknown_source</data>
