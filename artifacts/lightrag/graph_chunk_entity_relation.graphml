    <node id="Curettage and electrodesiccation (C&amp;E)">
      <data key="d0">Curettage and electrodesiccation (C&amp;E)</data>
      <data key="d1">method</data>
      <data key="d2">A two-step system of scraping then burning to remove cancer cells.&lt;SEP&gt;A surgical technique for removing cancerous tissue from the skin.&lt;SEP&gt;A surgical method for treating low-risk CSCC, which involves scraping off the cancer and then burning the area with an electric current.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-008&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-012&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-013</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522040</data>
      <data key="d6" />
    </node>
    <node id="Peripheral and deep en face margin assessment (PDEMA)">
      <data key="d0">Peripheral and deep en face margin assessment (PDEMA)</data>
      <data key="d1">method</data>
      <data key="d2">A type of surgery used for treatment on specific body areas to remove cancer while sparing normal tissue.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-008</data>
