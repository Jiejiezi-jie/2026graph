    <node id="Cone biopsy">
      <data key="d0">Cone biopsy</data>
      <data key="d1">method</data>
      <data key="d2">A medical procedure where a cone-shaped portion of the cervix is removed to gather more information or treat early cervical cancer.&lt;SEP&gt;A surgical procedure where a cone-shaped piece of tissue is removed from the cervix to examine the tissue under a microscope.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141</data>
