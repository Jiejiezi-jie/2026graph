    <node id="Blood test">
      <data key="d0">Blood test</data>
      <data key="d1">method</data>
      <data key="d2">A medical test where a sample of blood is taken from a vein to examine cells, proteins, and other components for signs of disease.&lt;SEP&gt;A diagnostic procedure where a small sample of blood is collected and analyzed to confirm the presence of chronic lymphocytic leukemia (CLL).</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-082&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-169</data>
