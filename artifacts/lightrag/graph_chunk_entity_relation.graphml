    <node id="Sentinel Lymph Node Biopsy (SLNB)">
      <data key="d0">Sentinel Lymph Node Biopsy (SLNB)</data>
      <data key="d1">method</data>
      <data key="d2">A surgical procedure that removes tissue samples from the first lymph node to which cancer cells are likely to spread.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-009</data>
