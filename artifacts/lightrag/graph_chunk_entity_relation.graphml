    <node id="Bone scan">
      <data key="d0">Bone scan</data>
      <data key="d1">method</data>
      <data key="d2">An imaging test that uses a radioactive tracer to detect abnormalities in the bones.&lt;SEP&gt;A diagnostic imaging technique that uses a radioactive tracer to detect bone abnormalities.&lt;SEP&gt;A method that uses a radiotracer to take pictures of the bones.&lt;SEP&gt;A test that uses a radiotracer to detect areas of bone damage.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-082&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-091&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-102&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-155</data>
