    <node id="Diffuse large B-cell lymphoma (DLBCL)">
      <data key="d0">Diffuse large B-cell lymphoma (DLBCL)</data>
      <data key="d1">typeoflymphoma</data>
      <data key="d2">A more aggressive type of lymphoma that can arise from follicular lymphoma.&lt;SEP&gt;A type of non-Hodgkin lymphoma that develops from B lymphocytes and is more aggressive than chronic lymphocytic leukemia (CLL).</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-025&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-169</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522094</data>
      <data key="d6" />
    </node>
    <node id="Chromosome translocation">
      <data key="d0">Chromosome translocation</data>
      <data key="d1">geneticchange</data>
      <data key="d2">A genetic alteration where part of one chromosome switches with another chromosome within the lymphoma cells.</data>
