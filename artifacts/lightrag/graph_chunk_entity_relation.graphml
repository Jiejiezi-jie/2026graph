      <data key="d0">Stereotactic body radiation therapy (SBRT)</data>
      <data key="d1">procedure</data>
      <data key="d2">A highly specialized type of EBRT used to treat metastatic cervical cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522138</data>
