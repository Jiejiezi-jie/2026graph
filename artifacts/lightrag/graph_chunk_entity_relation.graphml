      <data key="d4">unknown_source</data>
      <data key="d5">1788522094</data>
      <data key="d6" />
    </node>
    <node id="BCL2 protein">
      <data key="d0">BCL2 protein</data>
      <data key="d1">protein</data>
      <data key="d2">A protein involved in follicular lymphoma.</data>
