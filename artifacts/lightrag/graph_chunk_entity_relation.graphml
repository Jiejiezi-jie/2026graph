      <data key="d0">Early and locally advanced NSCLC</data>
      <data key="d1">concept</data>
      <data key="d2">Lung cancers that have not spread beyond the lung tissue or nearby structures.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-017</data>
