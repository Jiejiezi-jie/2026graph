    <node id="cervical cancer">
      <data key="d0">cervical cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Cervical cancer is a type of cancer that develops in the cervix, the lower part of the uterus.&lt;SEP&gt;A type of cancer that affects the cervix.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-143</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522138</data>
      <data key="d6" />
    </node>
    <node id="chemoradiation">
      <data key="d0">chemoradiation</data>
      <data key="d1">method</data>
      <data key="d2">Chemoradiation is a treatment strategy that combines external beam radiation therapy (EBRT) and chemotherapy to treat cervical cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522138</data>
      <data key="d6" />
    </node>
    <node id="intracavitary brachytherapy">
      <data key="d0">intracavitary brachytherapy</data>
      <data key="d1">method</data>
      <data key="d2">Intracavitary brachytherapy is a type of brachytherapy where radioactive material is placed inside the body, targeting the tumor while minimizing exposure to surrounding normal tissue.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522138</data>
      <data key="d6" />
    </node>
    <node id="interstitial brachytherapy">
      <data key="d0">interstitial brachytherapy</data>
      <data key="d1">method</data>
      <data key="d2">Interstitial brachytherapy is a specialized technique where additional instruments are placed in the tumor or tissues next to the tumor to deliver radiation.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522138</data>
      <data key="d6" />
    </node>
    <node id="high dose-rate (HDR) brachytherapy">
      <data key="d0">high dose-rate (HDR) brachytherapy</data>
      <data key="d1">method</data>
      <data key="d2">High dose-rate brachytherapy is a type of brachytherapy where a high dose of radiation is delivered in short bursts.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522138</data>
      <data key="d6" />
    </node>
    <node id="low dose-rate (LDR) brachytherapy">
      <data key="d0">low dose-rate (LDR) brachytherapy</data>
      <data key="d1">method</data>
      <data key="d2">Low dose-rate brachytherapy is a type of brachytherapy where a low dose of radiation is delivered in long bursts.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522138</data>
      <data key="d6" />
    </node>
    <node id="tandem and ring applicator">
      <data key="d0">tandem and ring applicator</data>
      <data key="d1">artifact</data>
      <data key="d2">A tandem and ring applicator is a device used in brachytherapy to deliver radiation to the cervix, uterus, and vagina.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522138</data>
      <data key="d6" />
    </node>
    <node id="tandem and ovoid applicator">
      <data key="d0">tandem and ovoid applicator</data>
      <data key="d1">artifact</data>
      <data key="d2">A tandem and ovoid applicator is a device used in brachytherapy to deliver radiation to the cervix, uterus, and vagina.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522138</data>
      <data key="d6" />
    </node>
    <node id="cisplatin">
      <data key="d0">cisplatin</data>
      <data key="d1">method</data>
      <data key="d2">Cisplatin is a platinum-based chemotherapy drug used to treat cervical cancer by stopping the growth of cancer cells.&lt;SEP&gt;A platinum-based chemotherapy medicine.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-193</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522138</data>
      <data key="d6" />
    </node>
    <node id="Trachelectomy">
      <data key="d0">Trachelectomy</data>
      <data key="d1">surgery</data>
      <data key="d2">Surgery that removes the cervix, a type of fertility-sparing surgery.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-140</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522138</data>
      <data key="d6" />
    </node>
    <node id="Early-stage cancer">
      <data key="d0">Early-stage cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Cancers that are only in the cervix (stage 1) or have spread to the upper vagina (stage 2A).</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522138</data>
      <data key="d6" />
    </node>
    <node id="Locally advanced cancer">
      <data key="d0">Locally advanced cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Cancers that have spread beyond the cervix but not to distant parts of the body.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522138</data>
      <data key="d6" />
    </node>
    <node id="Surveillance">
      <data key="d0">Surveillance</data>
      <data key="d1">method</data>
      <data key="d2">Monitoring the condition of patients to detect any changes in the disease status.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522138</data>
      <data key="d6" />
    </node>
    <node id="Recurrence">
      <data key="d0">Recurrence</data>
      <data key="d1">event</data>
      <data key="d2">The reappearance of cancer after initial treatment.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522138</data>
      <data key="d6" />
    </node>
    <node id="Lymphovascular space invasion (LVSI)">
      <data key="d0">Lymphovascular space invasion (LVSI)</data>
      <data key="d1">concept</data>
      <data key="d2">The presence of tumor cells in the blood vessels or lymph vessels inside the tumor, indicating a higher risk of cancer spreading.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522138</data>
      <data key="d6" />
    </node>
    <node id="Radical trachelectomy">
      <data key="d0">Radical trachelectomy</data>
      <data key="d1">method</data>
      <data key="d2">A surgical procedure that removes the cervix and part of the vagina, preserving the uterus and ovaries.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522138</data>
      <data key="d6" />
    </node>
    <node id="Pelvic lymph node evaluation">
      <data key="d0">Pelvic lymph node evaluation</data>
      <data key="d1">method</data>
