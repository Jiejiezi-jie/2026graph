    <node id="Cervical biopsy">
      <data key="d0">Cervical biopsy</data>
      <data key="d1">method</data>
      <data key="d2">A medical procedure where samples of cervical tissue are removed and tested for dysplasia and cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137</data>
