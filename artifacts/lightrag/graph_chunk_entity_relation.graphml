    <node id="Stage 1A">
      <data key="d0">Stage 1A</data>
      <data key="d1">event</data>
      <data key="d2">A classification of ovarian cancer where cancer is confined to one ovary, the outer sac is intact, and there is no cancer on the outside surface of the ovary.&lt;SEP&gt;A specific stage in the FIGO system for cervical cancer where the cancer is 5 millimeters or smaller.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-136</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522134</data>
      <data key="d6" />
    </node>
    <node id="Stage 1B">
      <data key="d0">Stage 1B</data>
      <data key="d1">event</data>
      <data key="d2">A classification of ovarian cancer where cancer is in both ovaries, the outer sacs are intact, and there is no cancer on the outside surface of the ovaries.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522134</data>
      <data key="d6" />
    </node>
    <node id="Stage 1C">
      <data key="d0">Stage 1C</data>
      <data key="d1">event</data>
      <data key="d2">A classification of ovarian cancer where cancer is in one or both ovaries, and one or more of the following has occurred: the outer sac broke open during surgery, cancer is on the outer surface of the ovary or fallopian tube, or cancer cells are found in ascites or washings.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522134</data>
      <data key="d6" />
    </node>
    <node id="Stage 2A">
      <data key="d0">Stage 2A</data>
      <data key="d1">event</data>
      <data key="d2">A classification of ovarian cancer where cancer is in one or both ovaries and has grown into and/or spread implants on the uterus and/or fallopian tubes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522134</data>
      <data key="d6" />
    </node>
    <node id="Stage 2B">
      <data key="d0">Stage 2B</data>
      <data key="d1">event</data>
      <data key="d2">A classification of ovarian cancer where cancer is in one or both ovaries and has grown into and/or spread implants on other organs or tissues in the pelvis, such as the bladder, colon, or rectum.&lt;SEP&gt;A specific stage in the FIGO system for cervical cancer where the cancer has grown into the parametrium.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-136</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522134</data>
      <data key="d6" />
    </node>
    <node id="Stage 3A1">
      <data key="d0">Stage 3A1</data>
      <data key="d1">event</data>
      <data key="d2">A classification of ovarian cancer where cancer is in one or both ovaries and has spread to lymph nodes in the back of the abdomen (retroperitoneal lymph nodes), with further subcategories based on the size of the cancer in the lymph nodes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522134</data>
      <data key="d6" />
    </node>
    <node id="Stage 3A2">
      <data key="d0">Stage 3A2</data>
      <data key="d1">event</data>
      <data key="d2">A classification of ovarian cancer where cancer has spread to the tissue lining the abdomen, which is so small it can only be seen with a microscope, and there may also be cancer in lymph nodes in the back of the abdomen.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522134</data>
      <data key="d6" />
    </node>
    <node id="Stage 3B">
      <data key="d0">Stage 3B</data>
      <data key="d1">event</data>
      <data key="d2">A classification of ovarian cancer where there is visible cancer on the tissue lining the abdomen, the area of cancer is smaller than a peanut (about 2 centimeters or smaller), and there may also be cancer in lymph nodes in the back of the abdomen.&lt;SEP&gt;A specific stage in the FIGO system for cervical cancer where the cancer has grown into the pelvic wall and/or has caused kidney swelling or dysfunction.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-136</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522134</data>
      <data key="d6" />
    </node>
    <node id="Stage 3C">
      <data key="d0">Stage 3C</data>
      <data key="d1">event</data>
      <data key="d2">A classification of ovarian cancer where there is visible cancer on the tissue lining the abdomen, the area of cancer is larger than 2 cm, and there might be cancer in lymph nodes in the back of the abdomen. The cancer may have also spread to the outer surface of the liver or spleen.&lt;SEP&gt;A specific stage in the FIGO system for cervical cancer where there is cancer in lymph nodes near the cervix and/or in lymph nodes in the abdomen.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-136</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522134</data>
      <data key="d6" />
    </node>
    <node id="Stage 4A">
      <data key="d0">Stage 4A</data>
      <data key="d1">event</data>
      <data key="d2">A classification of ovarian cancer where cancer cells are in&lt;SEP&gt;A specific stage in the FIGO system for cervical cancer where the cancer has&lt;SEP&gt;A specific stage classification for cervical cancer, indicating the most advanced stage of the disease.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-136&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
