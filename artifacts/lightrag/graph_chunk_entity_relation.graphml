    <node id="Standard surgical excision">
      <data key="d0">Standard surgical excision</data>
      <data key="d1">method</data>
      <data key="d2">A surgical removal of the tumor and surrounding normal tissue.&lt;SEP&gt;A surgical technique for removing cancerous tissue from the skin.&lt;SEP&gt;A surgical procedure where a wider margin of normal tissue around the lesion is removed for high-risk or very high-risk CSCC.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-008&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-012&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-013</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522040</data>
      <data key="d6" />
    </node>
    <node id="Lymph node dissection">
      <data key="d0">Lymph node dissection</data>
      <data key="d1">method</data>
      <data key="d2">An extensive surgery to remove enlarged lymph nodes near a squamous cell skin cancer tumor.&lt;SEP&gt;A surgical procedure where lymph nodes are removed to test for cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-008&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
