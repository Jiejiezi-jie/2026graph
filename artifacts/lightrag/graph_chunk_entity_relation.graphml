    <node id="PET">
      <data key="d0">PET</data>
      <data key="d1">method</data>
      <data key="d2">A type of imaging test that uses radioactive tracers to create detailed images of the body's metabolic activity.&lt;SEP&gt;A diagnostic imaging method that combines positron emission tomography with computed tomography to visualize metabolic activity in the body.&lt;SEP&gt;A type of imaging technique used to visualize metabolic activity within the body.&lt;SEP&gt;A medical imaging technique that involves injecting radioactive glucose into the body to detect cancer cells.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-082&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-135&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-187</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522138</data>
