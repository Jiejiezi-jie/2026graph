    <node id="Follicular lymphoma">
      <data key="d0">Follicular lymphoma</data>
      <data key="d1">other</data>
      <data key="d2">A type of non-Hodgkin lymphoma characterized by the formation of follicles in the lymph nodes.&lt;SEP&gt;A slow-growing lymphoma that typically forms tumors in the lymph nodes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-024&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-025</data>
