    <node id="Stage 1B1">
      <data key="d0">Stage 1B1</data>
      <data key="d1">event</data>
      <data key="d2">A specific stage in the FIGO system for cervical cancer where the cancer is larger than 5 mm but smaller than 2 cm.&lt;SEP&gt;A specific stage classification for cervical cancer, indicating a more advanced stage compared to Stage 1A1 and 1A2.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-136&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
