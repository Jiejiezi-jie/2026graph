      <data key="d0">Barrett esophagus</data>
      <data key="d1">concept</data>
      <data key="d2">A condition where the squamous cells lining the lower part of the esophagus change or are replaced with abnormal cells due to chronic reflux.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-021</data>
