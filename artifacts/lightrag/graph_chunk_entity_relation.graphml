    <node id="Larynx">
      <data key="d0">Larynx</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A specific part of the throat also known as the voice box.&lt;SEP&gt;The voice box.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-049&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-126</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788522134</data>
