    <node id="NCCN.org">
      <data key="d0">NCCN.org</data>
      <data key="d1">organization</data>
      <data key="d2">Website for accessing the NCCN Guidelines for Patients.&lt;SEP&gt;A website providing patient guidelines and resources for cancer care.&lt;SEP&gt;A website providing guidelines and resources for cancer patients.&lt;SEP&gt;A non-profit organization that provides guidelines for the treatment of cancer.&lt;SEP&gt;A website and resource for patient guidelines and cancer information.&lt;SEP&gt;A website providing patient guidelines and information on fertility preservation.&lt;SEP&gt;A website providing information on cancer treatment.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-022&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-023&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-028&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-031&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-049&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-052&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-190</data>
