{
  "seed": 42,
  "benchmark_dir": "data/vendor/GraphRAG-Benchmark",
  "question_types": [
    "Fact Retrieval",
    "Complex Reasoning"
  ],
  "p0_per_type": 1,
  "p1_per_type": 60,
  "train_fraction": 0.6,
  "validation_fraction": 0.2,
  "test_fraction": 0.2,
  "chunk_tokens": 1200,
  "chunk_overlap_tokens": 100,
  "vector_top_k": 5,
  "lightrag_top_k": 40,
  "lightrag_chunk_top_k": 5,
  "pathrag_top_k": 20,
  "max_context_tokens": 5000,
  "llm": {
    "backend": "openai_compatible",
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-chat",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.0,
    "max_new_tokens": 256,
    "max_callback_new_tokens": 4096,
    "timeout_seconds": 120,
    "max_retries": 3
  },
  "evaluation": {
    "max_new_tokens": 4096,
    "response_retries": 1,
    "request_retries": 1
  },
  "embedding": {
    "backend": "transformers",
    "model_path": "models/bge-m3",
    "device": "cuda:5",
    "batch_size": 4,
    "max_length": 2048,
    "normalize": true,
    "min_free_gib": 8
  },
  "router": {
    "family": "bge_m3_multioutput_ridge",
    "ridge_alpha": 0.001,
    "evidence_weight": 0.15
  },
  "generation_prompt": "Answer the medical question using only the supplied context. Give a direct, concise answer. If the context is insufficient, say I don't know.",
  "results_dir": "results_shared_lightrag_unified_latency",
  "lightrag_max_entity_tokens": 1500,
  "lightrag_max_relation_tokens": 1500,
  "lightrag_max_total_tokens": 12000,
  "_note": "Controlled 24-question rerun on one device and one API credential. Runtime index copies preserve the byte-identical shared LightRAG graph and start with empty query-response caches."
}
