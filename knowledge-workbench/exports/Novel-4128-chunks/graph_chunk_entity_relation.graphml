      <data key="d0">Worcester House</data>
      <data key="d1">location</data>
      <data key="d2">House by the river where Dean Fuller is landed from a sculler.&lt;SEP&gt;House where several Lords met in Council and where the King arrived while Pepys waited.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-005&lt;SEP&gt;doc-cf47789c7f6b678113755e09e7199138-chunk-040</data>
