    <node id="Portugal">
      <data key="d0">Portugal</data>
      <data key="d1">location</data>
      <data key="d2">Country to which Katherine of Braganza returned after the death of Charles II and where Katherine became Regent in 1704.&lt;SEP&gt;The country for which Lord Sandwich's preparations required 5,000 pounds.&lt;SEP&gt;The country to which Capt. Isham is about to make a voyage.&lt;SEP&gt;The destination of Mr Fanshaw and Captain Isham's voyage and the country for which Lord Sandwich's departure was being prepared.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-006&lt;SEP&gt;doc-cf47789c7f6b678113755e09e7199138-chunk-034&lt;SEP&gt;doc-cf47789c7f6b678113755e09e7199138-chunk-043&lt;SEP&gt;doc-cf47789c7f6b678113755e09e7199138-chunk-045</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788445848</data>
      <data key="d6" />
    </node>
    <node id="Somerset House">
      <data key="d0">Somerset House</data>
      <data key="d1">location</data>
      <data key="d2">London residence where Katherine of Braganza lived for some time after the death of Charles II.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-006</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788445848</data>
