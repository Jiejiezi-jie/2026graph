      <data key="d11">unknown_source</data>
      <data key="d12">1788445934</data>
      <data key="d13" />
    </edge>
    <edge source="Narrator" target="Narrator's House">
      <data key="d7">3.0</data>
      <data key="d8">The Narrator took Mr. Creed to his house, entertained dinner guests, and later returned there after his visit to the Office.&lt;SEP&gt;The Narrator took Lady Jem and Pall to his house to show it to them and treated them well.&lt;SEP&gt;The narrator gave fruit and wine to Lord Hinchingbroke at the Narrator's House, which is the location referred to as "my house."</data>
      <data key="d9">hosted at,hosted visit at,lived at,showed,took_guests_to</data>
