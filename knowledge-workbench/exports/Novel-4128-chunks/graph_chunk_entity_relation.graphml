    <node id="Don Pedro">
      <data key="d0">Don Pedro</data>
      <data key="d1">person</data>
      <data key="d2">Brother of Katherine of Braganza; in 1704 Don Pedro retired, after which Katherine became Regent of Portugal.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-006</data>
