      <data key="d0">The Burial of Sir John Lawson's Daughter</data>
      <data key="d1">event</data>
      <data key="d2">Burial ceremony for Sir John Lawson's daughter, attended by My Lady Batten and the diarist's wife, who received funeral rings for themselves and their husbands.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-017</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788445866</data>
