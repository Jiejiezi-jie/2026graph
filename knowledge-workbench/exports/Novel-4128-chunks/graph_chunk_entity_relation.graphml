    <node id="My Lady at Wardrobe">
      <data key="d0">My Lady at Wardrobe</data>
      <data key="d1">person</data>
      <data key="d2">My Lady at Wardrobe is the woman who dined with the narrator at the Wardrobe and treated the narrator kindly.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-004</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788445843</data>
