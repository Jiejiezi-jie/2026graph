    <node id="Mrs. Holland">
      <data key="d0">Mrs. Holland</data>
      <data key="d1">person</data>
      <data key="d2">The wife of Mr. Holland, described as a plain dowdy, who is paid the money owed by the diarist to her husband.&lt;SEP&gt;Mrs. Holland is Mr. Holland's wife; she received the money that the narrator owed to her husband.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-003&lt;SEP&gt;doc-cf47789c7f6b678113755e09e7199138-chunk-004</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788445843</data>
      <data key="d6" />
    </node>
    <node id="Norwich">
      <data key="d0">Norwich</data>
      <data key="d1">artifact</data>
      <data key="d2">A ship of which Captain Lambert has been made captain.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-003</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788445843</data>
      <data key="d6" />
    </node>
    <node id="Wardrobe">
      <data key="d0">Wardrobe</data>
      <data key="d1">location</data>
      <data key="d2">A place visited by the diarist on the way to Whitehall and Westminster.&lt;SEP&gt;The Wardrobe is the place where the narrator dined with My Lady and where Mr. Townsend is connected to a mystery.&lt;SEP&gt;Building to which the Narrator returns; My Lord is found there before going to Trinity House, and My Lady and the children dine there with the Narrator.&lt;SEP&gt;The place where the narrator goes and dines with My Lady.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-003&lt;SEP&gt;doc-cf47789c7f6b678113755e09e7199138-chunk-004&lt;SEP&gt;doc-cf47789c7f6b678113755e09e7199138-chunk-006&lt;SEP&gt;doc-cf47789c7f6b678113755e09e7199138-chunk-010</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788445843</data>
      <data key="d6" />
    </node>
    <node id="Greenwich">
      <data key="d0">Greenwich</data>
      <data key="d1">location</data>
      <data key="d2">A place reached by water where the diarist and Captain Lambert eat, drink, and hear music at the Globe.&lt;SEP&gt;A place on the Thames where the King's yacht is seen.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-003&lt;SEP&gt;doc-cf47789c7f6b678113755e09e7199138-chunk-009</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788445843</data>
      <data key="d6" />
    </node>
    <node id="The Globe">
      <data key="d0">The Globe</data>
      <data key="d1">location</data>
      <data key="d2">A place in Greenwich where the diarist and Captain Lambert go to eat, drink, and hear music, and where a woman with a rod keeps time to the music.&lt;SEP&gt;The theatre where the 1608 comedy was acted.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-003&lt;SEP&gt;doc-cf47789c7f6b678113755e09e7199138-chunk-035</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788445843</data>
      <data key="d6" />
    </node>
    <node id="Bridewell">
      <data key="d0">Bridewell</data>
      <data key="d1">location</data>
      <data key="d2">A place visited by the diarist and Captain Lambert in order to go to Mr. Holland's house.&lt;SEP&gt;Bridewell is the location of Mr. Holland's house, where the narrator and the Captain went.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-003&lt;SEP&gt;doc-cf47789c7f6b678113755e09e7199138-chunk-004</data>
