    </node>
    <node id="Spotted Fever">
      <data key="d0">Spotted Fever</data>
      <data key="d1">concept</data>
      <data key="d2">Disease that caused the death of Mr. Saml. Crew.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-017</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788445866</data>
