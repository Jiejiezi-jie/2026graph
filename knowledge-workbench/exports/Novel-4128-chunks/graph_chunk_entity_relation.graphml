    <node id="Flageolette">
      <data key="d0">Flageolette</data>
      <data key="d1">artifact</data>
      <data key="d2">A musical instrument that the diarist takes in hot weather and plays upon the garden leads.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-003</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788445843</data>
