      <data key="d0">Swan Tavern</data>
      <data key="d1">location</data>
      <data key="d2">Drinking establishment visited by The Diarist, Mr. Pierce, and Mr. Symons.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-005</data>
