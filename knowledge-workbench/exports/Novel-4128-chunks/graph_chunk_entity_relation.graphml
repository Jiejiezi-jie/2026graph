      <data key="d0">Jane Shore's Tower</data>
      <data key="d1">location</data>
      <data key="d2">Tower associated with The Wardrobe. The Diarist and W. Howe go up there and sing.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-005</data>
