    </node>
    <node id="Sir William Davenant">
      <data key="d0">Sir William Davenant</data>
      <data key="d1">person</data>
      <data key="d2">Person whose opera house staged the second part of "The Siege of Rhodes".&lt;SEP&gt;A person noted in the text for introducing the use of scenery; he taught Betterton how the part of Hamlet was acted by Taylor of the Blackfriars.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-017&lt;SEP&gt;doc-cf47789c7f6b678113755e09e7199138-chunk-043</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788445866</data>
      <data key="d6" />
    </node>
    <node id="Sir William Davenant's Opera">
      <data key="d0">Sir William Davenant's Opera</data>
      <data key="d1">location</data>
      <data key="d2">Opera house attended by the diarist; had been presenting the second part of "The Siege of Rhodes" for four days.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-017</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788445866</data>
      <data key="d6" />
    </node>
    <node id="The Siege of Rhodes">
      <data key="d0">The Siege of Rhodes</data>
      <data key="d1">content</data>
      <data key="d2">Dramatic work whose second part was acted at Sir William Davenant's Opera; the performance included the character Eunuch.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-017</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788445866</data>
      <data key="d6" />
    </node>
    <node id="The Queen of Bohemia">
      <data key="d0">The Queen of Bohemia</data>
      <data key="d1">person</data>
      <data key="d2">Queen who attended Sir William Davenant's Opera and was waited for by the audience.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-017</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788445866</data>
      <data key="d6" />
    </node>
    <node id="The Eunuch">
      <data key="d0">The Eunuch</data>
      <data key="d1">person</data>
      <data key="d2">Performer in "The Siege of Rhodes" at Sir William Davenant's Opera; performed so poorly that the audience hissed the performer off the stage.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-017</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788445866</data>
      <data key="d6" />
    </node>
    <node id="Mr. Saml. Crew">
      <data key="d0">Mr. Saml. Crew</data>
      <data key="d1">person</data>
      <data key="d2">Brother of My Lady; died the previous day of the spotted fever.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-017</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788445866</data>
