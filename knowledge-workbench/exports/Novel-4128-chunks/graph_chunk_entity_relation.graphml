    <node id="Duck Lane">
      <data key="d0">Duck Lane</data>
      <data key="d1">location</data>
      <data key="d2">Street through which the diarist passed while looking for Spanish books.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-017</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788445866</data>
      <data key="d6" />
    </node>
    <node id="Sir John Lawson">
      <data key="d0">Sir John Lawson</data>
      <data key="d1">person</data>
      <data key="d2">Father of the daughter buried on that day; funeral rings were given because of that daughter.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-017</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788445866</data>
      <data key="d6" />
    </node>
    <node id="Sir John Lawson's Daughter">
      <data key="d0">Sir John Lawson's Daughter</data>
      <data key="d1">person</data>
      <data key="d2">Deceased daughter of Sir John Lawson; burial of the daughter was attended by My Lady Batten and the diarist's wife.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-017</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788445866</data>
      <data key="d6" />
    </node>
    <node id="Claracilla">
      <data key="d0">Claracilla</data>
      <data key="d1">content</data>
      <data key="d2">Play performed at The Theatre and seen by the diarist for the first time.&lt;SEP&gt;Play that Samuel Pepys sees at the Theatre for the first time and judges to be well acted.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-017&lt;SEP&gt;doc-cf47789c7f6b678113755e09e7199138-chunk-018</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788445866</data>
      <data key="d6" />
    </node>
    <node id="Spanish Books">
      <data key="d0">Spanish Books</data>
      <data key="d1">content</data>
      <data key="d2">Books written in Spanish that the diarist looked for in Duck Lane, though none pleased him.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-017</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788445866</data>
      <data key="d6" />
    </node>
    <node id="Sir W. Batten's House">
      <data key="d0">Sir W. Batten's House</data>
      <data key="d1">location</data>
      <data key="d2">Sir W. Batten's residence, where the diarist, the Comptroller, and Mr. Mills sat late talking and disputing.&lt;SEP&gt;The residence of Sir W. Batten, where Samuel Pepys and others go after the office to eat a venison pasty.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-017&lt;SEP&gt;doc-cf47789c7f6b678113755e09e7199138-chunk-018</data>
