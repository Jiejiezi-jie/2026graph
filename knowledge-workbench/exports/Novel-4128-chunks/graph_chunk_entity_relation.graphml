    <node id="Vow To Drink No Wine">
      <data key="d0">Vow To Drink No Wine</data>
      <data key="d1">concept</data>
      <data key="d2">A resolution made by Samuel Pepys to abstain from wine for the week.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-050</data>
