    <node id="Algier">
      <data key="d0">Algier</data>
      <data key="d1">location</data>
      <data key="d2">North African city, written as Algier, where My Lord is to go to settle business and put the fleet in order.</data>
      <data key="d3">doc-cf47789c7f6b678113755e09e7199138-chunk-006</data>
      <data key="d4">unknown_source</data>
