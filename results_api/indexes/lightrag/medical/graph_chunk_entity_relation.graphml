      <data key="d0">Transgender Individuals</data>
      <data key="d1">person</data>
      <data key="d2">People whose gender identity differs from the sex assigned at birth; the text notes lack of evidence for screening guidance.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-098</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Those Assigned Male at Birth">
      <data key="d0">Those Assigned Male at Birth</data>
      <data key="d1">person</data>
      <data key="d2">Individuals whose sex assigned at birth is male; they do not undergo regular mammogram screening but should see a provider if symptoms occur.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-098</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
