      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Mediastinal Gray Zone Lymphoma">
      <data key="d0">Mediastinal Gray Zone Lymphoma</data>
      <data key="d1">concept</data>
      <data key="d2">A rare type of lymphoma with features overlapping between primary mediastinal B-cell lymphoma and Hodgkin lymphoma.&lt;SEP&gt;A rare type of lymphoma with features of both classical Hodgkin lymphoma and primary mediastinal B-cell lymphoma, often presenting with extranodal disease and advanced stage.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-145&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-146</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Primary Mediastinal B-Cell Lymphoma">
      <data key="d0">Primary Mediastinal B-Cell Lymphoma</data>
      <data key="d1">concept</data>
      <data key="d2">A type of non-Hodgkin lymphoma that arises in the mediastinum.&lt;SEP&gt;A type of non-Hodgkin lymphoma that arises in the mediastinum, sharing features with mediastinal gray zone lymphoma.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-145&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-146</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
