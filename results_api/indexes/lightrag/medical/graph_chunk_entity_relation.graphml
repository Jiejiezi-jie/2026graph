    </node>
    <node id="Lumpectomy">
      <data key="d0">Lumpectomy</data>
      <data key="d1">method</data>
      <data key="d2">Surgery to remove a tumor from the breast, often performed with sentinel lymph node biopsy.&lt;SEP&gt;Surgery to remove the tumor.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-103&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-104</data>
