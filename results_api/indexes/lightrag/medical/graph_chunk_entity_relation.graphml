      <data key="d0">External Genitalia</data>
      <data key="d1">location</data>
      <data key="d2">Organ near the cervix that can be affected by radiation.&lt;SEP&gt;Organs in the pelvic area that IMRT aims to spare from radiation to reduce side effects.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189</data>
