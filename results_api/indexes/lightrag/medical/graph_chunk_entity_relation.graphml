      <data key="d0">Ipilimumab</data>
      <data key="d1">artifact</data>
      <data key="d2">A checkpoint inhibitor drug (Yervoy) used in combination with nivolumab for dMMR/MSI-H cancers.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-125</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
