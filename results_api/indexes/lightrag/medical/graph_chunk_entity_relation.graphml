    <node id="NTRK Gene Fusion">
      <data key="d0">NTRK Gene Fusion</data>
      <data key="d1">concept</data>
      <data key="d2">A gene fusion involving NTRK, a biomarker in ovarian cancer.&lt;SEP&gt;A genetic alteration involving NTRK genes, tested as a biomarker.&lt;SEP&gt;A genetic alteration that may be present in cervical sarcoma.&lt;SEP&gt;A genetic alteration in NTRK genes that can be a target for therapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-043&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-044&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-143&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Somatic Mutation">
      <data key="d0">Somatic Mutation</data>
      <data key="d1">concept</data>
      <data key="d2">A mutation in the tumor itself, as opposed to inherited germline mutations.&lt;SEP&gt;A mutation that occurs by chance or environmental factors later in life, not inherited.&lt;SEP&gt;A mutation or change in DNA that occurs in non-germline cells, not inherited from parents.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-043&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-092&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-157</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Germline Mutation">
      <data key="d0">Germline Mutation</data>
      <data key="d1">concept</data>
      <data key="d2">An inherited mutation present in all cells, detected through genetic testing of blood.&lt;SEP&gt;An inherited genetic alteration present in every cell of the body, which can increase the risk of developing certain cancers.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-043&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-085</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="High-Grade Serous Carcinoma">
      <data key="d0">High-Grade Serous Carcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">A common type of ovarian cancer treated with surgery and chemotherapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-044</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Hysterectomy">
      <data key="d0">Hysterectomy</data>
      <data key="d1">method</data>
      <data key="d2">Surgery to remove the uterus; total hysterectomy also removes the cervix.&lt;SEP&gt;Surgery to remove the uterus, including the cervix, with types extrafascial, modified radical, and radical.&lt;SEP&gt;Surgical removal of the uterus, considered for cervical cancer treatment.&lt;SEP&gt;Surgery that removes the uterus, including the cervix; may also remove part of the vagina and cervical connective tissue, and possibly the ovaries.&lt;SEP&gt;Surgical removal of the uterus, often used for early-stage cervical cancer, but eliminates possibility of pregnancy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-044&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-140&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Bilateral Salpingo-Oophorectomy (BSO)">
      <data key="d0">Bilateral Salpingo-Oophorectomy (BSO)</data>
      <data key="d1">method</data>
      <data key="d2">Surgery to remove both ovaries and both fallopian tubes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-044</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Debulking Surgery">
      <data key="d0">Debulking Surgery</data>
      <data key="d1">method</data>
      <data key="d2">Also called cytoreductive surgery, aims to remove as much cancer as possible when it has spread.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-044</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Fertility-Sparing Surgery">
      <data key="d0">Fertility-Sparing Surgery</data>
      <data key="d1">method</data>
      <data key="d2">Surgery that removes one or both ovaries and fallopian tubes but leaves the uterus in place, preserving fertility.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-044</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Unilateral Salpingo-Oophorectomy (USO)">
      <data key="d0">Unilateral Salpingo-Oophorectomy (USO)</data>
      <data key="d1">method</data>
      <data key="d2">Surgery to remove one ovary and its fallopian tube, an option for cancer confined to one ovary.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-044</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="In Vitro Fertilization (IVF)">
      <data key="d0">In Vitro Fertilization (IVF)</data>
      <data key="d1">method</data>
      <data key="d2">Assisted reproductive technology where eggs are fertilized with sperm in a lab to create embryos.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-044</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Laparotomy">
      <data key="d0">Laparotomy</data>
      <data key="d1">method</data>
      <data key="d2">A surgical method involving a long vertical cut in the abdomen, commonly used for ovarian cancer surgery.&lt;SEP&gt;A surgical approach using a traditional large incision through the abdomen.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-044&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Laparoscopy">
      <data key="d0">Laparoscopy</data>
      <data key="d1">method</data>
      <data key="d2">A minimally invasive surgical method using small cuts, used in select cases of ovarian cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-044</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Surgical Staging">
      <data key="d0">Surgical Staging</data>
      <data key="d1">method</data>
      <data key="d2">A procedure to accurately stage ovarian cancer by taking samples from organs and tissues where cancer often spreads.&lt;SEP&gt;The process of determining cancer stage based on examination of removed tissue and lymph nodes.&lt;SEP&gt;A surgical procedure to remove and test lymph nodes to determine cancer stage.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-044&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-062&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Omentum">
      <data key="d0">Omentum</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The fatty layer of tissue covering organs in the abdomen, often removed during surgical staging.&lt;SEP&gt;Fatty layer of tissue covering organs in the abdomen, often removed during ovarian cancer surgery to check for cancer spread.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-044&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-045</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Microscopic Metastases">
      <data key="d0">Microscopic Metastases</data>
      <data key="d1">concept</data>
      <data key="d2">Cancer cells that have spread outside the ovaries or pelvis and can only be seen with a microscope.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-044&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-045</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
