    <node id="CDC.gov/tobacco">
      <data key="d0">CDC.gov/tobacco</data>
      <data key="d1">organization</data>
      <data key="d2">A website from the Centers for Disease Control and Prevention providing tobacco-related information and support.&lt;SEP&gt;A website from the CDC providing information and support for tobacco cessation.&lt;SEP&gt;A website providing tobacco-related health information.&lt;SEP&gt;A website from the Centers for Disease Control and Prevention offering tobacco-related resources.&lt;SEP&gt;A website from the Centers for Disease Control and Prevention with tobacco-related resources.&lt;SEP&gt;A website from the Centers for Disease Control and Prevention offering information and support for tobacco cessation.&lt;SEP&gt;A website by the Centers for Disease Control and Prevention providing information and support for tobacco cessation.</data>
