      <data key="d13" />
    </edge>
    <edge source="Cervical Cancer" target="High Number of Sexual Partners">
      <data key="d7">1.0</data>
      <data key="d8">Having a high number of sexual partners is a risk factor for cervical cancer.</data>
      <data key="d9">risk factor</data>
      <data key="d10">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-133</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1788683104</data>
      <data key="d13" />
    </edge>
    <edge source="Cervical Cancer" target="Sexually Transmitted Infection History">
      <data key="d7">1.0</data>
      <data key="d8">A history of sexually transmitted infections is a risk factor for cervical cancer.</data>
      <data key="d9">risk factor</data>
      <data key="d10">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-133</data>
      <data key="d11">unknown_source</data>
