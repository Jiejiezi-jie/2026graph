      <data key="d1">naturalobject</data>
      <data key="d2">Bones that form the ribcage, located behind the breast.&lt;SEP&gt;Bones located behind the breast.&lt;SEP&gt;Bones in the chest that are located behind the breast.&lt;SEP&gt;Bones in the chest located behind the breast.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-095&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-097&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-098&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-099</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Epithelial Cells">
      <data key="d0">Epithelial Cells</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Cells that line the surfaces of the body, from which most breast cancers arise.&lt;SEP&gt;Cells that line the surfaces of the body, including the lining of the ducts and lobules in the breast.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-095&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-096</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Ductal Carcinoma">
      <data key="d0">Ductal Carcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">A type of breast carcinoma that arises in the ducts.&lt;SEP&gt;A type of breast cancer that originates in the milk ducts.&lt;SEP&gt;A type of breast cancer that starts in the cells lining the milk ducts.&lt;SEP&gt;A type of breast cancer that starts in the cells lining the milk ducts; the most common type of breast cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-095&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-096&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-098&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-099</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Lobular Carcinoma">
      <data key="d0">Lobular Carcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">A type of breast carcinoma that arises in the lobules.&lt;SEP&gt;A type of breast cancer that originates in the lobules (milk-producing glands).&lt;SEP&gt;A type of breast cancer that starts in the lobules (milk glands) of the breast.&lt;SEP&gt;A type of breast cancer that starts in the lobules (milk glands); the second most common type.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-095&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-096&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-098&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-099</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Metastatic Breast Cancer (MBC)">
      <data key="d0">Metastatic Breast Cancer (MBC)</data>
      <data key="d1">concept</data>
      <data key="d2">Breast cancer that has spread outside the breast and lymph nodes to other parts of the body.&lt;SEP&gt;Breast cancer that has spread to distant parts of the body, commonly bone and lung.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-096&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Distant Lymph Nodes">
      <data key="d0">Distant Lymph Nodes</data>
      <data key="d1">location</data>
      <data key="d2">Lymph nodes located far from the primary tumor, which can be sites of distant metastasis.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-096</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Terminal Duct Lobular Units (TDLUs)">
      <data key="d0">Terminal Duct Lobular Units (TDLUs)</data>
      <data key="d1">location</data>
      <data key="d2">The functional units of the breast where breast cancer typically arises.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-096</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Testing for MBC">
      <data key="d0">Testing for MBC</data>
      <data key="d1">concept</data>
      <data key="d2">The process of conducting tests to determine the characteristics and extent of metastatic breast cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-096</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Fertility (all genders)">
      <data key="d0">Fertility (all genders)</data>
      <data key="d1">concept</data>
      <data key="d2">Consideration of fertility preservation options for all genders before cancer treatment.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-096</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Estrogen Receptor">
      <data key="d0">Estrogen Receptor</data>
      <data key="d1">concept</data>
      <data key="d2">A protein found on some cells that binds to estrogen, influencing cell growth; its presence on breast cancer cells affects treatment.&lt;SEP&gt;A receptor stimulated by estrogen that provides survival and proliferation signals to cancer cells.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-096&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-104</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Progesterone Receptor">
      <data key="d0">Progesterone Receptor</data>
      <data key="d1">concept</data>
      <data key="d2">A protein found on some cells that binds to progesterone, influencing cell growth; its presence on breast cancer cells affects treatment.&lt;SEP&gt;A receptor that binds progesterone and provides survival and proliferation signals.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-096&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-104</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="HER2 Receptor">
      <data key="d0">HER2 Receptor</data>
      <data key="d1">concept</data>
      <data key="d2">Human epidermal growth factor receptor 2, a protein that can promote cancer cell growth; its overexpression is targeted in treatment.&lt;SEP&gt;A protein that promotes cancer cell growth; overexpressed in some breast cancers.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-096&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-100</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Locoregional Disease">
      <data key="d0">Locoregional Disease</data>
      <data key="d1">concept</data>
      <data key="d2">Another term for local metastasis, referring to cancer spread to nearby tissues or lymph nodes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-096</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Secondary Tumor">
      <data key="d0">Secondary Tumor</data>
      <data key="d1">concept</data>
      <data key="d2">A tumor formed by cancer cells that have spread from the primary tumor to other parts of the body.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-096</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Ligaments">
      <data key="d0">Ligaments</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Fibrous tissue in the breast that provides support.&lt;SEP&gt;Tissues that help hold the breast in place.&lt;SEP&gt;Connective tissue that helps hold the breast in place.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-096&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-097&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-098</data>
