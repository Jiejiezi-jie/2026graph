    <node id="Molecular Tumor Testing">
      <data key="d0">Molecular Tumor Testing</data>
      <data key="d1">method</data>
      <data key="d2">Another term for biomarker testing, focusing on molecular components of tumor samples.&lt;SEP&gt;Another name for tumor testing, analyzing molecular components of tumor.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-085&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-092</data>
