    <node id="Heart">
      <data key="d0">Heart</data>
      <data key="d1">other</data>
      <data key="d2">An organ that may appear bright on PET scans normally.&lt;SEP&gt;An organ that can appear bright on PET scans and is the focus of heart tests.&lt;SEP&gt;Organ that normally appears bright on PET scans.&lt;SEP&gt;An organ that normally appears bright on PET scans and is the focus of heart tests.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-029&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-037&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-053&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-072</data>
