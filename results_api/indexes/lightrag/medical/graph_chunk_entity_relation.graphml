    <node id="Nutritionist">
      <data key="d0">Nutritionist</data>
      <data key="d1">person</data>
      <data key="d2">An expert who suggests appropriate foods and fluids for patients before treatment.&lt;SEP&gt;A professional who advises on food and nutrition, similar to a dietitian.&lt;SEP&gt;A professional who suggests appropriate foods and fluids for patients.&lt;SEP&gt;A specialist in diet and nutrition, part of the multidisciplinary care team.&lt;SEP&gt;A professional who suggests foods and fluids for patients.&lt;SEP&gt;A professional who offers guidance on suitable foods or diet for a patient's condition.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-028&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-043&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-051&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-120&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-128&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-176</data>
