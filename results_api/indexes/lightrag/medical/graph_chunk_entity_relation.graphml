    <node id="Serous Membrane">
      <data key="d0">Serous Membrane</data>
      <data key="d1">concept</data>
      <data key="d2">Another name for the serosa, the outer membrane covering the gallbladder and bile ducts.&lt;SEP&gt;Another name for the serosa, a thin membrane covering surfaces.&lt;SEP&gt;Another name for the serosa, the outer membrane of the stomach.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-023&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-024&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-162</data>
