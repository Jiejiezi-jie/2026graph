    <node id="Gadolinium">
      <data key="d0">Gadolinium</data>
      <data key="d1">artifact</data>
      <data key="d2">A contrast agent used in MRI scans to highlight areas in organs, blood vessels, or tissues, making them easier to see.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-114</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
