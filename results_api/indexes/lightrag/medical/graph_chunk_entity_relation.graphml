    <node id="mTOR">
      <data key="d0">mTOR</data>
      <data key="d1">concept</data>
      <data key="d2">A cell protein that helps cells grow and divide; overactivity can cause endocrine therapy to stop working.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-110&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-111</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="PARP">
      <data key="d0">PARP</data>
      <data key="d1">concept</data>
      <data key="d2">A cell protein that repairs cancer cells and allows them to survive; blocking it can cause cancer cells to die.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-111</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
