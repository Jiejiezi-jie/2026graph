      <data key="d0">Skin Thickening</data>
      <data key="d1">concept</data>
      <data key="d2">Skin has an orange-peel texture, a possible sign of inflammatory breast cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-099</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Edema">
      <data key="d0">Edema</data>
      <data key="d1">concept</data>
      <data key="d2">Swelling caused by excess fluid in body tissue, a possible sign of inflammatory breast cancer.&lt;SEP&gt;Swelling caused by fluid retention, a symptom of inflammatory breast cancer.&lt;SEP&gt;Swelling in brain tissue around a tumor, caused by glioma growth.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-099&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-100&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-165</data>
