      <data key="d0">Isthmus</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A thin piece of tissue that connects the two lobes of the thyroid gland.&lt;SEP&gt;The tissue connecting the two lobes of the thyroid gland.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-146&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147</data>
