    <node id="EGFR">
      <data key="d0">EGFR</data>
      <data key="d1">concept</data>
      <data key="d2">A protein found on the surface of cells that causes them to divide; blocking it may keep cancer cells from growing.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-010</data>
