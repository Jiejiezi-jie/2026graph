    <node id="Infant ALL">
      <data key="d0">Infant ALL</data>
      <data key="d1">concept</data>
      <data key="d2">ALL occurring in infants under 12 months of age, with treatment different from other age groups.&lt;SEP&gt;Acute lymphoblastic leukemia occurring in infants under 12 months of age.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-058&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-077</data>
