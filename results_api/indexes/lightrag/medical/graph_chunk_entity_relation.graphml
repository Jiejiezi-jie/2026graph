    <node id="Chapter 4: Treatment by Risk and Recurrence">
      <data key="d0">Chapter 4: Treatment by Risk and Recurrence</data>
      <data key="d1">content</data>
      <data key="d2">A chapter in the NCCN Guidelines for Patients that provides information on treatment based on risk and recurrence.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-001</data>
