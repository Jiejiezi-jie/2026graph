    </node>
    <node id="Stage 2 ovarian cancer">
      <data key="d0">Stage 2 ovarian cancer</data>
      <data key="d1">concept</data>
      <data key="d2">A specific stage of ovarian cancer where maintenance therapy with PARP inhibitors may be considered.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-048</data>
