    <node id="Central Nervous System (CNS)">
      <data key="d0">Central Nervous System (CNS)</data>
      <data key="d1">concept</data>
      <data key="d2">The part of the nervous system consisting of the brain and spinal cord; primary CNS lymphoma affects this system.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-113</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Cerebrospinal Fluid (CSF)">
      <data key="d0">Cerebrospinal Fluid (CSF)</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Fluid surrounding the brain and spinal cord; primary CNS lymphoma can occur in this fluid.&lt;SEP&gt;The fluid surrounding the brain and spinal cord, which may contain cancer cells.&lt;SEP&gt;The fluid surrounding the brain and spinal cord, where cancer cells may be found.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-113&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-117&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-118</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Eye">
      <data key="d0">Eye</data>
      <data key="d1">location</data>
      <data key="d2">Organ where primary CNS lymphoma can occur; symptoms may include changes in eyesight, and relapse can happen in the eye.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-113</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Stem Cell Transplant">
      <data key="d0">Stem Cell Transplant</data>
      <data key="d1">method</data>
      <data key="d2">A treatment option for primary CNS lymphoma that involves replacing damaged bone marrow with healthy stem cells.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-113</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Neurological Exam">
      <data key="d0">Neurological Exam</data>
      <data key="d1">method</data>
      <data key="d2">A test to assess nervous system function, important for diagnosing primary CNS lymphoma.&lt;SEP&gt;A set of simple tests to check alertness, balance, coordination, reflexes, hearing, and other senses, as well as an eye exam to assess nerve health.&lt;SEP&gt;Simple tests to check alertness, thinking, balance, coordination, reflexes, strength, hearing, and senses of touch and smell.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-113&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-114&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-166</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Eye Exam">
      <data key="d0">Eye Exam</data>
      <data key="d1">method</data>
      <data key="d2">Examination of the eyes to detect involvement of primary CNS lymphoma.&lt;SEP&gt;A thorough examination of the eyes using a slit lamp to check for lymphoma involvement.&lt;SEP&gt;An examination of the eyes, sometimes recommended before treatment for nasopharyngeal cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-113&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-115&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-128</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Impaired Immune System">
      <data key="d0">Impaired Immune System</data>
      <data key="d1">concept</data>
      <data key="d2">A weakened immune system, which is a risk factor for developing primary CNS lymphoma.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-113</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Double Vision">
      <data key="d0">Double Vision</data>
      <data key="d1">concept</data>
      <data key="d2">Seeing two images of a single object, a possible symptom of primary CNS lymphoma.</data>
