    <node id="G1">
      <data key="d0">G1</data>
      <data key="d1">concept</data>
      <data key="d2">A low-grade tumor with a low risk of recurrence.&lt;SEP&gt;Low grade, indicating low risk of recurrence.&lt;SEP&gt;Well differentiated (low grade) cancer cells that look like normal cells.&lt;SEP&gt;A cancer grade indicating well differentiated (low grade).</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-108&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-190</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="G2">
      <data key="d0">G2</data>
      <data key="d1">concept</data>
      <data key="d2">An intermediate-grade tumor.&lt;SEP&gt;Intermediate grade.&lt;SEP&gt;Moderately differentiated (high grade) cancer cells.&lt;SEP&gt;A cancer grade indicating moderately differentiated (intermediate grade).</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-108&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-190</data>
