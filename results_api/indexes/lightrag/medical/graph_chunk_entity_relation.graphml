    <node id="Folate Receptor Alpha (FRα) Expression">
      <data key="d0">Folate Receptor Alpha (FRα) Expression</data>
      <data key="d1">concept</data>
      <data key="d2">A biomarker involving folate receptor alpha, tested in ovarian cancer.&lt;SEP&gt;A biomarker indicating the presence of folate receptor alpha on tumor cells.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-043&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-044</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="RET Mutations">
      <data key="d0">RET Mutations</data>
      <data key="d1">concept</data>
      <data key="d2">Mutations in the RET gene, a biomarker in ovarian cancer.&lt;SEP&gt;Mutations in the RET gene, tested as biomarkers.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-043&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-044</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
