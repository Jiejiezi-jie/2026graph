      <data key="d0">Estrogen Receptor-Positive Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Cancer that has receptors for estrogen, which may be treated with hormone therapy and detected with FES PET-CT.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-103</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Mastectomy">
      <data key="d0">Mastectomy</data>
      <data key="d1">method</data>
      <data key="d2">Surgery to remove the breast, often performed with sentinel lymph node biopsy.&lt;SEP&gt;Surgery to remove the breast.&lt;SEP&gt;Surgical removal of the breast.&lt;SEP&gt;Surgery to remove all or part of the breast, often used to treat inflammatory breast cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-103&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-104&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-108&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-109</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
