    <node id="Regional Recurrence">
      <data key="d0">Regional Recurrence</data>
      <data key="d1">concept</data>
      <data key="d2">A cancer recurrence that occurs in nearby lymph nodes or tissues, treated similarly to local recurrence.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-144</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
