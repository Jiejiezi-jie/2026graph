    <node id="Bile Duct">
      <data key="d0">Bile Duct</data>
      <data key="d1">artifact</data>
      <data key="d2">A tube that carries bile, made up of several layers including epithelium, lamina propria, muscle, perimuscular fibrous tissue, and serosa.&lt;SEP&gt;A duct made up of several layers including inner and outer membranes, with muscle and connective tissue in between.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-023&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-024</data>
