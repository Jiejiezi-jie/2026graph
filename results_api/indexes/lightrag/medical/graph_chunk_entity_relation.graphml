    <node id="Genetic Test">
      <data key="d0">Genetic Test</data>
      <data key="d1">method</data>
      <data key="d2">A test used to identify genetic mutations associated with hereditary conditions.&lt;SEP&gt;A test to identify abnormal changes in genes, used to assess cancer risk and guide treatment.&lt;SEP&gt;A test to find abnormal changes (mutations) in genes, including germline testing.&lt;SEP&gt;A test used to find harmful changes in genes.&lt;SEP&gt;A test to identify mutations in genes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-002&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-084&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-085&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-092&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-093</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682801</data>
      <data key="d6" />
    </node>
    <node id="Imaging Test">
      <data key="d0">Imaging Test</data>
      <data key="d1">method</data>
      <data key="d2">Tests such as CT or MRI used to visualize adrenal tumors.&lt;SEP&gt;Tests such as MRI or CT scans used to see if cancer has spread beyond the prostate.&lt;SEP&gt;Tests that may be ordered if the doctor thinks cancer may have come back or spread.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-002&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-085&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-126</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682801</data>
      <data key="d6" />
    </node>
    <node id="Blood Test">
      <data key="d0">Blood Test</data>
      <data key="d1">method</data>
      <data key="d2">Tests that measure hormone levels or other markers in the blood.&lt;SEP&gt;Procedure to draw blood for laboratory analysis.&lt;SEP&gt;A test performed on a blood sample to assess health.&lt;SEP&gt;A diagnostic test where a small blood sample is taken and sent to a lab for testing to confirm CLL.&lt;SEP&gt;A diagnostic test that analyzes a blood sample to check for signs of disease and organ function.&lt;SEP&gt;A test that analyzes a blood sample to detect abnormalities indicating illness.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-002&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-082&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-122&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-169&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-175&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-178</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682801</data>
