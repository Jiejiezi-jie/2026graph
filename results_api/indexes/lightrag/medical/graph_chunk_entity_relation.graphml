    <node id="Headaches">
      <data key="d0">Headaches</data>
      <data key="d1">concept</data>
      <data key="d2">Pain in the head, a neurological symptom.&lt;SEP&gt;Pain in the head that can be a symptom of primary CNS lymphoma due to pressure.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-112&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-113</data>
