    <node id="Isolated Tumor Cells (ITCs)">
      <data key="d0">Isolated Tumor Cells (ITCs)</data>
      <data key="d1">concept</data>
      <data key="d2">Malignant cell clusters no larger than a certain size that may be present in lymph nodes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="Micrometastases">
      <data key="d0">Micrometastases</data>
      <data key="d1">concept</data>
      <data key="d2">Very small collections of cancer cells in lymph nodes, approximately 200 cells.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="Axillary Nodes">
      <data key="d0">Axillary Nodes</data>
      <data key="d1">concept</data>
      <data key="d2">Lymph nodes located under the arm, often the first site of lymph node spread in breast cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="Internal Mammary Nodes">
      <data key="d0">Internal Mammary Nodes</data>
      <data key="d1">concept</data>
      <data key="d2">Lymph nodes located near the breastbone.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="Infraclavicular Nodes">
      <data key="d0">Infraclavicular Nodes</data>
      <data key="d1">concept</data>
      <data key="d2">Lymph nodes located below the collarbone.&lt;SEP&gt;Lymph nodes located below the clavicle; involvement indicates cancer spread.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-108</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="Supraclavicular Nodes">
      <data key="d0">Supraclavicular Nodes</data>
      <data key="d1">concept</data>
      <data key="d2">Lymph nodes located above the collarbone.&lt;SEP&gt;Lymph nodes located above the clavicle; involvement indicates cancer spread.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-108</data>
