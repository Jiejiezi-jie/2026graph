    <node id="Risk Factor">
      <data key="d0">Risk Factor</data>
      <data key="d1">concept</data>
      <data key="d2">A condition that increases the chance of developing cancer, such as UV light exposure, fair skin, age, history of skin cancer, radiation therapy, and immune suppression.&lt;SEP&gt;Anything that increases the chance of developing lung cancer.&lt;SEP&gt;Anything that increases the chance of developing lung cancer, such as smoking or exposure to secondhand smoke.&lt;SEP&gt;Anything that increases the chance of getting cancer, such as age and family history.&lt;SEP&gt;Something that increases the chance of developing a disease.&lt;SEP&gt;Something that increases the chance of developing a disease; having an impaired immune system is a risk factor for primary CNS lymphoma.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-000&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-018&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-019&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-087&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-112&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-113</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682775</data>
      <data key="d6" />
    </node>
    <node id="Fair Skin">
      <data key="d0">Fair Skin</data>
      <data key="d1">concept</data>
      <data key="d2">A risk factor for basal cell skin cancer, as lighter skin has less melanin to filter UV rays.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682775</data>
      <data key="d6" />
    </node>
    <node id="Age">
      <data key="d0">Age</data>
      <data key="d1">concept</data>
      <data key="d2">A risk factor for basal cell skin cancer; risk increases with age due to cumulative sun exposure.&lt;SEP&gt;The biggest risk factor for prostate cancer. Prostate cancer is diagnosed most often in those aged 65 years and above.&lt;SEP&gt;A risk factor for prostate cancer; risk increases with age.&lt;SEP&gt;A factor that influences PSA level, with PSA tending to increase with age.&lt;SEP&gt;The biggest risk factor for prostate cancer; most diagnosed in those aged 65 and above.&lt;SEP&gt;A risk factor for bladder cancer; the risk increases with age.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-000&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-080&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-081&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-086&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-087&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-174</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682775</data>
      <data key="d6" />
    </node>
    <node id="History Of Skin Cancer">
      <data key="d0">History Of Skin Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">A risk factor for basal cell skin cancer; having a personal or family history increases risk.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682775</data>
