      <data key="d2">A lymphoma that starts elsewhere in the body and spreads to the brain or spinal cord.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-112</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
