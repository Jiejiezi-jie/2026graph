    </node>
    <node id="Stereotactic Biopsy">
      <data key="d0">Stereotactic Biopsy</data>
      <data key="d1">method</data>
      <data key="d2">The standard method for diagnosing primary CNS lymphoma, involving precise removal of a small tumor sample using a needle guided by imaging.&lt;SEP&gt;A procedure using a thin, hollow needle inserted into the brain to remove a sliver of tumor for diagnosis of primary CNS lymphoma.&lt;SEP&gt;A precise biopsy procedure used when a brain tumor is in a hard-to-reach or vital area, removing only enough tissue for diagnosis.&lt;SEP&gt;A procedure to remove a small sample of a brain tumor using a thin, hollow needle guided by a computerized navigation system connected to MRI or CT imaging, performed by a neurosurgeon in an operating room.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-114&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-115&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-166&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-167</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Neurosurgeon">
      <data key="d0">Neurosurgeon</data>
      <data key="d1">person</data>
      <data key="d2">A surgeon who performs stereotactic biopsies in an operating room.&lt;SEP&gt;A surgeon specializing in brain and nervous system surgery, part of the multidisciplinary care team.&lt;SEP&gt;A surgeon who performs biopsies and resections for brain tumors.&lt;SEP&gt;A surgeon who specializes in surgery of the nervous system, including performing stereotactic and open biopsies of brain tumors.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-114&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-120&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-166&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-167</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Stephanie E. Weiss">
      <data key="d0">Stephanie E. Weiss</data>
      <data key="d1">person</data>
      <data key="d2">A medical doctor (MD) and fellow of the American Society for Radiation Oncology (FASTRO) who provided an image showing MRI findings of primary CNS lymphoma.&lt;SEP&gt;A medical doctor and fellow of the American Society for Radiation Oncology (FASTRO) who provided an image related to lymphoma.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-114&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-115</data>
