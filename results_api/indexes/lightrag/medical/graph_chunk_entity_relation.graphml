      <data key="d0">Sexual Dysfunction</data>
      <data key="d1">concept</data>
      <data key="d2">A side effect of bladder cancer treatment that includes decreased desire or ability to have sex.&lt;SEP&gt;A condition affecting sexual function that may occur in cancer survivors.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-184&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-196</data>
