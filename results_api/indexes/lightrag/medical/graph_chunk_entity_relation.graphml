    <node id="Nurse">
      <data key="d0">Nurse</data>
      <data key="d1">person</data>
      <data key="d2">A healthcare professional who assists in patient care and may be present during exams.&lt;SEP&gt;A healthcare professional who may assist during a breast exam.&lt;SEP&gt;A healthcare professional who may be part of the care team.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-100&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-101&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-178</data>
