      <data key="d6" />
    </node>
    <node id="Muscle-Invasive Bladder Cancer">
      <data key="d0">Muscle-Invasive Bladder Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">A phase of bladder cancer where the tumor has grown through the inner urothelial layer and into the muscle layer of the bladder wall.&lt;SEP&gt;Bladder cancer that has grown into the muscle layer of the bladder; treatment can be complicated but may cure.&lt;SEP&gt;Bladder cancer that has grown into the muscle layer of the bladder wall, including stages 2, 3, and 4.&lt;SEP&gt;Bladder cancer that has spread into the muscle layer of the bladder wall.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-174&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-175&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-179&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-181</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Non-Muscle-Invasive Bladder Cancer">
      <data key="d0">Non-Muscle-Invasive Bladder Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">A phase of bladder cancer where the cancer has grown on or in the bladder's inner layer of urothelial cells but not into the muscle layer.&lt;SEP&gt;Bladder cancer that has not grown into the muscle layer of the bladder wall, including stages 0 and 1.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-174&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-179</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Metastatic Bladder Cancer">
      <data key="d0">Metastatic Bladder Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">A phase of bladder cancer where the cancer has spread outside the bladder to other areas of the body, such as lymph nodes, bones, lungs, liver, and the inner wall of the abdomen.&lt;SEP&gt;Bladder cancer that has spread to other parts of the body; typically not curable but treatable.&lt;SEP&gt;Bladder cancer that has spread to other parts of the body.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-174&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-175&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-183</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Chemical Exposure">
      <data key="d0">Chemical Exposure</data>
      <data key="d1">concept</data>
      <data key="d2">Exposure to certain chemicals used in dyes, rubber, leather, printing materials, textiles, and paint products, linked to increased bladder cancer risk.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-174</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Urinalysis">
      <data key="d0">Urinalysis</data>
      <data key="d1">method</data>
      <data key="d2">A test that studies urine to detect abnormalities, including blood.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-174</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Clinical Team">
      <data key="d0">Clinical Team</data>
      <data key="d1">organization</data>
      <data key="d2">A group of health care professionals who detect blood in urine and provide care for bladder cancer patients.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-174</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Bladder Wall">
      <data key="d0">Bladder Wall</data>
      <data key="d1">location</data>
      <data key="d2">The muscular wall of the bladder that can be invaded by cancer.&lt;SEP&gt;The wall of the bladder, composed of four main layers: inner lining (urothelial layer), connective tissue layer, muscle layer, and outer fatty layer.&lt;SEP&gt;The wall of the bladder, composed of layers including the lining, connective tissue, muscle, and fat.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-174&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-179&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-180</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Inner Lining">
      <data key="d0">Inner Lining</data>
      <data key="d1">location</data>
      <data key="d2">The urothelial layer of the bladder where non-muscle-invasive cancer grows.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-174</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
