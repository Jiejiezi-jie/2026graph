    <node id="Adolescents and Young Adults">
      <data key="d0">Adolescents and Young Adults</data>
      <data key="d1">concept</data>
      <data key="d2">Individuals aged 15 to 39 at initial cancer diagnosis, may be treated in pediatric or adult centers.&lt;SEP&gt;Age group for which fertility preservation information is specifically provided.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-057&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-101</data>
