    </node>
    <node id="Membrane">
      <data key="d0">Membrane</data>
      <data key="d1">concept</data>
      <data key="d2">A very thin layer that covers a surface, such as the inner and outer layers of the bile duct.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-023</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682976</data>
