    <node id="Tobacco Smoke">
      <data key="d0">Tobacco Smoke</data>
      <data key="d1">concept</data>
      <data key="d2">The biggest risk factor for lung cancer, containing more than 50 cancer-causing compounds.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-018</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682938</data>
