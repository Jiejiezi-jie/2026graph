      <data key="d1">concept</data>
      <data key="d2">A type of cancer that occurs in the throat, specifically the oropharynx.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-055</data>
      <data key="d4">unknown_source</data>
