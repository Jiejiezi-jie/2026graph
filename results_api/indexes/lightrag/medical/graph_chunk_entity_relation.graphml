    <node id="T Lymphocytes">
      <data key="d0">T Lymphocytes</data>
      <data key="d1">concept</data>
      <data key="d2">A type of lymphocyte that develops in the thymus and is one of the two main types of lymphocytes.&lt;SEP&gt;A type of lymphocyte that helps fight infections and cancer.&lt;SEP&gt;Also called T cells, they help fight infections, kill tumor cells, and control immune responses.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-023&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-024&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-076</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682976</data>
      <data key="d6" />
    </node>
