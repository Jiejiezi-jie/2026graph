    </node>
    <node id="Erythema">
      <data key="d0">Erythema</data>
      <data key="d1">concept</data>
      <data key="d2">Reddening of the skin, usually in patches, a possible sign of inflammatory breast cancer.&lt;SEP&gt;Redness of the skin, a symptom of inflammatory breast cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-099&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-100</data>
