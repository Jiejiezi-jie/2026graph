    </node>
    <node id="Counseling">
      <data key="d0">Counseling</data>
      <data key="d1">method</data>
      <data key="d2">A service provided by health care providers to help quit smoking.&lt;SEP&gt;Professional guidance and support to help patients deal with emotional distress.&lt;SEP&gt;Professional guidance to help individuals quit smoking or cope with genetic testing decisions.&lt;SEP&gt;Professional guidance provided or referred by a doctor to help patients stop smoking.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-020&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-051&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-178&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-196</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682948</data>
