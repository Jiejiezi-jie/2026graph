    <node id="Regional Lymph Nodes">
      <data key="d0">Regional Lymph Nodes</data>
      <data key="d1">concept</data>
      <data key="d2">Lymph nodes located near the tumor in the breast, including underarm, collarbone, and breastbone nodes.&lt;SEP&gt;Lymph nodes near the breast.&lt;SEP&gt;Lymph nodes located near the tumor.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-108&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-158</data>
