    <node id="Pediatric ALL">
      <data key="d0">Pediatric ALL</data>
      <data key="d1">concept</data>
      <data key="d2">ALL found in infants, children, and young adults, including those 18 and under and certain AYAs.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-057</data>
