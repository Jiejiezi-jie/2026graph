      <data key="d0">Lung Cancer Screening</data>
      <data key="d1">method</data>
      <data key="d2">Screening for people at high risk for lung cancer to find it at early stages.&lt;SEP&gt;A procedure to detect lung cancer at an early stage before symptoms appear, aimed at reducing mortality.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-018&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-019</data>
