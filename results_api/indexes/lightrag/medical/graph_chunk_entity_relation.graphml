    <node id="GX">
      <data key="d0">GX</data>
      <data key="d1">concept</data>
      <data key="d2">A grade category indicating that the tumor grade cannot be determined.&lt;SEP&gt;Grade cannot be determined.&lt;SEP&gt;A grade indicating that the cancer grade cannot be determined.&lt;SEP&gt;A cancer grade indicating that the grade cannot be assessed.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-108&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-190</data>
