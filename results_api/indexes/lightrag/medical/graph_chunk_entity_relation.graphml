    <node id="Mucus Membranes">
      <data key="d0">Mucus Membranes</data>
      <data key="d1">location</data>
      <data key="d2">Thin, flat cells lining the mouth, nose, and throat, where squamous cell carcinoma forms.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-049</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683056</data>
