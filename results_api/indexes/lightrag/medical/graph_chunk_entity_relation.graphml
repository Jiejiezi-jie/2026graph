    <node id="Stage I">
      <data key="d0">Stage I</data>
      <data key="d1">concept</data>
      <data key="d2">Early invasive breast cancer stage.&lt;SEP&gt;Early stage of cancer.&lt;SEP&gt;A stage of anal cancer where the cancer has not invaded nearby lymph nodes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-108&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-190</data>
