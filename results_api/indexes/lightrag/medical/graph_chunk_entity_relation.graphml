      <data key="d0">Uterine Cancer</data>
      <data key="d1">disease</data>
      <data key="d2">A cancer of the uterus; mentioned as related to certain germline mutations.&lt;SEP&gt;A type of cancer associated with MLH1, MSH2, MSH6, PMS2 mutations.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-085&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-092</data>
