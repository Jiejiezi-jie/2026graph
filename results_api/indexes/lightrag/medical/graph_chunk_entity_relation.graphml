      <data key="d5">1788683017</data>
      <data key="d6" />
    </node>
    <node id="Immune Checkpoint Inhibitor Therapy">
      <data key="d0">Immune Checkpoint Inhibitor Therapy</data>
      <data key="d1">method</data>
      <data key="d2">A treatment that activates the immune system to fight cancer, often targeting PD-1 or PD-L1.&lt;SEP&gt;A treatment that activates the immune system to fight cancer cells, possibly combined with chemotherapy.&lt;SEP&gt;A type of cancer treatment that uses drugs to help the immune system recognize and attack cancer cells, often targeting PD-1 or PD-L1.&lt;SEP&gt;A treatment that combines chemotherapy and checkpoint inhibitors to activate the immune system.&lt;SEP&gt;A treatment that activates the immune system to fight cancer, often used when PD-L1 is expressed.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-030&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-054&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-055&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-105&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-130</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683017</data>
      <data key="d6" />
    </node>
    <node id="Tumor Mutational Burden">
      <data key="d0">Tumor Mutational Burden</data>
      <data key="d1">concept</data>
      <data key="d2">The number of mutations per million base pairs of tumor DNA; high burden (TMB-H) is 10 or more mutations.&lt;SEP&gt;A measure of the number of mutations in tumor DNA; high burden (TMB-H) may indicate suitability for immunotherapy.&lt;SEP&gt;The number of mutations per million base pairs in tumor DNA; high burden is defined as 10 or more.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-030&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-105&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-130&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-157</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683017</data>
      <data key="d6" />
    </node>
    <node id="TMB-H">
      <data key="d0">TMB-H</data>
      <data key="d1">concept</data>
      <data key="d2">Tumor mutational burden-high, a condition with 10 or more mutations per million base pairs, often treated with immune checkpoint inhibitors.&lt;SEP&gt;Tumor mutational burden-high, used to predict response to immune checkpoint inhibitors.&lt;SEP&gt;Tumor Mutational Burden-High, a biomarker indicating a high number of mutations in the tumor, which may predict response to immunotherapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-030&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-105&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-145</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683017</data>
      <data key="d6" />
    </node>
    <node id="PD-1">
      <data key="d0">PD-1</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Programmed death protein 1, a target for immune checkpoint inhibitors.&lt;SEP&gt;Programmed death protein 1, an immune protein that can suppress anti-tumor immune response.&lt;SEP&gt;An 'off switch' on immune cells that tumors take advantage of; targeted by immunotherapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-030&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-105&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-111</data>
