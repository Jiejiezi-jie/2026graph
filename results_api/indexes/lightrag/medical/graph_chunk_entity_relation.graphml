      <data key="d0">Confirmatory Biopsy</data>
      <data key="d1">method</data>
      <data key="d2">A second biopsy performed within a year of the initial diagnosis to check for changes over time.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-084</data>
      <data key="d4">unknown_source</data>
