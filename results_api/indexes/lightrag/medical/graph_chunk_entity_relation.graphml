    <node id="Breast Cancer Screening">
      <data key="d0">Breast Cancer Screening</data>
      <data key="d1">method</data>
      <data key="d2">Regular examinations and tests to detect breast cancer early, including mammograms and clinical breast exams.&lt;SEP&gt;Aims to find cancer early and before symptoms start, saving lives by detecting cancer earlier when it can be treated more successfully.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-098&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-099</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
