      <data key="d13" />
    </edge>
    <edge source="Cervical Cancer" target="Cone Biopsy">
      <data key="d7">2.0</data>
      <data key="d8">Cone biopsy can be used to gather more information about the extent of cervical cancer and is a recommended treatment for some early cervical cancers.&lt;SEP&gt;Cone biopsy is used to diagnose and treat early-stage cervical cancer.</data>
      <data key="d9">diagnosis,treatment</data>
      <data key="d10">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-134&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1788683104</data>
      <data key="d13" />
    </edge>
    <edge source="Cervical Cancer" target="Magnetic Resonance Imaging (MRI)">
      <data key="d7">1.0</data>
      <data key="d8">MRI is used to show tissues of the uterus, cervix, and vagina and to determine if cancer has spread.</data>
      <data key="d9">diagnosis,imaging</data>
      <data key="d10">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-135</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1788683104</data>
      <data key="d13" />
    </edge>
    <edge source="Cervical Cancer" target="Small Cell Neuroendocrine Carcinoma of the Cervix (NECC)">
      <data key="d7">2.0</data>
      <data key="d8">NECC is a rare type of cervical cancer.&lt;SEP&gt;Small cell neuroendocrine carcinoma of the cervix is a rare type of cervical cancer.</data>
      <data key="d9">rare,type</data>
      <data key="d10">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-135&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1788683104</data>
      <data key="d13" />
    </edge>
    <edge source="Cervical Cancer" target="Fertility-Sparing Treatment">
      <data key="d7">4.0</data>
      <data key="d8">Fertility-sparing treatment is an option for some cervical cancer patients.&lt;SEP&gt;Fertility-sparing treatment is an option for early-stage cervical cancer to preserve fertility.&lt;SEP&gt;Fertility-sparing treatment is an option for some stage 1 cervical cancers.</data>
      <data key="d9">fertility,fertility preservation,option,treatment,treatment for</data>
      <data key="d10">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-135&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-140&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-143</data>
