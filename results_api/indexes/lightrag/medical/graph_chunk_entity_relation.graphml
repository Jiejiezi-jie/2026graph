    </node>
    <node id="Clip">
      <data key="d0">Clip</data>
      <data key="d1">artifact</data>
      <data key="d2">Small metal marker placed near a breast tumor during biopsy to mark the site for future treatment and imaging.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-103</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
