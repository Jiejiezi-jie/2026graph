    </edge>
    <edge source="Cervical Cancer" target="Stage 3B Cervical Cancer">
      <data key="d7">1.0</data>
      <data key="d8">Stage 3B cervical cancer has grown into the pelvic wall and/or caused kidney swelling or dysfunction.</data>
