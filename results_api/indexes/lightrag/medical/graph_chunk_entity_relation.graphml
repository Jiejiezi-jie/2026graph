    <node id="Anastomotic Leak">
      <data key="d0">Anastomotic Leak</data>
      <data key="d1">concept</data>
      <data key="d2">A potential complication where leaking occurs from the spot where the colon was reconnected.&lt;SEP&gt;A potential complication of colectomy where there is leaking from the spot where the colon was reconnected.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-124&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-125</data>
