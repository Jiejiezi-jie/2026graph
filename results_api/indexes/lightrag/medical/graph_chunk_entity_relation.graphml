    <node id="Paclitaxel">
      <data key="d0">Paclitaxel</data>
      <data key="d1">artifact</data>
      <data key="d2">A chemotherapy drug used in regimens for ovarian cancer.&lt;SEP&gt;A chemotherapy drug used in the treatment of ovarian cancer, often combined with carboplatin.&lt;SEP&gt;A taxane chemotherapy drug.&lt;SEP&gt;A chemotherapy drug used in combination with platinum agents for treating cancers.&lt;SEP&gt;A chemotherapy drug used in combination with carboplatin for anal cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-045&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-110&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-145&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-192</data>
