      <data key="d0">Bronchioles</data>
      <data key="d1">location</data>
      <data key="d2">Small tubes inside the lungs that branch from the bronchi.&lt;SEP&gt;Smaller airways in the lungs that branch from the bronchi.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-018&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-019</data>
