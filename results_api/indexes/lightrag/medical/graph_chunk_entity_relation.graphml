    <node id="Diet">
      <data key="d0">Diet</data>
      <data key="d1">concept</data>
      <data key="d2">Eating food high in fat, such as meat and dairy products, has been linked with an increased risk of prostate cancer.&lt;SEP&gt;Changes in diet, including high insoluble fiber and fiber supplements, can help with bowel problems.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-088&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-194</data>
