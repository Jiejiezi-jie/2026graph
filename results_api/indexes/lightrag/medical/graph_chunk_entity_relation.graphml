    </node>
    <node id="Biological Parents">
      <data key="d0">Biological Parents</data>
      <data key="d1">person</data>
      <data key="d2">The parents from whom a person inherits genetic material, relevant to distinguishing inherited mutations from tumor mutations.&lt;SEP&gt;The parents from whom an individual inherits genes.</data>
