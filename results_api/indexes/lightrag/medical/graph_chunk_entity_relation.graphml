    <node id="International Consensus Classification">
      <data key="d0">International Consensus Classification</data>
      <data key="d1">organization</data>
      <data key="d2">An organization that classifies follicular lymphoma grades, grouping grades 1 and 2 as classic FL.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-024</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682976</data>
