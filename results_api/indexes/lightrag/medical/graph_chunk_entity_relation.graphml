      <data key="d0">Tumor Size (T)</data>
      <data key="d1">concept</data>
      <data key="d2">A component of the TNM staging system that describes the size and extent of the primary tumor in breast cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107</data>
      <data key="d4">unknown_source</data>
