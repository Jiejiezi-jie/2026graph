    <node id="Levoxyl">
      <data key="d0">Levoxyl</data>
      <data key="d1">artifact</data>
      <data key="d2">A brand name for levothyroxine.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Synthroid">
      <data key="d0">Synthroid</data>
      <data key="d1">artifact</data>
      <data key="d2">A brand name for levothyroxine.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="TSH Suppression">
      <data key="d0">TSH Suppression</data>
      <data key="d1">concept</data>
      <data key="d2">Keeping TSH levels lower than normal to prevent thyroid cancer growth.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Thyroid-Stimulating Hormone (TSH)">
      <data key="d0">Thyroid-Stimulating Hormone (TSH)</data>
      <data key="d1">concept</data>
      <data key="d2">A hormone whose level is monitored and adjusted during thyroid hormone replacement therapy to prevent thyroid cancer recurrence.&lt;SEP&gt;A hormone produced by the pituitary gland that stimulates the thyroid to produce hormones.&lt;SEP&gt;A hormone produced by the pituitary gland that stimulates the thyroid; its level is measured in blood tests.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-148&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-150&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Radioactive Iodine (RAI) Therapy">
      <data key="d0">Radioactive Iodine (RAI) Therapy</data>
      <data key="d1">method</data>
      <data key="d2">A treatment using iodine-131 to selectively kill thyroid cancer cells, administered orally, often after thyroidectomy for high-risk cancers.&lt;SEP&gt;A treatment that uses radioactive iodine to destroy remaining thyroid tissue or cancer cells.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-148&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-150</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Iodine-131">
      <data key="d0">Iodine-131</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A radioactive isotope of iodine used in RAI therapy and whole-body scans.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-148</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Thyroidectomy">
      <data key="d0">Thyroidectomy</data>
      <data key="d1">method</data>
      <data key="d2">Surgical removal of the thyroid gland, often performed before RAI therapy for thyroid cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-148</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Thyrotropin Alfa (Thyrogen)">
      <data key="d0">Thyrotropin Alfa (Thyrogen)</data>
      <data key="d1">artifact</data>
      <data key="d2">A hormone injection used to increase TSH levels for RAI therapy when thyroid hormone replacement is stopped.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-148</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Whole-Body Radioiodine Scan">
      <data key="d0">Whole-Body Radioiodine Scan</data>
      <data key="d1">method</data>
      <data key="d2">An imaging procedure performed after RAI therapy to detect remaining thyroid tissue or hidden cancer areas.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-148</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Nuclear Medicine Specialist">
      <data key="d0">Nuclear Medicine Specialist</data>
      <data key="d1">person</data>
      <data key="d2">A medical specialist on the thyroid cancer treatment team who administers radioactive treatments.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-148</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Differentiated Thyroid Cancer">
      <data key="d0">Differentiated Thyroid Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">A type of thyroid cancer that takes up iodine and is often treated with RAI therapy after thyroidectomy.&lt;SEP&gt;A group of thyroid cancers that arise from follicular cells and retain some normal thyroid tissue features.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-148&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-150</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Thyrotoxicosis">
      <data key="d0">Thyrotoxicosis</data>
      <data key="d1">concept</data>
      <data key="d2">A condition of having too much thyroid hormone in the body, which can be caused by excessive levothyroxine intake.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-148</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
