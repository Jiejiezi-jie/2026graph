    <node id="Chapter 4: Treatment By Risk And Recurrence">
      <data key="d0">Chapter 4: Treatment By Risk And Recurrence</data>
      <data key="d1">content</data>
      <data key="d2">A chapter in the book that discusses treatment based on risk and recurrence.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682777</data>
      <data key="d6" />
    </node>
    <node id="Adrenal Glands">
      <data key="d0">Adrenal Glands</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Small, triangle-shaped glands located on top of each kidney, part of the endocrine system, producing hormones that regulate various body functions.&lt;SEP&gt;Small, yellow glands important to the body's endocrine system, located on top of the kidneys.&lt;SEP&gt;Endocrine glands located on top of the kidneys, which can be invaded by locally advanced kidney cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-001&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-002&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-064</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682777</data>
      <data key="d6" />
    </node>
    <node id="Adrenal Tumors">
      <data key="d0">Adrenal Tumors</data>
      <data key="d1">concept</data>
      <data key="d2">Tumors that can occur in one or both adrenal glands, mostly benign, but can be functional or malignant.&lt;SEP&gt;Tumors that occur in the adrenal glands, which are the focus of the guidelines and related medical information.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-001&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-003</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682777</data>
      <data key="d6" />
    </node>
    <node id="Adrenocortical Carcinoma">
      <data key="d0">Adrenocortical Carcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">A rare type of adrenal gland cancer that begins in the adrenal cortex, can be functioning or nonfunctioning.&lt;SEP&gt;A type of adrenal cancer that begins in the adrenal cortex, can be functioning or nonfunctioning, and may occur at any age but most likely in children under 5 and adults in their 40s and 50s.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-001&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-002</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682777</data>
      <data key="d6" />
    </node>
    <node id="Neuroblastoma">
      <data key="d0">Neuroblastoma</data>
      <data key="d1">concept</data>
      <data key="d2">A rare cancerous adrenal tumor affecting children ages 5 and under, most often found in infants.&lt;SEP&gt;A rare cancerous adrenal tumor affecting children ages 5 and under, most often infants, and can spread to other parts of the body including bones.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-001&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-002</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682777</data>
      <data key="d6" />
    </node>
    <node id="Cushing Syndrome">
      <data key="d0">Cushing Syndrome</data>
      <data key="d1">concept</data>
      <data key="d2">A condition caused by an adenoma producing too much cortisol.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682777</data>
      <data key="d6" />
    </node>
    <node id="Aldosteronoma">
      <data key="d0">Aldosteronoma</data>
      <data key="d1">concept</data>
      <data key="d2">An adenoma that produces too much aldosterone.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682777</data>
      <data key="d6" />
    </node>
    <node id="Adrenal Cortex">
      <data key="d0">Adrenal Cortex</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The outer part of the adrenal gland that makes hormones such as cortisol, aldosterone, and DHEA.&lt;SEP&gt;The outer part of the adrenal gland where adrenocortical carcinoma begins.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-001&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-002</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682777</data>
      <data key="d6" />
    </node>
    <node id="Adrenal Medulla">
      <data key="d0">Adrenal Medulla</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The inner part of the adrenal gland that makes hormones such as epinephrine, norepinephrine, and dopamine.&lt;SEP&gt;The inner part of the adrenal gland where pheochromocytoma begins.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-001&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-002</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682777</data>
      <data key="d6" />
    </node>
    <node id="Endocrine System">
      <data key="d0">Endocrine System</data>
      <data key="d1">concept</data>
      <data key="d2">The system of tissues and organs that produce hormones.&lt;SEP&gt;Made up of tissues and organs that produce hormones.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-001&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-002</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682777</data>
      <data key="d6" />
    </node>
    <node id="Hormones">
      <data key="d0">Hormones</data>
      <data key="d1">concept</data>
      <data key="d2">Chemical substances made in one part of the body and carried through the bloodstream to control how organs or cells work.&lt;SEP&gt;Chemical messengers produced by stomach glands that regulate digestion.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-001&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-002&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-162</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682777</data>
      <data key="d6" />
    </node>
    <node id="Lymph Nodes">
      <data key="d0">Lymph Nodes</data>
      <data key="d1">location</data>
      <data key="d2">Lymph nodes are small, bean-shaped structures that are integral components of the immune and lymphatic systems, distributed throughout the body, including high concentrations in the neck, groin, armpits, and along the stomach's curvatures. They function as filters for lymph fluid, removing foreign particles, germs, and harmful cells, including cancer cells, while also producing immune cells like lymphocytes. With over 300 nodes present in the head and neck region alone, they serve as critical sites for disease surveillance and immune response.

These glands are common and clinically significant sites for cancer metastasis across numerous malignancies. Basal cell skin cancer, regional cutaneous squamous cell carcinoma (CSCC), rectal cancer, kidney cancer, prostate cancer, bladder cancer, anal cancer, stomach cancer, and thyroid cancer can all spread to nearby lymph nodes. Additionally, they are involved in systemic diseases like leukemia, where cancer can spread outside the bloodstream, and in follicular lymphoma and B-cell lymphoblastic lymphoma, where tumors or malignant cell growths form within the nodes. In conditions like small lymphocytic lymphoma (SLL), cancer cells may accumulate in these organs.

Lymph nodes are routinely evaluated in cancer staging and treatment planning. Enlargement of these glands in the neck, underarm, or groin is often checked during physical exams, and they may be assessed via imaging techniques such as CT scans or MRIs. In surgical procedures like colectomy, radical cystectomy, or ovarian cancer surgery, nearby lymph nodes are often removed and tested for the presence of cancer cells. They are also targets for radiation therapy, as seen in anal cancer treatment, where beams are directed at the pelvis and groin. While they are frequent sites of metastasis for many cancers, hepatocellular carcinoma (HCC) does not commonly spread to these nodes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-000&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-006&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-012&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-013&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-014&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-017&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-021&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-023&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-024&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-025&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-027&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-028&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-029&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-031&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-032&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-037&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-041&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-044&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-045&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-049&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-056&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-057&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-058&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-060&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-062&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-064&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-065&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-066&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-067&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-068&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-076&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-078&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-081&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-083&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-088&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-089&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-090&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-093&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-095&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-096&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-099&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-103&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-124&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-126&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-131&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-157&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-160&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-162&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-163&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-169&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-172&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-174&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-177&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-178&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-180&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-185&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-187&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-188&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189</data>
