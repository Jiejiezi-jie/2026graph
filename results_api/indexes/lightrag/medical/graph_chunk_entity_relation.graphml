    <node id="American Joint Committee On Cancer">
      <data key="d0">American Joint Committee On Cancer</data>
      <data key="d1">organization</data>
      <data key="d2">An organization that created a staging system to determine how much cancer is in the body, where it is located, and what subtype it is.</data>
