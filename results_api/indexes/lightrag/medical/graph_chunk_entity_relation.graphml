    <node id="Imiquimod">
      <data key="d0">Imiquimod</data>
      <data key="d1">artifact</data>
      <data key="d2">A prescription cream used to treat early CSCC and actinic keratoses.&lt;SEP&gt;An immune response modifier cream that helps fight abnormal skin growths by activating the immune system.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-007&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-008</data>
