    <node id="Health Care Providers">
      <data key="d0">Health Care Providers</data>
      <data key="d1">person</data>
      <data key="d2">Professionals who can provide counseling and medicines to help quit smoking.&lt;SEP&gt;Professionals who provide medical care and with whom Black males may discuss earlier and more frequent screening tests.&lt;SEP&gt;Professionals who provide health care services, including those involved in breast health and cancer screening.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-020&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-088&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-099</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682948</data>
