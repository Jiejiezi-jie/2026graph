    <node id="Genetic Mutation">
      <data key="d0">Genetic Mutation</data>
      <data key="d1">concept</data>
      <data key="d2">An abnormal change in a gene that can lead to disease, including cancer.&lt;SEP&gt;A change in DNA that can increase cancer risk.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-084&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-178</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Inherited Mutation">
      <data key="d0">Inherited Mutation</data>
      <data key="d1">concept</data>
      <data key="d2">A mutation present in every cell of the body, passed down from parents, also called germline mutation.&lt;SEP&gt;A genetic change passed from parent to child that increases cancer risk.&lt;SEP&gt;A genetic change passed from parents to children that increases cancer risk.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-084&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-122&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-178</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Acquired Mutation">
      <data key="d0">Acquired Mutation</data>
      <data key="d1">concept</data>
      <data key="d2">A mutation that occurs spontaneously in some cells later in life, also called somatic mutation.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-084</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="PSA Level">
      <data key="d0">PSA Level</data>
      <data key="d1">data</data>
      <data key="d2">A blood test measurement that can be elevated in prostate cancer, prompting further investigation.&lt;SEP&gt;Prostate-specific antigen level in the blood; a high level may indicate prostate cancer and is used in risk assessment.&lt;SEP&gt;A measure of prostate-specific antigen in the bloodstream, used as a risk indicator for prostate cancer. High levels can vary by age, race, and other factors.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-084&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-085&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-086</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Core Sample">
      <data key="d0">Core Sample</data>
      <data key="d1">artifact</data>
      <data key="d2">A small sample of prostate tissue removed during biopsy, typically 1-2 mm wide and 12-20 mm long.&lt;SEP&gt;A small cylindrical piece of prostate tissue removed during biopsy, typically 1-2 mm wide and 12-20 mm long.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-084&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-091</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Perineum">
      <data key="d0">Perineum</data>
      <data key="d1">location</data>
      <data key="d2">The skin area between the anus and scrotum, through which a biopsy needle may be inserted.&lt;SEP&gt;The area between the anus and scrotum, a possible insertion point for biopsy needles.&lt;SEP&gt;The area between the anus and genitals, which is damaged by radiation and may require reconstruction after APR.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-084&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-091&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-192</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
