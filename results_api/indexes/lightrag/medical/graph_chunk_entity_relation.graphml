    <node id="Inflammatory Breast Cancer">
      <data key="d0">Inflammatory Breast Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">A rare, aggressive cancer where cancer cells block lymph vessels in the skin of the breast, causing redness, swelling, and warmth.&lt;SEP&gt;A type of breast cancer that can be difficult to diagnose, often requiring referral to a breast specialist.&lt;SEP&gt;A type of breast cancer that causes inflamed skin on the breast.&lt;SEP&gt;A type of breast cancer that presents as inflammatory carcinoma, classified as T4d.&lt;SEP&gt;A type of breast cancer that is treatable and often treated with systemic therapy, surgery, and radiation therapy.&lt;SEP&gt;A type of breast cancer that may be treated with more than one chemotherapy drug.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-099&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-103&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-104&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-109&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-110</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Invasive Ductal Carcinoma">
      <data key="d0">Invasive Ductal Carcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">A type of breast cancer that starts in the cells lining the milk ducts and spreads into surrounding tissue.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-099&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-106</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Peau D'Orange">
      <data key="d0">Peau D'Orange</data>
      <data key="d1">concept</data>
      <data key="d2">A pitted or dimpled appearance of the skin, a possible sign of inflammatory breast cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-099</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
