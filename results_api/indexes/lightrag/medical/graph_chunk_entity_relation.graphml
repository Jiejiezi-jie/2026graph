    <node id="Fine Needle Biopsy (FNB)">
      <data key="d0">Fine Needle Biopsy (FNB)</data>
      <data key="d1">method</data>
      <data key="d2">A biopsy technique using a fine needle to remove a sample of tumor or lymph node.</data>
