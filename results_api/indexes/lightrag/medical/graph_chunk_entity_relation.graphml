      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="PSA Density">
      <data key="d0">PSA Density</data>
      <data key="d1">data</data>
      <data key="d2">A calculated value of PSA level divided by prostate size, used to adjust for prostate size in assessing cancer risk.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-086</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Gleason Pattern">
      <data key="d0">Gleason Pattern</data>
      <data key="d1">concept</data>
      <data key="d2">A numerical pattern assigned to cancer cells in biopsy samples, ranging from 1 to 5, with higher numbers indicating more abnormal cells.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-086</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Gleason Score">
      <data key="d0">Gleason Score</data>
      <data key="d1">data</data>
      <data key="d2">A score from 6 to 10 combining the two most common Gleason patterns in a biopsy, indicating how aggressive prostate cancer is.&lt;SEP&gt;A grading system for prostate cancer based on the appearance of cancer cells under a microscope, with scores from 6 to 10.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-086&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-087</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Transrectal Ultrasound">
