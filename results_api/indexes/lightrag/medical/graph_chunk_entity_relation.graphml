    <node id="American Joint Committee on Cancer">
      <data key="d0">American Joint Committee on Cancer</data>
      <data key="d1">organization</data>
      <data key="d2">The American Joint Committee on Cancer (AJCC) created a staging system to determine how much cancer is in the body, where it is located, and what subtype it is.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-131</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
