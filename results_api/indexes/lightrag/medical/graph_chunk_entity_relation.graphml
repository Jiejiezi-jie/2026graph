    <node id="Genetic Disease">
      <data key="d0">Genetic Disease</data>
      <data key="d1">concept</data>
      <data key="d2">A disease caused by abnormalities in genes, which genetic counselors are trained to address.&lt;SEP&gt;A condition caused by genetic mutations, which genetic counselors specialize in.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-085&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-178</data>
