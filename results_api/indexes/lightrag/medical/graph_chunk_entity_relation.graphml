    <node id="Platelet">
      <data key="d0">Platelet</data>
      <data key="d1">concept</data>
      <data key="d2">A type of blood cell that develops from blood stem cells. It helps with blood clotting.&lt;SEP&gt;Cell fragments that help clotting; counts may be low in CLL.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-058&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-171</data>
