    <node id="HIV Infection">
      <data key="d0">HIV Infection</data>
      <data key="d1">concept</data>
      <data key="d2">A risk factor for anal cancer, referring to infection with the human immunodeficiency virus.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
