      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Squamo-Columnar Junction">
      <data key="d0">Squamo-Columnar Junction</data>
      <data key="d1">location</data>
      <data key="d2">The area where the endocervix and ectocervix meet, also called the transformation zone, where most cervical cancers start.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-132</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Cervical Stroma">
      <data key="d0">Cervical Stroma</data>
      <data key="d1">location</data>
      <data key="d2">The thick layer of muscular tissue beneath the cervical lining.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-132</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
