    <node id="Iodine">
      <data key="d0">Iodine</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A chemical element that can cause allergic reactions in some patients when used in contrast material.&lt;SEP&gt;A mineral from diet used by the thyroid to produce hormones.&lt;SEP&gt;A chemical element that thyroid cancer cells take up; a low-iodine diet is required before RAI therapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-102&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-146&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-148</data>
