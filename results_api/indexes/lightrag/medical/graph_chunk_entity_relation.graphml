      <data key="d1">concept</data>
      <data key="d2">A health condition that can cause bone damage and may be detected on a bone scan.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-155</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Kidney">
      <data key="d0">Kidney</data>
      <data key="d1">naturalobject</data>
      <data key="d2">An organ that filters waste from the blood; its function is assessed by blood tests and affects contrast use.&lt;SEP&gt;An organ that filters blood to produce urine, which may be investigated if cancer is not found in the urethra or bladder.&lt;SEP&gt;An organ that filters blood and produces urine, part of the urinary tract.&lt;SEP&gt;An organ that can be damaged by platinum-based chemotherapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-155&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-176&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-178&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-183</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="PET scan">
      <data key="d0">PET scan</data>
      <data key="d1">method</data>
      <data key="d2">A positron emission tomography scan that uses a radioactive drug called a tracer to detect cancer cells by measuring sugar uptake.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-156</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Core needle biopsy">
      <data key="d0">Core needle biopsy</data>
      <data key="d1">method</data>
      <data key="d2">A biopsy technique using a hollow needle to remove tissue samples, often performed under light sedation.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-156</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Surgical (open) biopsy">
      <data key="d0">Surgical (open) biopsy</data>
      <data key="d1">method</data>
      <data key="d2">A biopsy technique that removes a tumor sample through a small incision, requiring an operating room.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-156</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Bone marrow aspirate">
      <data key="d0">Bone marrow aspirate</data>
      <data key="d1">method</data>
      <data key="d2">A procedure that draws liquid bone marrow into a syringe using a hollow needle.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-156</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Genetic cancer risk testing">
      <data key="d0">Genetic cancer risk testing</data>
      <data key="d1">method</data>
      <data key="d2">Testing using blood or saliva to look for inherited germline mutations that increase cancer risk.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-156</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
