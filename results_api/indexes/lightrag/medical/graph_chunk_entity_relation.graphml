    </node>
    <node id="Follicular Lymphoma">
      <data key="d0">Follicular Lymphoma</data>
      <data key="d1">disease</data>
      <data key="d2">A slow-growing (indolent) non-Hodgkin lymphoma that develops from abnormal B lymphocytes forming follicles in lymph nodes.&lt;SEP&gt;A slow-growing (indolent) non-Hodgkin lymphoma that forms tumors in lymph nodes and other parts of the body, characterized by abnormal B lymphocytes forming follicles in germinal centers.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-024&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-025</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682976</data>
      <data key="d6" />
    </node>
    <node id="B Lymphocytes">
      <data key="d0">B Lymphocytes</data>
      <data key="d1">cell</data>
      <data key="d2">A type of lymphocyte that makes antibodies.&lt;SEP&gt;A type of white blood cell that, when abnormal, forms clusters (follicles) in germinal centers of lymph nodes in follicular lymphoma.&lt;SEP&gt;Also called B cells, they make antibodies.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-024&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-025&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-076</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682976</data>
      <data key="d6" />
    </node>
    <node id="Natural Killer Cells">
      <data key="d0">Natural Killer Cells</data>
      <data key="d1">concept</data>
      <data key="d2">A type of lymphocyte that can kill tumor cells or virus-infected cells.&lt;SEP&gt;Lymphocytes that can kill tumor cells or virus-infected cells.&lt;SEP&gt;A type of lymphocyte that has granules with enzymes that can kill tumor cells or cells infected with a virus.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-024&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-057&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-065&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-172</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682976</data>
      <data key="d6" />
    </node>
    <node id="Germinal Centers">
      <data key="d0">Germinal Centers</data>
      <data key="d1">anatomicalstructure</data>
      <data key="d2">Temporary structures in lymph nodes that form in response to infection or inflammation, where B cells can grow out of control leading to follicular lymphoma.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-024</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682976</data>
      <data key="d6" />
    </node>
    <node id="Centrocytes">
      <data key="d0">Centrocytes</data>
      <data key="d1">cell</data>
      <data key="d2">Smaller B cells in the light zone of germinal centers that divide less.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-024</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682976</data>
      <data key="d6" />
    </node>
    <node id="Centroblasts">
      <data key="d0">Centroblasts</data>
      <data key="d1">cell</data>
      <data key="d2">Larger B cells in the dark zone of germinal centers that divide more.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-024</data>
      <data key="d4">unknown_source</data>
