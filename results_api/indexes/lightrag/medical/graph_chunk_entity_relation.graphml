      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-116</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Vitamins">
      <data key="d0">Vitamins</data>
      <data key="d1">artifact</data>
      <data key="d2">Organic compounds essential for normal growth and nutrition.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-116</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Herbs">
      <data key="d0">Herbs</data>
      <data key="d1">artifact</data>
      <data key="d2">Plants used for flavoring, medicine, or fragrance.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-116</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Chemotherapy drugs">
      <data key="d0">Chemotherapy drugs</data>
      <data key="d1">artifact</data>
      <data key="d2">Drugs used in chemotherapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-116</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Immunotherapy drug">
      <data key="d0">Immunotherapy drug</data>
      <data key="d1">artifact</data>
      <data key="d2">A drug used in immunotherapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-116</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Primary brain tumors">
      <data key="d0">Primary brain tumors</data>
      <data key="d1">concept</data>
      <data key="d2">Tumors that originate in the brain; patients with these tumors often experience depression, anxiety, and distress.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-116</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Immunotherapy Drug">
      <data key="d0">Immunotherapy Drug</data>
      <data key="d1">concept</data>
      <data key="d2">A type of drug used in cancer treatment that helps the immune system fight cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-117</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Stem Cell Rescue">
      <data key="d0">Stem Cell Rescue</data>
      <data key="d1">method</data>
      <data key="d2">A procedure that involves high-dose chemotherapy followed by infusion of stem cells to restore bone marrow.&lt;SEP&gt;A procedure also called hematopoietic stem cell transplant, used to regrow bone marrow after high-dose chemotherapy. It involves removing, freezing, and re-infusing the patient's own stem cells.&lt;SEP&gt;A procedure where stem cells are harvested from the patient, high-dose chemotherapy is given, and then the stem cells are returned to grow new healthy blood-forming cells.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-117&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-119&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-120</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Intraocular Chemotherapy">
      <data key="d0">Intraocular Chemotherapy</data>
      <data key="d1">method</data>
      <data key="d2">A type of chemotherapy where drugs are infused into the eye or vein to treat primary CNS lymphoma occurring in the eye.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-118</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Whole-Brain Radiation Therapy (WBRT)">
      <data key="d0">Whole-Brain Radiation Therapy (WBRT)</data>
      <data key="d1">method</data>
      <data key="d2">A radiation therapy technique that treats the entire brain, used for primary CNS lymphoma.&lt;SEP&gt;The most commonly used radiation technique for primary CNS lymphoma, targeting the whole brain.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-118&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-120</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="NCCN Guidelines for Patients: Nausea and Vomiting">
      <data key="d0">NCCN Guidelines for Patients: Nausea and Vomiting</data>
      <data key="d1">content</data>
      <data key="d2">A patient guideline document that provides information on managing nausea and vomiting side effects.&lt;SEP&gt;A patient guideline from NCCN that provides information on managing nausea and vomiting from cancer therapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-118&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-184</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Eye Surgeon">
      <data key="d0">Eye Surgeon</data>
      <data key="d1">person</data>
      <data key="d2">A medical professional who performs operations on the eye, such as cataract surgery.&lt;SEP&gt;A medical professional who performs routine operations to treat cataracts caused by radiation therapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-118&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-119</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Nervous System">
      <data key="d0">Nervous System</data>
      <data key="d1">other</data>
      <data key="d2">System that can be damaged by radiation therapy, especially in older adults, leading to cognitive issues.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-118</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Cataracts">
      <data key="d0">Cataracts</data>
      <data key="d1">concept</data>
      <data key="d2">A side effect of intraocular chemotherapy, treatable with surgery.&lt;SEP&gt;A condition of the eye that can be caused by radiation therapy, treatable with a routine operation by an eye surgeon.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-118&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-119</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Rituximab">
      <data key="d0">Rituximab</data>
      <data key="d1">artifact</data>
      <data key="d2">A monoclonal antibody drug used in immunotherapy for primary CNS lymphoma. It targets CD20 proteins on cancer cells and is given via IV infusion.&lt;SEP&gt;The main immunotherapy drug for primary CNS lymphoma.&lt;SEP&gt;An immunotherapy drug used in combination with chemotherapy for primary CNS lymphoma.&lt;SEP&gt;A monoclonal antibody drug that may be added to chemotherapy for mediastinal gray zone lymphoma if tumor cells are CD20-positive, forming chemoimmunotherapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-119&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-120&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-121&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-146</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Hematopoietic Stem Cell">
      <data key="d0">Hematopoietic Stem Cell</data>
      <data key="d1">concept</data>
      <data key="d2">A basic cell that can develop into blood cells, made in the bone marrow. They are used in stem cell rescue to restore blood cell production.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-119</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="CD20 Protein">
      <data key="d0">CD20 Protein</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A protein on the surface of cancerous and some healthy blood cells. Rituximab attaches to it to help the immune system destroy cancer cells.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-119</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Whole Brain Radiation Therapy">
      <data key="d0">Whole Brain Radiation Therapy</data>
      <data key="d1">method</data>
      <data key="d2">A type of radiation therapy that treats the entire brain, sometimes expanded to include the eyes for primary CNS lymphoma.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-119</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Vision Problems">
      <data key="d0">Vision Problems</data>
      <data key="d1">concept</data>
      <data key="d2">Possible side effects of radiation therapy to the eyes, which may be temporary or permanent.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-119</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Monoclonal Antibody">
      <data key="d0">Monoclonal Antibody</data>
      <data key="d1">concept</data>
      <data key="d2">A type of immunotherapy that hunts for specific proteins on cancer cells. Rituximab is an example.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-119</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Blood Cells">
      <data key="d0">Blood Cells</data>
      <data key="d1">concept</data>
      <data key="d2">Cells in the blood, including red and white blood cells and platelets, produced by hematopoietic stem cells in the bone marrow.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-119</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Stem Cell Removal">
      <data key="d0">Stem Cell Removal</data>
      <data key="d1">method</data>
      <data key="d2">The first step of stem cell rescue, where healthy stem cells are collected from the patient's blood or bone marrow.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-119</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="High-Dose Chemotherapy">
      <data key="d0">High-Dose Chemotherapy</data>
      <data key="d1">method</data>
      <data key="d2">Intensive chemotherapy used in stem cell rescue to kill lymphoma cells and all stem cells in the bone marrow.&lt;SEP&gt;A treatment using high doses of chemotherapy drugs to destroy cancer cells, but also kills stem cells in the bone marrow.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-119&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-120</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Stem Cell Replacement">
      <data key="d0">Stem Cell Replacement</data>
      <data key="d1">method</data>
      <data key="d2">The final step of stem cell rescue, where thawed healthy stem cells are returned to the patient to regrow bone marrow.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-119</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Relapse">
      <data key="d0">Relapse</data>
      <data key="d1">concept</data>
      <data key="d2">The return of lymphoma after earlier treatment, which may be an indication for stem cell rescue.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-119</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Multidisciplinary Care">
      <data key="d0">Multidisciplinary Care</data>
      <data key="d1">concept</data>
      <data key="d2">A team approach where various doctors, specialists, and allied health providers work and communicate together to care for a patient.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-120</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Neuro-Oncologist">
      <data key="d0">Neuro-Oncologist</data>
      <data key="d1">person</data>
      <data key="d2">A doctor specializing in nervous system cancers, part of the multidisciplinary care team.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-120</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Nurses">
      <data key="d0">Nurses</data>
      <data key="d1">person</data>
      <data key="d2">Healthcare professionals who provide care and support, part of the multidisciplinary care team.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-120</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Primary Care Doctor">
      <data key="d0">Primary Care Doctor</data>
      <data key="d1">person</data>
      <data key="d2">A general practitioner who provides overall healthcare, part of the multidisciplinary care team.&lt;SEP&gt;A doctor who handles medical care not related to cancer and helps patients express thoughts about treatments to the cancer care team.&lt;SEP&gt;A general practitioner who plays an important role in follow-up care after cancer treatment.&lt;SEP&gt;A doctor who provides general health care and cancer screening recommendations.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-120&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-176&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-194&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-195</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Nurse Practitioners">
      <data key="d0">Nurse Practitioners</data>
      <data key="d1">person</data>
      <data key="d2">Advanced practice nurses who provide care, part of the multidisciplinary care team.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-120</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Physician Assistants">
      <data key="d0">Physician Assistants</data>
      <data key="d1">person</data>
      <data key="d2">Healthcare professionals who practice medicine under supervision, part of the multidisciplinary care team.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-120</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Palliative Care Specialist">
      <data key="d0">Palliative Care Specialist</data>
      <data key="d1">person</data>
      <data key="d2">A specialist in supportive care to relieve symptoms, part of the multidisciplinary care team.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-120</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Pain Specialist">
      <data key="d0">Pain Specialist</data>
      <data key="d1">person</data>
      <data key="d2">A specialist in managing pain, part of the multidisciplinary care team.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-120</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Psychologist">
      <data key="d0">Psychologist</data>
      <data key="d1">person</data>
      <data key="d2">A professional who helps with mental health and emotional well-being, part of the multidisciplinary care team.&lt;SEP&gt;A mental health expert who helps manage issues like depression and anxiety.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-120&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-176</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Rehabilitation Specialists">
      <data key="d0">Rehabilitation Specialists</data>
      <data key="d1">person</data>
      <data key="d2">Therapists including physical, occupational, and speech therapists, part of the multidisciplinary care team.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-120</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Palliative Care">
      <data key="d0">Palliative Care</data>
      <data key="d1">method</data>
      <data key="d2">Another term for supportive care, focused on relieving symptoms and improving quality of life.&lt;SEP&gt;Specialized medical care focused on providing relief from symptoms and stress of a serious illness, often used for advanced cancers.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-120&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-145</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Phases of Treatment">
      <data key="d0">Phases of Treatment</data>
      <data key="d1">concept</data>
      <data key="d2">The stages of cancer treatment, including induction and consolidation, as mentioned in the text.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-120</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Induction">
      <data key="d0">Induction</data>
      <data key="d1">concept</data>
      <data key="d2">The initial phase of treatment aimed at achieving remission.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-120</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Consolidation">
      <data key="d0">Consolidation</data>
      <data key="d1">concept</data>
      <data key="d2">A treatment phase after remission to eliminate remaining cancer cells.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-120</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Treatment for the Spine">
      <data key="d0">Treatment for the Spine</data>
      <data key="d1">method</data>
      <data key="d2">A specific treatment approach for lymphoma involving the spine.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-120</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Treatment for the Eyes">
      <data key="d0">Treatment for the Eyes</data>
      <data key="d1">method</data>
      <data key="d2">A specific treatment approach for lymphoma involving the eyes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-120</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Induction Phase">
      <data key="d0">Induction Phase</data>
      <data key="d1">concept</data>
      <data key="d2">The first phase of treatment for primary CNS lymphoma, aiming to eliminate as many lymphoma cells as possible.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-121</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Consolidation Phase">
      <data key="d0">Consolidation Phase</data>
      <data key="d1">concept</data>
      <data key="d2">The second phase of treatment for primary CNS lymphoma, aimed at destroying remaining cancer cells and preventing recurrence.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-121</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Blood-Brain Barrier">
      <data key="d0">Blood-Brain Barrier</data>
      <data key="d1">concept</data>
