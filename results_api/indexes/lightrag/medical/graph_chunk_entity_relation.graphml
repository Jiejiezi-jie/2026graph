    <node id="Transurethral Resection of Bladder Tumor (TURBT)">
      <data key="d0">Transurethral Resection of Bladder Tumor (TURBT)</data>
      <data key="d1">method</data>
      <data key="d2">A procedure that examines tumors on the bladder wall and removes them.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-185</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Anal Canal">
      <data key="d0">Anal Canal</data>
      <data key="d1">location</data>
      <data key="d2">The canal that connects the rectum and the anal opening, about 1.5 inches long, surrounded by anal sphincters.&lt;SEP&gt;The part of the body examined during digital rectal exam and high-resolution anoscopy.&lt;SEP&gt;The short tube at the end of the rectum through which stool passes; site of anal cancer.&lt;SEP&gt;The small section of bowel between the rectum and the anus; a site where anal cancer can start.&lt;SEP&gt;The part of the body where anal canal cancer starts, distinct from the perianal region.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-185&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-187&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-188&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Perianal Region">
      <data key="d0">Perianal Region</data>
      <data key="d1">location</data>
      <data key="d2">The area including the anal opening and the skin directly surrounding it.&lt;SEP&gt;The area around the anus, where precancerous lesions may occur.&lt;SEP&gt;The area including the anal opening and the skin directly surrounding it; a site where anal cancer can start.&lt;SEP&gt;The area including the anal opening and the skin directly surrounding it, where anal cancer can start.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-185&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-187&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-188&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Instillation">
      <data key="d0">Instillation</data>
      <data key="d1">method</data>
      <data key="d2">The process of slowly putting medicine into the bladder through a catheter.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-185</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Anal Sphincters">
      <data key="d0">Anal Sphincters</data>
      <data key="d1">location</data>
      <data key="d2">Muscles surrounding the anal canal that relax to allow stool to leave the body through the anus.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-185</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Anal Adenocarcinoma">
      <data key="d0">Anal Adenocarcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">A rare type of anal cancer that starts in glandular cells, not covered in the patient guide.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-185</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Anal Melanoma">
      <data key="d0">Anal Melanoma</data>
      <data key="d1">concept</data>
      <data key="d2">A rare type of anal cancer that starts in melanocytes, not covered in the patient guide.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-185</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="HPV">
      <data key="d0">HPV</data>
      <data key="d1">concept</data>
      <data key="d2">Human papillomavirus, a group of viruses with more than 100 strains. Certain high-risk strains, such as HPV16, are linked to anal cancer and other cancers.&lt;SEP&gt;Human papillomavirus, a virus that causes almost all cervical and anal cancers.&lt;SEP&gt;Human papillomavirus, an extremely common sexually transmitted virus; the risk factor most strongly linked with anal cancer.&lt;SEP&gt;Human papillomavirus, an extremely common sexually transmitted virus, and the risk factor most strongly linked with anal cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-187&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-188&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Anal Dysplasia">
      <data key="d0">Anal Dysplasia</data>
      <data key="d1">concept</data>
      <data key="d2">Pre-cancerous lesions in or near the anus, also known as anal intraepithelial neoplasia (AIN). Identifying and treating it may prevent anal cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="High-Resolution Anoscopy">
      <data key="d0">High-Resolution Anoscopy</data>
      <data key="d1">method</data>
      <data key="d2">A procedure using a colposcope to view the anal canal with magnification, often after applying acetic acid, to identify abnormal cells and perform biopsies.&lt;SEP&gt;A procedure used to examine the anus for abnormalities.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-196</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="SISCCA">
      <data key="d0">SISCCA</data>
      <data key="d1">concept</data>
      <data key="d2">Superficially invasive squamous cell carcinoma, the earliest form of anal cancer. Lesions are tiny (less than 7 mm wide) and not deep.&lt;SEP&gt;Superficially invasive squamous cell carcinoma, a less advanced form of anal cancer that does not require the same extensive treatment.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-187</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Colorectal Surgeons">
      <data key="d0">Colorectal Surgeons</data>
      <data key="d1">person</data>
      <data key="d2">Specialists best qualified to evaluate anal cancer, as they are trained in procedures like high-resolution anoscopy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Rectal Bleeding">
      <data key="d0">Rectal Bleeding</data>
      <data key="d1">concept</data>
      <data key="d2">The most common symptom of anal cancer, involving blood from the anus, which may be noticed in stool, on toilet paper, or in the toilet bowl.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Anal Itching">
      <data key="d0">Anal Itching</data>
      <data key="d1">concept</data>
      <data key="d2">A common symptom of anal cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Anal Sex">
      <data key="d0">Anal Sex</data>
      <data key="d1">concept</data>
      <data key="d2">A risk factor for anal cancer, as it may increase exposure to HPV.&lt;SEP&gt;Sexual activity involving the anus, which is a risk factor for anal cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Crohn's Disease">
      <data key="d0">Crohn's Disease</data>
      <data key="d1">concept</data>
      <data key="d2">An autoimmune disorder that is a risk factor for anal cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Genital Warts">
      <data key="d0">Genital Warts</data>
      <data key="d1">concept</data>
      <data key="d2">Abnormal skin growths caused by HPV infection that can form on the anus or genitals.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Colposcope">
      <data key="d0">Colposcope</data>
      <data key="d1">artifact</data>
      <data key="d2">A special magnifying glass used in high-resolution anoscopy to examine the anal canal.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Anoscope">
      <data key="d0">Anoscope</data>
      <data key="d1">artifact</data>
      <data key="d2">A short, hollow tool inserted into the anus during high-resolution anoscopy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Acetic Acid">
      <data key="d0">Acetic Acid</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A liquid applied to the anal canal tissue during high-resolution anoscopy to make abnormal cells appear differently.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Standard Anoscopy">
      <data key="d0">Standard Anoscopy</data>
      <data key="d1">method</data>
      <data key="d2">A procedure similar to high-resolution anoscopy but without the use of a colposcope.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Sexually Transmitted Infection">
      <data key="d0">Sexually Transmitted Infection</data>
      <data key="d1">concept</data>
      <data key="d2">An infection transmitted through sexual contact, which is a risk factor for anal cancer.&lt;SEP&gt;Infections transmitted through sexual contact, a risk factor for anal cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Hemorrhoids">
      <data key="d0">Hemorrhoids</data>
      <data key="d1">concept</data>
      <data key="d2">Common benign growths that may be confused with anal cancer symptoms.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Anal Skin Tags">
      <data key="d0">Anal Skin Tags</data>
      <data key="d1">concept</data>
      <data key="d2">Benign growths that may be removed and found to contain SISCCA.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Anal Precancer">
      <data key="d0">Anal Precancer</data>
      <data key="d1">concept</data>
      <data key="d2">A history of anal precancer is a risk factor for anal cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Autoimmune Disorders">
      <data key="d0">Autoimmune Disorders</data>
      <data key="d1">concept</data>
      <data key="d2">Conditions such as Crohn's disease that are risk factors for anal cancer.&lt;SEP&gt;Conditions where the immune system attacks the body's own tissues, listed as a risk factor for anal cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Low-Grade Squamous Intraepithelial Lesion">
      <data key="d0">Low-Grade Squamous Intraepithelial Lesion</data>
      <data key="d1">concept</data>
      <data key="d2">A type of anal dysplasia that is mild.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="High-Grade Squamous Intraepithelial Lesion">
      <data key="d0">High-Grade Squamous Intraepithelial Lesion</data>
      <data key="d1">concept</data>
      <data key="d2">A type of anal dysplasia that is moderate or severe.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Anal Intraepithelial Neoplasia">
      <data key="d0">Anal Intraepithelial Neoplasia</data>
      <data key="d1">concept</data>
      <data key="d2">Another name for anal dysplasia.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Stage 0 Anal Cancer">
      <data key="d0">Stage 0 Anal Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of anal cancer that is equivalent to high-grade anal dysplasia.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Inguinal Lymph Nodes">
      <data key="d0">Inguinal Lymph Nodes</data>
      <data key="d1">artifact</data>
      <data key="d2">Lymph nodes located in the groin area, which are common sites for anal cancer spread.&lt;SEP&gt;Lymph nodes located in the groin area, which may be affected by anal cancer recurrence.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-187&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-192</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Computed Tomography (CT)">
      <data key="d0">Computed Tomography (CT)</data>
      <data key="d1">method</data>
      <data key="d2">An imaging technique that uses x-rays to create detailed pictures of the inside of the body.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-187</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Gynecologic Exam">
      <data key="d0">Gynecologic Exam</data>
      <data key="d1">method</data>
      <data key="d2">An examination of the female reproductive system, including screening for cervical cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-187</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="HPV/Pap Co-test">
      <data key="d0">HPV/Pap Co-test</data>
      <data key="d1">method</data>
      <data key="d2">A cervical cancer screening that tests for both HPV and cancer cells.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-187</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Precancer">
      <data key="d0">Precancer</data>
      <data key="d1">concept</data>
      <data key="d2">Abnormal cells on the surface of the anal canal or perianal region that may develop into cancer.&lt;SEP&gt;Abnormal cells on the surface of the anal canal or perianal region that may develop into cancer. Also known as stage 0 anal cancer, anal dysplasia, carcinoma in situ, high-grade anal intraepithelial neoplasia (AIN), and high-grade squamous intraepithelial lesions (HSIL).</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-187&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-188</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Groin">
      <data key="d0">Groin</data>
      <data key="d1">location</data>
      <data key="d2">The area where the thigh meets the abdomen, containing inguinal lymph nodes.&lt;SEP&gt;Area where lymph nodes are targeted during radiation therapy for anal cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-187&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Radioactive Glucose">
      <data key="d0">Radioactive Glucose</data>
      <data key="d1">artifact</data>
      <data key="d2">A substance injected during PET scans to detect cancer cells.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-187</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Stage I Anal Cancer">
      <data key="d0">Stage I Anal Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Anal cancer stage where the tumor is 2 cm or smaller and has not spread to lymph nodes or distant sites. Described as T1, N0, M0.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-188</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Stage II Anal Cancer">
      <data key="d0">Stage II Anal Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Anal cancer stage divided into IIA (tumor &gt;2 cm but ≤5 cm, T2 N0 M0) and IIB (tumor &gt;5 cm, T3 N0 M0), with no lymph node or distant spread.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-188</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Stage III Anal Cancer">
      <data key="d0">Stage III Anal Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Anal cancer stage divided into IIIA (tumor ≤5 cm with lymph node involvement), IIIB (tumor invades nearby organs but no lymph node involvement), and IIIC (tumor &gt;5 cm or invades nearby organs with lymph node involvement).</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-188</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Stage IV Anal Cancer">
      <data key="d0">Stage IV Anal Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Metastatic anal cancer that has spread to distant sites such as the liver or lungs.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-188</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Immunosuppressant Use">
      <data key="d0">Immunosuppressant Use</data>
      <data key="d1">concept</data>
      <data key="d2">The use of drugs that suppress the immune system; a risk factor for anal cancer.&lt;SEP&gt;The use of drugs that suppress the immune system, which is a risk factor for anal cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-188&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Michael">
      <data key="d0">Michael</data>
      <data key="d1">person</data>
      <data key="d2">An anal cancer survivor who advises getting a mentor and paying it forward by mentoring others.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-188</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="NCCN Guidelines for Patients: Adolescents and Young Adults with Cancer">
      <data key="d0">NCCN Guidelines for Patients: Adolescents and Young Adults with Cancer</data>
      <data key="d1">content</data>
      <data key="d2">A patient guideline document from NCCN that provides information on fertility preservation and other topics.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-188</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Eggs">
      <data key="d0">Eggs</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Female reproductive cells; frozen in egg freezing and present in ovarian tissue.</data>
