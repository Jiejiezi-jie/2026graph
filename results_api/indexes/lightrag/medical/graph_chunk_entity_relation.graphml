    <node id="Prostate-Specific Antigen">
      <data key="d0">Prostate-Specific Antigen</data>
      <data key="d1">biomarker</data>
      <data key="d2">A protein produced by the prostate gland; its level in the blood is measured to screen for prostate cancer and assess risk.&lt;SEP&gt;A protein made by prostate cells, both normal and cancerous, that helps semen transport sperm. Its levels in blood are measured by the PSA test.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-085&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-089</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Grade Group">
      <data key="d0">Grade Group</data>
      <data key="d1">concept</data>
      <data key="d2">A system for classifying prostate cancer based on the Gleason score, used in risk assessment.&lt;SEP&gt;A system from 1 to 5 that interprets Gleason scores to estimate prostate cancer risk, with higher groups indicating more aggressive cancer.&lt;SEP&gt;A system for classifying prostate cancer based on Gleason score, ranging from Grade Group 1 (lowest risk) to Grade Group 5 (highest risk).</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-085&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-086&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-087</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Tumor Stage">
      <data key="d0">Tumor Stage</data>
      <data key="d1">concept</data>
      <data key="d2">The extent of cancer spread, used in risk assessment for prostate cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-085</data>
      <data key="d4">unknown_source</data>
