    <node id="Oral Surgeon">
      <data key="d0">Oral Surgeon</data>
      <data key="d1">person</data>
      <data key="d2">A specialist who performs surgical procedures on the mouth, teeth, and jaws, and is involved in treatment planning for dental and oral conditions.</data>
