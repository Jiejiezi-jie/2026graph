    </node>
    <node id="Fiberoptic Scope">
      <data key="d0">Fiberoptic Scope</data>
      <data key="d1">artifact</data>
      <data key="d2">A flexible instrument with a light and camera used to view areas of the mouth and throat that are not easily visible.&lt;SEP&gt;A flexible instrument with a light and camera used to examine the throat and other areas.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-028&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-050</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682996</data>
      <data key="d6" />
    </node>
    <node id="Pure-Tone Hearing Test">
      <data key="d0">Pure-Tone Hearing Test</data>
      <data key="d1">method</data>
      <data key="d2">A hearing test that uses tones at different frequencies and volumes to determine hearing ability.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-028</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682996</data>
