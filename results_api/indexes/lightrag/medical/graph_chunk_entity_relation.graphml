    </node>
    <node id="FES PET-CT">
      <data key="d0">FES PET-CT</data>
      <data key="d1">method</data>
      <data key="d2">A PET-CT using a radioactive form of estrogen (FES), used instead of FDG PET-CT when cancer is estrogen receptor-positive.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-103</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Core Biopsy (CB)">
      <data key="d0">Core Biopsy (CB)</data>
      <data key="d1">method</data>
      <data key="d2">A biopsy type using a larger needle to remove a sample of tissue.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-103</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
