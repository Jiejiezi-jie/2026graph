    <node id="p16 Protein">
      <data key="d0">p16 Protein</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A protein that slows cell division, produced by a gene on chromosome 9, used as a surrogate marker for HPV infection.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-052</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683058</data>
