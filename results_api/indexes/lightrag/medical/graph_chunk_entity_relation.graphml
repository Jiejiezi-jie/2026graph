    <node id="Hip Joints">
      <data key="d0">Hip Joints</data>
      <data key="d1">location</data>
      <data key="d2">Joints near the cervix that can be affected by radiation.&lt;SEP&gt;Joints in the pelvic area that IMRT aims to spare from radiation to reduce side effects.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Radiation-Induced Menopause">
      <data key="d0">Radiation-Induced Menopause</data>
      <data key="d1">concept</data>
      <data key="d2">Menopause caused by radiation therapy to the ovaries, leading to symptoms similar to surgical menopause.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Sexual Health">
      <data key="d0">Sexual Health</data>
      <data key="d1">concept</data>
      <data key="d2">Aspect of health affected by radiation therapy for cervical cancer.&lt;SEP&gt;An aspect of health that can be affected by radiation therapy for anal cancer.&lt;SEP&gt;Aspects of health related to sexual function and well-being, which can be affected by anal cancer treatment.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-195</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Bowel Function">
      <data key="d0">Bowel Function</data>
      <data key="d1">concept</data>
      <data key="d2">Function of the bowel that can be affected by radiation therapy.&lt;SEP&gt;A bodily function that can be affected by radiation therapy for anal cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Bladder Function">
      <data key="d0">Bladder Function</data>
      <data key="d1">concept</data>
      <data key="d2">Function of the bladder that can be affected by radiation therapy.&lt;SEP&gt;A bodily function that can be affected by radiation therapy for anal cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Ink Marks">
      <data key="d0">Ink Marks</data>
      <data key="d1">artifact</data>
      <data key="d2">Tattoos on the skin used to position the body accurately for daily radiation treatments.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Prop">
      <data key="d0">Prop</data>
      <data key="d1">artifact</data>
      <data key="d2">Device used to help the patient stay still during radiation sessions.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Computer Software">
      <data key="d0">Computer Software</data>
      <data key="d1">artifact</data>
      <data key="d2">Sophisticated software used by the radiation oncologist to create a treatment plan.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Quality Assurance">
      <data key="d0">Quality Assurance</data>
      <data key="d1">concept</data>
      <data key="d2">Process to ensure accuracy of treatment planning and delivery.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Locally Advanced Cervical Cancer">
      <data key="d0">Locally Advanced Cervical Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Cervical cancer that has grown beyond the cervix but not spread to distant organs.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Metastatic Cervical Cancer">
      <data key="d0">Metastatic Cervical Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Cervical cancer that has spread to distant organs like liver, lungs, or bone.&lt;SEP&gt;Cervical cancer that has spread to distant parts of the body.&lt;SEP&gt;Cervical cancer that has spread to distant organs such as the liver, lungs, or bone, and is difficult to cure.&lt;SEP&gt;A type of cancer that has spread from the cervix to other parts of the body, such as the liver, lungs, or bone.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-144&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-145</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="EBRT">
      <data key="d0">EBRT</data>
      <data key="d1">method</data>
      <data key="d2">External beam radiation therapy, a type of radiation treatment that is often used with chemotherapy to treat cervical cancer.&lt;SEP&gt;External beam radiation therapy, where a large machine aims radiation at the cancer site.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-140</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Intracavitary Brachytherapy">
      <data key="d0">Intracavitary Brachytherapy</data>
      <data key="d1">method</data>
      <data key="d2">A type of brachytherapy where instruments are placed into the cervix, uterus, and vagina to deliver radiation, most often used for cervical cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Interstitial Brachytherapy">
      <data key="d0">Interstitial Brachytherapy</data>
      <data key="d1">method</data>
      <data key="d2">A specialized brachytherapy technique where catheters are placed in the tumor or nearby tissues, used for more advanced cancers involving the parametrium.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="High Dose-Rate (HDR) Brachytherapy">
      <data key="d0">High Dose-Rate (HDR) Brachytherapy</data>
      <data key="d1">method</data>
      <data key="d2">A type of brachytherapy given in short bursts, currently used by most centers for cervical cancer treatment.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Low Dose-Rate (LDR) Brachytherapy">
      <data key="d0">Low Dose-Rate (LDR) Brachytherapy</data>
      <data key="d1">method</data>
      <data key="d2">A type of brachytherapy given in long bursts, less commonly used now.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Applicator">
      <data key="d0">Applicator</data>
      <data key="d1">artifact</data>
      <data key="d2">A device inserted into the uterus through the vagina for brachytherapy, with types like tandem and ring or tandem and ovoid.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Tandem and Ring Applicator">
      <data key="d0">Tandem and Ring Applicator</data>
      <data key="d1">artifact</data>
      <data key="d2">A common applicator for HDR brachytherapy, consisting of a long thin tube (tandem) and a hollow circle (ring).</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Tandem and Ovoid Applicator">
      <data key="d0">Tandem and Ovoid Applicator</data>
      <data key="d1">artifact</data>
      <data key="d2">An applicator that uses hollow, rounded capsules instead of a ring.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Biomarkers">
      <data key="d0">Biomarkers</data>
      <data key="d1">concept</data>
      <data key="d2">Specific features of cancers that make targeted therapy and immunotherapy effective.&lt;SEP&gt;Proteins or other molecules that can be tested in a tumor sample.&lt;SEP&gt;Biological markers found in the body that indicate a condition or disease; in cancer care, they include changes in genes, proteins, and other markers.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-157&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-168</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Recurrent Cervical Cancer">
      <data key="d0">Recurrent Cervical Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Cervical cancer that has returned after treatment.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Deep Sedation">
      <data key="d0">Deep Sedation</data>
      <data key="d1">concept</data>
      <data key="d2">A state of reduced consciousness used during medical procedures, often required for brachytherapy applicator placement.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Radiation Source">
      <data key="d0">Radiation Source</data>
      <data key="d1">artifact</data>
      <data key="d2">A radioactive material that travels from the brachytherapy machine through hollow tubes into the applicator.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Brachytherapy Machine">
      <data key="d0">Brachytherapy Machine</data>
      <data key="d1">artifact</data>
      <data key="d2">A device that connects to the applicator and delivers the radiation source during brachytherapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Catheters">
      <data key="d0">Catheters</data>
      <data key="d1">artifact</data>
      <data key="d2">Thin hollow tubes used in interstitial brachytherapy, placed in the tumor or nearby tissues.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-139</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="FDA">
      <data key="d0">FDA</data>
      <data key="d1">organization</data>
      <data key="d2">The U.S. Food and Drug Administration, which approves drugs, devices, or treatment approaches that are found safe and effective in clinical trials.&lt;SEP&gt;The U.S. Food and Drug Administration, which approves new drugs and treatments.&lt;SEP&gt;The U.S. Food and Drug Administration, which approves treatments based on clinical trial results.&lt;SEP&gt;U.S. Food and Drug Administration, which approves drugs, devices, or treatment approaches found safe and effective in clinical trials.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-140&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-183&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-184&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-193</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Locally Advanced Cancer">
      <data key="d0">Locally Advanced Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Cancer that has spread locally but not to distant sites, often treated with chemoradiation.&lt;SEP&gt;Cervical cancer that has grown beyond the cervix but has not metastasized to distant organs.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-140&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Lymphovascular Space Invasion (LVSI)">
      <data key="d0">Lymphovascular Space Invasion (LVSI)</data>
      <data key="d1">concept</data>
      <data key="d2">A risk factor indicating tumor cells in blood or lymph vessels within the tumor, increasing likelihood of spread to lymph nodes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Radical Trachelectomy">
      <data key="d0">Radical Trachelectomy</data>
      <data key="d1">method</data>
      <data key="d2">Surgical removal of the cervix and part of the vagina, preserving the uterus for fertility.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Pelvic Lymph Node Evaluation">
      <data key="d0">Pelvic Lymph Node Evaluation</data>
      <data key="d1">method</data>
      <data key="d2">Assessment of lymph nodes in the pelvic area to check for cancer spread.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Vaginal Brachytherapy">
      <data key="d0">Vaginal Brachytherapy</data>
      <data key="d1">method</data>
      <data key="d2">Internal radiation therapy where a radioactive source is placed near the tumor in the vagina.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Stage 1A1">
      <data key="d0">Stage 1A1</data>
      <data key="d1">concept</data>
      <data key="d2">A specific stage of cervical cancer where the cancer is microscopic and has invaded less than 3 mm into the cervix.&lt;SEP&gt;A stage of cervical cancer where cancer is microscopic and invades less than 3 mm deep.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Stage 1A2">
      <data key="d0">Stage 1A2</data>
      <data key="d1">concept</data>
      <data key="d2">A specific stage of cervical cancer where the cancer is microscopic and has invaded 3-5 mm into the cervix.&lt;SEP&gt;A stage of cervical cancer with microscopic invasion between 3 and 5 mm deep.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Stage 1B1">
      <data key="d0">Stage 1B1</data>
      <data key="d1">concept</data>
      <data key="d2">A specific stage of cervical cancer where the cancer is clinically visible but limited to the cervix and less than 4 cm in size.&lt;SEP&gt;A stage of cervical cancer where the tumor is larger than 5 mm but not more than 2 cm.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Stage 1B2">
      <data key="d0">Stage 1B2</data>
      <data key="d1">concept</data>
      <data key="d2">A specific stage of cervical cancer where the cancer is clinically visible, limited to the cervix, and larger than 4 cm.&lt;SEP&gt;A stage of cervical cancer where the tumor is larger than 2 cm but not more than 4 cm.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Para-Aortic Lymph Nodes">
      <data key="d0">Para-Aortic Lymph Nodes</data>
      <data key="d1">concept</data>
      <data key="d2">Lymph nodes in the abdomen that may be removed in addition to pelvic lymph nodes in certain stages.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Stage 1">
      <data key="d0">Stage 1</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of cervical cancer where the cancer is confined to the cervix.&lt;SEP&gt;Bladder cancer that has grown through the inner lining into the connective tissue layer but has not invaded the muscle layer (non-muscle-invasive).</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-179</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Platinum Chemotherapy">
      <data key="d0">Platinum Chemotherapy</data>
      <data key="d1">method</data>
      <data key="d2">A type of chemotherapy using platinum-based drugs, often given concurrently with radiation.&lt;SEP&gt;Chemotherapy using platinum-based drugs, often used in cervical cancer treatment.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Extrafascial (Simple) Hysterectomy">
      <data key="d0">Extrafascial (Simple) Hysterectomy</data>
      <data key="d1">method</data>
      <data key="d2">A surgical procedure to remove the uterus and cervix, typically for early-stage cancer when fertility preservation is not desired.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Pre-Cancer">
      <data key="d0">Pre-Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Abnormal cells that have the potential to become cancer if left untreated.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Extrafascial Hysterectomy">
      <data key="d0">Extrafascial Hysterectomy</data>
      <data key="d1">method</data>
      <data key="d2">A surgical procedure to remove the uterus, often recommended for certain stages of cervical cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Modified Radical Hysterectomy">
      <data key="d0">Modified Radical Hysterectomy</data>
      <data key="d1">method</data>
      <data key="d2">A surgical procedure that removes the uterus and some surrounding tissue, used for certain cervical cancer stages.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Radical Hysterectomy">
      <data key="d0">Radical Hysterectomy</data>
      <data key="d1">method</data>
      <data key="d2">A more extensive surgery for cervical cancer that removes the uterus, cervix, and surrounding tissues.&lt;SEP&gt;A surgical procedure to remove the uterus and surrounding tissues, often considered for carefully selected patients with recurrent cervical cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-144</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Lymph Node Evaluation">
      <data key="d0">Lymph Node Evaluation</data>
      <data key="d1">method</data>
      <data key="d2">The process of examining lymph nodes to check for cancer spread.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Pelvic Lymph Node Dissection">
      <data key="d0">Pelvic Lymph Node Dissection</data>
      <data key="d1">method</data>
      <data key="d2">Surgical removal of pelvic lymph nodes for examination.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Stage 1B3">
      <data key="d0">Stage 1B3</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of cervical cancer where the tumor is larger than 4 cm and confined to the cervix.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Stage 2A1">
      <data key="d0">Stage 2A1</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of cervical cancer where the tumor invades beyond the cervix but not the pelvic wall, and is 4 cm or less.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Stage 2A2">
      <data key="d0">Stage 2A2</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of cervical cancer where the tumor invades beyond the cervix but not the pelvic wall, and is larger than 4 cm.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Stage 3">
      <data key="d0">Stage 3</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of cervical cancer where the tumor involves the lower vagina or pelvic wall, or causes hydronephrosis.&lt;SEP&gt;Bladder cancer that has grown through the bladder wall into the fatty layer, possibly spreading to lymph nodes and nearby organs in the pelvis. It has two subgroups: Stage 3A and Stage 3B.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-179</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="LVSI">
      <data key="d0">LVSI</data>
      <data key="d1">concept</data>
      <data key="d2">Lymphovascular space invasion, a risk factor in cervical cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Para-aortic Lymph Nodes">
      <data key="d0">Para-aortic Lymph Nodes</data>
      <data key="d1">location</data>
      <data key="d2">Lymph nodes located in the abdomen near the aorta.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Pelvic Lymph Nodes">
      <data key="d0">Pelvic Lymph Nodes</data>
      <data key="d1">location</data>
      <data key="d2">Lymph nodes located in the pelvic region.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Risk Factors">
      <data key="d0">Risk Factors</data>
      <data key="d1">concept</data>
      <data key="d2">Factors such as tumor size and LVSI that influence the recommendation for EBRT after surgery.&lt;SEP&gt;Attributes or exposures that increase the likelihood of developing a condition.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-196</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Low-Risk Stage 1B1">
      <data key="d0">Low-Risk Stage 1B1</data>
      <data key="d1">concept</data>
      <data key="d2">A stage 1B1 cancer that meets specific criteria for extrafascial hysterectomy, such as no LVSI and tumor size ≤2 cm.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="High-Grade Squamous Cell Carcinoma">
      <data key="d0">High-Grade Squamous Cell Carcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">A type of cervical cancer that may not be eligible for extrafascial hysterectomy based on criteria.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Low-Grade Adenocarcinoma">
      <data key="d0">Low-Grade Adenocarcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">A type of cervical cancer that may be eligible for extrafascial hysterectomy if other criteria are met.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Tumor Size">
      <data key="d0">Tumor Size</data>
      <data key="d1">concept</data>
      <data key="d2">A factor considered in treatment decisions for cervical cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Cone Biopsy Margins">
      <data key="d0">Cone Biopsy Margins</data>
      <data key="d1">concept</data>
      <data key="d2">The edges of tissue removed during cone biopsy, which are examined for cancer or pre-cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Pre-cancer">
      <data key="d0">Pre-cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Abnormal cells that have the potential to become cancer, found in cone biopsy margins.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Small Cell Neuroendocrine Carcinoma">
      <data key="d0">Small Cell Neuroendocrine Carcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">A rare and aggressive type of cervical cancer that requires surveillance similar to common types.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Small Cell Neuroendocrine Carcinoma of the Cervix">
      <data key="d0">Small Cell Neuroendocrine Carcinoma of the Cervix</data>
      <data key="d1">concept</data>
      <data key="d2">A rare and aggressive type of cervical cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-143</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Physical Exams">
      <data key="d0">Physical Exams</data>
      <data key="d1">method</data>
      <data key="d2">Follow-up examinations performed by an oncologist to monitor for recurrence, especially in the first five years after treatment.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-143</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Pap Tests">
      <data key="d0">Pap Tests</data>
      <data key="d1">method</data>
      <data key="d2">Screening tests for cervical cancer that detect abnormal or precancerous cells, also known as cervical or vaginal cytology.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-143</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="RET Gene Fusion">
      <data key="d0">RET Gene Fusion</data>
      <data key="d1">concept</data>
      <data key="d2">A genetic alteration that may be present in some cancers.&lt;SEP&gt;A genetic alteration in the RET gene, found in some medullary thyroid cancers, that can be a target for therapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-143&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Local or Regional Recurrence">
      <data key="d0">Local or Regional Recurrence</data>
      <data key="d1">concept</data>
      <data key="d2">Cervical cancer that returns only in the pelvis.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-143</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Pelvic Exenteration">
      <data key="d0">Pelvic Exenteration</data>
      <data key="d1">method</data>
      <data key="d2">A surgical procedure to remove pelvic organs when cancer recurs in the pelvis.&lt;SEP&gt;A radical surgery that removes multiple organs from the pelvis, including the female reproductive system and possibly nearby organs like the bladder, rectum, and anus, to cure cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-143&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-144</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Exploratory Surgery">
      <data key="d0">Exploratory Surgery</data>
      <data key="d1">method</data>
      <data key="d2">Surgery to look inside the body to determine the extent of cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-143</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Stage 1 Cervical Cancer">
      <data key="d0">Stage 1 Cervical Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">An early stage of cervical cancer, including stage 1B3, with specific follow-up imaging recommendations.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-143</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Stage 3 Cervical Cancer">
      <data key="d0">Stage 3 Cervical Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of cervical cancer where imaging is recommended 3 to 6 months after treatment.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-143</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Distant Recurrence">
      <data key="d0">Distant Recurrence</data>
      <data key="d1">concept</data>
      <data key="d2">Recurrence of cervical cancer at distant sites, often stage 4B.&lt;SEP&gt;A cancer recurrence that occurs in distant organs after treatment, considered metastatic.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-143&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-144</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Cervical Sarcoma">
      <data key="d0">Cervical Sarcoma</data>
      <data key="d1">concept</data>
      <data key="d2">A rare type of cervical cancer that may have NTRK gene fusion.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-143</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="PD-L1-Positive Tumor">
      <data key="d0">PD-L1-Positive Tumor</data>
      <data key="d1">concept</data>
      <data key="d2">A tumor that has high PD-L1 expression, making it eligible for certain targeted therapies or immunotherapies.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-143</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Vaginal Reconstruction">
      <data key="d0">Vaginal Reconstruction</data>
      <data key="d1">method</data>
      <data key="d2">A surgical procedure to create an artificial vagina using muscle from another part of the body, often after pelvic exenteration.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-144</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Ileal Conduit">
      <data key="d0">Ileal Conduit</data>
      <data key="d1">method</data>
      <data key="d2">A type of urinary diversion where a new tube is created from a piece of intestine to allow urine to exit through a stoma.&lt;SEP&gt;A type of urinary diversion using a section of the small intestine as a conduit, with a stoma and ostomy bag.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-144&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-181</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Continent Urinary Diversion">
      <data key="d0">Continent Urinary Diversion</data>
      <data key="d1">method</data>
      <data key="d2">A urinary diversion method that creates an internal pouch to hold urine, eliminating the need for an external ostomy bag.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-144</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Double-Barreled Wet Colostomy (DBWC)">
      <data key="d0">Double-Barreled Wet Colostomy (DBWC)</data>
      <data key="d1">method</data>
      <data key="d2">A surgical technique that uses a single stoma for both urinary and fecal diversion, keeping urine and stool separate until exit.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-144</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Ablative Therapies">
      <data key="d0">Ablative Therapies</data>
      <data key="d1">method</data>
      <data key="d2">Treatments that destroy cancerous lesions with minimal harm to nearby tissue, often using probes or electrodes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-144</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Stereotactic Body Radiation Therapy (SBRT)">
      <data key="d0">Stereotactic Body Radiation Therapy (SBRT)</data>
      <data key="d1">method</data>
      <data key="d2">A highly specialized type of EBRT that delivers precise radiation to tumors in the liver, lungs, or bone in a few sessions.&lt;SEP&gt;A special type of radiation therapy used for limited small metastases.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-144&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-193</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Ostomy Bag">
      <data key="d0">Ostomy Bag</data>
      <data key="d1">artifact</data>
      <data key="d2">A disposable bag attached to the skin to collect urine or stool from a stoma.&lt;SEP&gt;A disposable bag attached to the abdomen to collect urine from a stoma.&lt;SEP&gt;A bag attached to a stoma to collect urine, not needed with an Indiana pouch.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-144&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-181&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-182</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Wafer">
      <data key="d0">Wafer</data>
      <data key="d1">artifact</data>
      <data key="d2">An adhesive part of an ostomy bag that sticks to the skin and acts as a watertight barrier.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-144</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Rectus Abdominus Muscle">
      <data key="d0">Rectus Abdominus Muscle</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A muscle in the lower abdomen often used for vaginal reconstruction.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-144</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Ileum">
      <data key="d0">Ileum</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A part of the small intestine used to create a urinary diversion.&lt;SEP&gt;A section of the small intestine that is removed and used as a conduit in ileal conduit urinary diversion.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-144&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-181</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Indiana Pouch">
      <data key="d0">Indiana Pouch</data>
      <data key="d1">method</data>
      <data key="d2">Another name for a continent urinary diversion, an artificial bladder created from intestine.&lt;SEP&gt;Another name for the continent cutaneous pouch, developed by surgeons at Indiana University.&lt;SEP&gt;A type of urinary diversion developed by surgeons at Indiana University, using a section of the small intestine to create a pouch connected to a stoma, with a one-way valve to prevent urine leakage, requiring catheterization for drainage.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-144&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-181&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-182</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Artificial Bladder">
