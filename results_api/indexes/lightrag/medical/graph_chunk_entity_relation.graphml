      <data key="d1">artifact</data>
      <data key="d2">A chemotherapy drug used in combination with leucovorin for colon cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-125</data>
      <data key="d4">unknown_source</data>
