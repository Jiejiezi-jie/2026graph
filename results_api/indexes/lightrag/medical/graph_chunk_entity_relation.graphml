    <node id="Lymph Node Status (N)">
      <data key="d0">Lymph Node Status (N)</data>
      <data key="d1">concept</data>
      <data key="d2">A component of the TNM staging system that indicates whether cancer has spread to regional lymph nodes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="Distant Metastasis (M)">
      <data key="d0">Distant Metastasis (M)</data>
      <data key="d1">concept</data>
      <data key="d2">A component of the TNM staging system that indicates whether cancer has spread to distant parts of the body.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="Anatomic TNM">
      <data key="d0">Anatomic TNM</data>
      <data key="d1">concept</data>
      <data key="d2">A staging system based solely on the anatomic extent of cancer as defined by T, N, and M categories.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="Prognostic Stage">
      <data key="d0">Prognostic Stage</data>
      <data key="d1">concept</data>
      <data key="d2">A staging system that combines anatomic TNM with tumor grade and biomarker status to predict outcome.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="Human Epidermal Growth Factor Receptor 2 (HER2)">
      <data key="d0">Human Epidermal Growth Factor Receptor 2 (HER2)</data>
      <data key="d1">concept</data>
      <data key="d2">A protein that promotes cancer cell growth; some breast cancers have too much of it.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="Tumor Grade (G)">
      <data key="d0">Tumor Grade (G)</data>
      <data key="d1">concept</data>
      <data key="d2">A measure of how abnormal cancer cells look under a microscope, indicating aggressiveness.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="T1mi">
      <data key="d0">T1mi</data>
      <data key="d1">concept</data>
      <data key="d2">A T category indicating a tumor with micrometastasis, a small collection of cancer cells smaller than 1 mm.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="T4">
      <data key="d0">T4</data>
      <data key="d1">concept</data>
      <data key="d2">A T category indicating a tumor of any size that has invaded nearby structures such as the chest wall or skin.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="T4d">
      <data key="d0">T4d</data>
      <data key="d1">concept</data>
      <data key="d2">A T category indicating inflammatory carcinoma (inflammatory breast cancer).</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="N0">
      <data key="d0">N0</data>
      <data key="d1">concept</data>
      <data key="d2">An N category indicating no cancer in regional lymph nodes, though isolated tumor cells may be present.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="N1mi">
      <data key="d0">N1mi</data>
      <data key="d1">concept</data>
      <data key="d2">An N category indicating micrometastases (approximately 200 cells) in lymph nodes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="N1">
      <data key="d0">N1</data>
      <data key="d1">concept</data>
      <data key="d2">An N category indicating regional lymph node metastases.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="N2">
      <data key="d0">N2</data>
      <data key="d1">concept</data>
      <data key="d2">An N category indicating more extensive regional lymph node metastases.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="N3">
      <data key="d0">N3</data>
      <data key="d1">concept</data>
      <data key="d2">An N category indicating even more extensive regional lymph node metastases.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="M0">
      <data key="d0">M0</data>
      <data key="d1">concept</data>
      <data key="d2">An M category indicating no evidence of distant metastasis.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="M1">
      <data key="d0">M1</data>
      <data key="d1">concept</data>
      <data key="d2">An M category indicating distant metastasis is found, defining metastatic breast cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
