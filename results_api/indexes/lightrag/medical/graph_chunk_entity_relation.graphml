    <node id="Infertility">
      <data key="d0">Infertility</data>
      <data key="d1">concept</data>
      <data key="d2">The inability to produce children; a potential side effect of radiation and chemotherapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-188</data>
      <data key="d4">unknown_source</data>
