      <data key="d10">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-136</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1788683104</data>
      <data key="d13" />
    </edge>
    <edge source="Cervical Cancer" target="Stage 3C Cervical Cancer">
      <data key="d7">1.0</data>
      <data key="d8">Stage 3C cervical cancer involves cancer in pelvic or para-aortic lymph nodes.</data>
