    <node id="Striated Muscle">
      <data key="d0">Striated Muscle</data>
      <data key="d1">concept</data>
      <data key="d2">Muscle type in the upper esophagus that is under voluntary control.&lt;SEP&gt;Muscle type in the upper esophagus that generates force and contracts voluntarily.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-020&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-021</data>
      <data key="d4">unknown_source</data>
