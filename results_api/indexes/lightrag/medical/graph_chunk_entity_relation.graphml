    </node>
    <node id="Hormonal Birth Control">
      <data key="d0">Hormonal Birth Control</data>
      <data key="d1">artifact</data>
      <data key="d2">Contraceptive methods that use hormones to prevent pregnancy.&lt;SEP&gt;Contraceptive methods that use hormones to prevent pregnancy, such as pills, patches, or rings.&lt;SEP&gt;Contraceptive methods that use hormones to prevent pregnancy, which may or may not be recommended during cancer treatment.&lt;SEP&gt;Contraceptive method that may or may not be recommended during treatment.&lt;SEP&gt;Contraceptive methods that use hormones to prevent pregnancy, which may be used during cancer treatment.&lt;SEP&gt;A contraceptive method using hormones; may or may not be recommended during cancer treatment.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-028&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-052&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-101&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-128&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-154&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-155</data>
