    <node id="Locoregional Cancer">
      <data key="d0">Locoregional Cancer</data>
      <data key="d1">disease</data>
      <data key="d2">Stage of esophageal cancer where the tumor has invaded the esophagus wall or spread to nearby lymph nodes or organs.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-021</data>
