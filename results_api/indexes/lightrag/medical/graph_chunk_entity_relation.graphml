    <node id="Skin Lesion Biopsy">
      <data key="d0">Skin Lesion Biopsy</data>
      <data key="d1">method</data>
      <data key="d2">A biopsy of a skin lesion, possibly done if BPDCN is suspected.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-035</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Flow Cytometry">
      <data key="d0">Flow Cytometry</data>
      <data key="d1">method</data>
      <data key="d2">A laboratory method to detect, identify, and count specific cells.&lt;SEP&gt;A laboratory technique used to detect and measure physical and chemical characteristics of cells, commonly used for immunophenotyping and identifying markers on cells.&lt;SEP&gt;A method used to test blood for CLL.&lt;SEP&gt;A test that detects protein patterns on cells to identify immunophenotype.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-035&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-070&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-169&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-170</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Leukemia">
      <data key="d0">Leukemia</data>
      <data key="d1">concept</data>
      <data key="d2">A type of cancer that starts in the bone marrow.&lt;SEP&gt;A disease that can spread outside the bloodstream to lymph nodes, liver, spleen, and skin, and rarely to the lining of the brain and spinal cord.&lt;SEP&gt;A disease that starts in the bone marrow and is associated with impaired clotting and other blood abnormalities.&lt;SEP&gt;A type of cancer that affects blood and bone marrow; includes CML and ALL.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-035&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-037&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-069&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-075</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Acute Myeloid Leukemia (AML)">
      <data key="d0">Acute Myeloid Leukemia (AML)</data>
      <data key="d1">concept</data>
      <data key="d2">A specific type of leukemia.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-035</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="NCCN Guidelines for Patients: Adolescent and Young Adult Cancer">
      <data key="d0">NCCN Guidelines for Patients: Adolescent and Young Adult Cancer</data>
      <data key="d1">content</data>
      <data key="d2">A guideline document that provides information on fertility preservation.&lt;SEP&gt;A guideline document providing information on fertility preservation, available at NCCN.org/patientguidelines.&lt;SEP&gt;A patient guideline document from NCCN.&lt;SEP&gt;A patient guideline resource for adolescent and young adult cancer, available at NCCN.org.&lt;SEP&gt;Guidelines providing information on fertility and family planning for cancer patients, available at NCCN.org/patientguidelines and on the NCCN Patient Guides for Cancer app.&lt;SEP&gt;A guideline document that provides information on fertility preservation, available at NCCN.org/patientguidelines.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-035&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-069&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-135&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-146&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-149&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-171</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Red Blood Cell">
      <data key="d0">Red Blood Cell</data>
      <data key="d1">concept</data>
      <data key="d2">A type of blood cell that carries oxygen and requires B12 and folic acid for normal formation.&lt;SEP&gt;A type of blood cell that develops from blood stem cells. It carries oxygen throughout the body.&lt;SEP&gt;A type of blood cell that carries oxygen; may be low in CLL.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-035&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-058&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-171</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="White Blood Cell">
      <data key="d0">White Blood Cell</data>
      <data key="d1">concept</data>
      <data key="d2">A type of blood cell involved in immune response and requires B12 and folic acid for normal formation.&lt;SEP&gt;A type of blood cell that develops from blood stem cells. It helps fight infections.&lt;SEP&gt;A type of blood cell that is part of the immune system; counts are often high at diagnosis of CLL.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-035&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-058&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-171</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Peripheral Blood">
      <data key="d0">Peripheral Blood</data>
      <data key="d1">biologicalsample</data>
      <data key="d2">Blood circulating in the body, from which cells can be taken for flow cytometry.&lt;SEP&gt;Blood circulating in the body, used for flow cytometry.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-035&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Immune Response">
      <data key="d0">Immune Response</data>
      <data key="d1">concept</data>
      <data key="d2">The body's defense mechanism, in which HLA plays a role.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-035&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-069</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Immunohistochemistry">
      <data key="d0">Immunohistochemistry</data>
      <data key="d1">method</data>
      <data key="d2">A special staining process that involves adding a chemical marker to cells and studying them under a microscope to look for immunophenotype from biopsy or tissue samples.&lt;SEP&gt;A staining process to study cells under a microscope.&lt;SEP&gt;A special staining process to measure receptors such as estrogen, progesterone, and HER2 in breast cancer cells.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-070&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-104</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Biomarker">
      <data key="d0">Biomarker</data>
      <data key="d1">concept</data>
      <data key="d2">Proteins found on the surface or inside white blood cells that can be targeted in AML treatment.&lt;SEP&gt;Targetable changes of a cancer that can help guide treatment.&lt;SEP&gt;Proteins or other molecules that indicate the presence of disease or can be targeted for treatment.&lt;SEP&gt;A biological molecule found in blood or tissues that indicates the presence of cancer or genetic changes.&lt;SEP&gt;A biological feature that can be used to guide treatment decisions.&lt;SEP&gt;A molecular characteristic, such as a genetic mutation, used to identify specific types of gliomas.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-059&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-070&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-075&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-122&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-167</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="FLT">
      <data key="d0">FLT</data>
      <data key="d1">gene</data>
      <data key="d2">A gene that may be mutated in AML cells, often referred to in italics as FLT.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Leukemia Predisposition Syndromes">
      <data key="d0">Leukemia Predisposition Syndromes</data>
      <data key="d1">concept</data>
      <data key="d2">Hereditary cancer syndromes that can be passed down from parent to child and increase risk of leukemia.&lt;SEP&gt;Hereditary cancer syndromes that increase risk of leukemia.&lt;SEP&gt;Hereditary cancer syndromes that can be passed down from biological parent to child, increasing the risk of leukemia.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-070&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-071</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Karyotype">
      <data key="d0">Karyotype</data>
      <data key="d1">method</data>
      <data key="d2">A picture of chromosomes used to detect extra, missing, rearranged, or abnormal pieces; requires growing cells.&lt;SEP&gt;A picture of chromosomes used to detect extra, missing, rearranged, or abnormal pieces of chromosomes in human cells.&lt;SEP&gt;A picture of chromosomes that shows extra, missing, rearranged, or abnormal pieces; requires growing cells from bone marrow or blood.&lt;SEP&gt;A test that can show defects in chromosomes; a complex karyotype is 3 or more unrelated changes or deletions in more than one cell.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-037&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-071&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-171</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Fluorescence In Situ Hybridization (FISH)">
      <data key="d0">Fluorescence In Situ Hybridization (FISH)</data>
      <data key="d1">method</data>
      <data key="d2">A method using special dyes (probes) that attach to DNA to detect changes too small for other methods; can be used on bone marrow or blood samples.&lt;SEP&gt;A method using special dyes called probes that attach to pieces of DNA to look for small changes; can be performed on bone marrow or blood samples.&lt;SEP&gt;A lab test that can show missing parts and extra copies of chromosomes, and detect a biomarker called 17p deletion.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-071&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-171</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Next-Generation Sequencing (NGS)">
      <data key="d0">Next-Generation Sequencing (NGS)</data>
      <data key="d1">method</data>
      <data key="d2">A method to determine a portion of a person's DNA sequence and identify gene mutations.&lt;SEP&gt;A method to determine a portion of a person's DNA sequence, showing if a gene has mutations that might affect how it works.&lt;SEP&gt;A high-throughput method to determine DNA sequence or gene changes in cancer cells.&lt;SEP&gt;A technique to test for many biomarkers at once in a tumor sample.&lt;SEP&gt;A method used to determine a portion of a person's DNA sequence, showing if a gene has mutations.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-071&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-105&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-157</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Polymerase Chain Reaction (PCR)">
      <data key="d0">Polymerase Chain Reaction (PCR)</data>
      <data key="d1">method</data>
      <data key="d2">A method used in mutation testing to look for changes or abnormalities in AML cells.&lt;SEP&gt;A technique that makes millions or billions of copies of DNA or RNA, very sensitive, can find 1 abnormal cell among more than 100,000 normal cells.&lt;SEP&gt;A technique that makes millions or billions of copies of DNA or RNA, very sensitive.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-071&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-157</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Cytogenetics">
      <data key="d0">Cytogenetics</data>
      <data key="d1">method</data>
      <data key="d2">Another term for karyotype analysis, used to detect chromosomal abnormalities.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Mutation Testing">
      <data key="d0">Mutation Testing</data>
      <data key="d1">method</data>
      <data key="d2">Testing that looks for changes or abnormalities unique to AML cells, using methods like karyotype, FISH, NGS, and PCR.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="AML Genetic Changes">
      <data key="d0">AML Genetic Changes</data>
      <data key="d1">concept</data>
      <data key="d2">Changes in genes and chromosomes that can be seen under a microscope or found with tests, including deletion, insertion, inversion, amplification, translocation, and point mutation.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Deletion">
      <data key="d0">Deletion</data>
      <data key="d1">concept</data>
      <data key="d2">A type of genetic change where part of a chromosome or gene is missing, e.g., del(5q).&lt;SEP&gt;A type of genetic change where part of a chromosome or gene is missing.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-070</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Insertion">
      <data key="d0">Insertion</data>
      <data key="d1">concept</data>
      <data key="d2">A type of genetic change where a new part of a chromosome or gene is included.&lt;SEP&gt;A type of genetic change where a new part is included in a chromosome or gene.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-070</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Inversion">
      <data key="d0">Inversion</data>
      <data key="d1">concept</data>
      <data key="d2">A type of genetic change involving switching of parts within one chromosome, e.g., inv(16) and inv(3).&lt;SEP&gt;A type of genetic change involving switching of parts within one chromosome.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-070</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Amplification">
      <data key="d0">Amplification</data>
      <data key="d1">concept</data>
      <data key="d2">A type of genetic change where a part or whole chromosome or gene is increased, e.g., duplicated.&lt;SEP&gt;A type of genetic change where a part or whole chromosome or gene is increased.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-070</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Point Mutation">
      <data key="d0">Point Mutation</data>
      <data key="d1">concept</data>
      <data key="d2">A type of genetic change where part of a gene is changed.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-070</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Gene Rearrangement">
      <data key="d0">Gene Rearrangement</data>
      <data key="d1">concept</data>
      <data key="d2">Switching of parts between genes, e.g., RUNX1::RUNX1T1.&lt;SEP&gt;A type of genetic change at the gene level involving rearrangement of gene parts.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-070</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="RUNX1::RUNX1T1">
      <data key="d0">RUNX1::RUNX1T1</data>
      <data key="d1">gene</data>
      <data key="d2">A gene rearrangement resulting from translocation t(8;21).&lt;SEP&gt;A gene rearrangement associated with AML.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-070</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Hematopoietic Cell Donors">
      <data key="d0">Hematopoietic Cell Donors</data>
      <data key="d1">person</data>
      <data key="d2">Biological family members who might be tested for leukemia predisposition syndrome if they are potential donors.&lt;SEP&gt;Biological family members who might donate hematopoietic cells and may be tested for leukemia predisposition syndrome.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-071</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Biological Family Members">
      <data key="d0">Biological Family Members</data>
      <data key="d1">person</data>
      <data key="d2">Relatives who may be tested for leukemia predisposition syndrome.&lt;SEP&gt;Individuals related by blood who may be tested for leukemia predisposition syndrome if they are possible hematopoietic cell donors.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-071</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Family History Genetic Testing">
      <data key="d0">Family History Genetic Testing</data>
      <data key="d1">method</data>
      <data key="d2">Genetic testing for inherited cancer risk, different from AML biomarker testing.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Genetic Cancer Risk Testing">
      <data key="d0">Genetic Cancer Risk Testing</data>
      <data key="d1">method</data>
      <data key="d2">Testing for inherited cancer risk, different from AML biomarker testing.&lt;SEP&gt;Testing to identify inherited genetic mutations that increase cancer risk.&lt;SEP&gt;Testing for inherited genetic mutations that increase cancer risk.&lt;SEP&gt;Testing to identify inherited genetic mutations that increase the risk of developing cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-036&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-095&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-096&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-097&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-098&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-154</data>
