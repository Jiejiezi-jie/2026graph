    <node id="Pelvic Floor Exercises">
      <data key="d0">Pelvic Floor Exercises</data>
      <data key="d1">method</data>
      <data key="d2">Exercises that can help regain control of urine function after bladder cancer surgery.&lt;SEP&gt;Exercises that can help regain control of urine function and manage urinary incontinence.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-184&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-185</data>
