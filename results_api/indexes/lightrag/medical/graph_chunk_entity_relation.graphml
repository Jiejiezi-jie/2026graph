      <data key="d6" />
    </node>
    <node id="PCR">
      <data key="d0">PCR</data>
      <data key="d1">method</data>
      <data key="d2">A polymerase chain reaction technique that makes millions or billions of copies of DNA or RNA, very sensitive in finding abnormal cells.&lt;SEP&gt;Polymerase chain reaction, a lab process that makes copies of DNA.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-037&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-105</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Real-Time PCR">
      <data key="d0">Real-Time PCR</data>
      <data key="d1">method</data>
      <data key="d2">A type of PCR used to look for gene rearrangements such as PML::RARA, aiding in diagnosis and monitoring response to targeted therapies.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-037</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Brain CT Scan">
      <data key="d0">Brain CT Scan</data>
      <data key="d1">method</data>
      <data key="d2">A CT scan of the brain used to look for bleeding, using x-rays and computer technology.&lt;SEP&gt;A computed tomography scan using x-rays and computer technology to take pictures of the inside of the body, used to look for bleeding.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-037&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-071</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Brain MRI Scan">
      <data key="d0">Brain MRI Scan</data>
      <data key="d1">method</data>
      <data key="d2">An MRI scan that can show if the outer layer of the brain is swollen from leukemia, using radio waves and magnets.&lt;SEP&gt;A magnetic resonance imaging scan using radio waves and powerful magnets to take pictures of the inside of the body, can show leukemic meningitis.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-037&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-071</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Electrocardiogram">
      <data key="d0">Electrocardiogram</data>
      <data key="d1">method</data>
      <data key="d2">A test that shows electrical changes in the heart, revealing information about heart rate and rhythm.&lt;SEP&gt;A test that shows electrical changes in the heart, providing information about heart rate and rhythm.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-037&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-072</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
      <data key="d6" />
    </node>
    <node id="Echocardiogram">
      <data key="d0">Echocardiogram</data>
      <data key="d1">method</data>
      <data key="d2">An ultrasound test that uses sound waves to make pictures of the heart.&lt;SEP&gt;An ultrasound test that uses sound waves to create pictures of the heart, showing its structure and function, including ejection fraction.&lt;SEP&gt;An ultrasound test that uses sound waves to create pictures of the heart, showing its structure and function.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-037&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-038&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-072</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683036</data>
