    <node id="Axillary Lymph Nodes (ALNs)">
      <data key="d0">Axillary Lymph Nodes (ALNs)</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Lymph nodes located near the armpit that receive lymph drainage from the breast.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-098</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
