      <data key="d0">DLBCL, Not Otherwise Specified</data>
      <data key="d1">concept</data>
      <data key="d2">A type of diffuse large B-cell lymphoma that does not fit into other subtypes, diagnosed when cancer is found outside the mediastinum.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-146</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
