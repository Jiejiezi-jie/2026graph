    <node id="International Federation of Gynecology and Obstetrics (FIGO)">
      <data key="d0">International Federation of Gynecology and Obstetrics (FIGO)</data>
      <data key="d1">organization</data>
      <data key="d2">Organization that developed a staging system for ovarian cancer, used most often.&lt;SEP&gt;An international organization that developed a staging system for cervical cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-045&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-136</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Staging System">
      <data key="d0">Staging System</data>
      <data key="d1">concept</data>
      <data key="d2">A standard way of describing the extent of cancer in the body.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-045</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Estrogen">
      <data key="d0">Estrogen</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A hormone whose sudden drop after ovarian removal causes surgical menopause symptoms.&lt;SEP&gt;A hormone that plays a role in breast development and can stimulate breast cancer growth.&lt;SEP&gt;A hormone made mainly by the ovaries and other tissues; can cause breast cancer to grow.&lt;SEP&gt;A primary female sex hormone produced mainly by the ovaries.&lt;SEP&gt;A hormone whose sudden drop causes surgical menopause symptoms.&lt;SEP&gt;A hormone that, when lacking, can lead to atrophy, cardiovascular disease, and bone loss.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-045&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-104&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-111&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-112&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Cardiovascular Disease">
      <data key="d0">Cardiovascular Disease</data>
      <data key="d1">concept</data>
      <data key="d2">Heart or blood vessel problems that can result from long-term lack of estrogen.&lt;SEP&gt;A long-term risk of not having enough estrogen.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-045&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Osteoporosis">
      <data key="d0">Osteoporosis</data>
      <data key="d1">concept</data>
      <data key="d2">Bone loss that can result from long-term lack of estrogen.&lt;SEP&gt;Bone loss condition that is a long-term risk of not having enough estrogen.&lt;SEP&gt;Bone loss, a long-term risk of not having enough estrogen.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-045&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Blood Thinners">
      <data key="d0">Blood Thinners</data>
      <data key="d1">artifact</data>
      <data key="d2">Medications (oral or injections) used to prevent blood clots after surgery.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-045</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Vaginal Atrophy">
      <data key="d0">Vaginal Atrophy</data>
      <data key="d1">concept</data>
      <data key="d2">Thinning, drying, and irritation of the vaginal lining, a symptom of menopause.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-045</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Menopausal Symptom Team">
      <data key="d0">Menopausal Symptom Team</data>
      <data key="d1">organization</data>
      <data key="d2">A team of healthcare professionals that discusses whether hormone replacement therapy is appropriate for surgical menopause symptoms.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-045</data>
