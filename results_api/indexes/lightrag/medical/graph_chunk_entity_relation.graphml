    <node id="Anal Canal Cancer">
      <data key="d0">Anal Canal Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">A type of anal cancer that starts in the anal canal, with stages I-III being non-metastatic.&lt;SEP&gt;A type of cancer occurring in the anal canal, with treatment similar to perianal cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-191</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
