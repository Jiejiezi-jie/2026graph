    <node id="Tongue">
      <data key="d0">Tongue</data>
      <data key="d1">location</data>
      <data key="d2">A muscular organ in the mouth that aids in chewing, speaking, and breathing.&lt;SEP&gt;An organ in the mouth that may show symptoms of head and neck cancer.&lt;SEP&gt;Includes several muscles that extend from the hyoid bone to the floor of the mouth. The base of the tongue is part of the oropharynx.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-026&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-030&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-049</data>
