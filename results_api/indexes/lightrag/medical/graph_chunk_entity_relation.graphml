    <node id="Mismatch Repair (MMR) Proteins">
      <data key="d0">Mismatch Repair (MMR) Proteins</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Proteins that fix errors in DNA replication; defects can lead to microsatellite instability.&lt;SEP&gt;Proteins that fix errors in DNA microsatellites.&lt;SEP&gt;Proteins that fix errors in microsatellites.&lt;SEP&gt;Proteins that fix errors in DNA replication, particularly in microsatellite regions.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-030&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-054&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-105&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-157</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683017</data>
      <data key="d6" />
    </node>
    <node id="Microsatellite Instability (MSI)">
      <data key="d0">Microsatellite Instability (MSI)</data>
      <data key="d1">concept</data>
      <data key="d2">A condition where microsatellites are not properly repaired, often due to deficient mismatch repair.&lt;SEP&gt;A biomarker indicating DNA mismatch repair deficiency, tested in recurrent ovarian cancer.&lt;SEP&gt;A biomarker indicating changes in microsatellite regions of DNA, tested on tumor tissue.&lt;SEP&gt;A biomarker indicating high mutation rates due to defective DNA mismatch repair.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-030&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-043&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-044&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-143</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683017</data>
      <data key="d6" />
    </node>
    <node id="Deficient Mismatch Repair (dMMR)">
      <data key="d0">Deficient Mismatch Repair (dMMR)</data>
      <data key="d1">concept</data>
      <data key="d2">A defect in mismatch repair genes that leads to microsatellite instability.&lt;SEP&gt;A condition where DNA mutations prevent mismatch repair proteins from fixing errors, leading to microsatellite instability.&lt;SEP&gt;A defect in mismatch repair proteins that prevents fixing DNA errors, leading to microsatellite instability.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-030&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-054&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-157</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683017</data>
      <data key="d6" />
    </node>
    <node id="MSI-H">
      <data key="d0">MSI-H</data>
      <data key="d1">concept</data>
      <data key="d2">Microsatellite instability-high, a condition where cancer cells have more microsatellites than normal, often due to dMMR.&lt;SEP&gt;Microsatellite instability-high; an abnormal result indicating high levels of microsatellite instability.&lt;SEP&gt;Microsatellite instability-high, a condition where cancer cells have more than normal number of microsatellites.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-030&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-059&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-105</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683017</data>
