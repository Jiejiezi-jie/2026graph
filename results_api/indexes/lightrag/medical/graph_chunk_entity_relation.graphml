    <node id="Hematuria">
      <data key="d0">Hematuria</data>
      <data key="d1">concept</data>
      <data key="d2">The presence of blood in the urine, the most common symptom of bladder cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-174</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Urgency To Urinate">
      <data key="d0">Urgency To Urinate</data>
      <data key="d1">concept</data>
      <data key="d2">A symptom of bladder cancer characterized by a sudden, strong need to urinate.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-174</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Painful Urination">
      <data key="d0">Painful Urination</data>
      <data key="d1">concept</data>
      <data key="d2">A symptom of bladder cancer characterized by pain during urination.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-174</data>
      <data key="d4">unknown_source</data>
