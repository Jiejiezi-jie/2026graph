    <node id="BRCA">
      <data key="d0">BRCA</data>
      <data key="d1">concept</data>
      <data key="d2">A gene associated with breast cancer risk; proteins are written as BRCA, genes in italics as BRCA.&lt;SEP&gt;A gene that normally helps prevent tumor growth; mutations in BRCA1 or BRCA2 increase risk of several cancers.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-104&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-105</data>
