    <node id="CML Specialist">
      <data key="d0">CML Specialist</data>
      <data key="d1">person</data>
      <data key="d2">A medical professional with expertise in treating CML.&lt;SEP&gt;A medical professional with expertise in chronic myeloid leukemia, whose opinion may be sought for best care.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-016&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-075</data>
