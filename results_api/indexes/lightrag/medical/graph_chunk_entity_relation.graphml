    <node id="Combined Cell Lung Carcinoma">
      <data key="d0">Combined Cell Lung Carcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">A lung tumor that contains both small cell and non-small cell lung cancer cells, treated like small cell lung cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-019</data>
