    </node>
    <node id="Follicular Thyroid Cancer">
      <data key="d0">Follicular Thyroid Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">A type of thyroid cancer that can be caused by Cowden syndrome.&lt;SEP&gt;A type of thyroid cancer that can be treated with RAI therapy if it takes up iodine.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-146&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Thyroid-Stimulating Hormone (TSH) Test">
      <data key="d0">Thyroid-Stimulating Hormone (TSH) Test</data>
      <data key="d1">method</data>
      <data key="d2">A blood test that measures the level of thyroid-stimulating hormone to assess thyroid function.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Pathology Review">
      <data key="d0">Pathology Review</data>
      <data key="d1">method</data>
      <data key="d2">The process of examining biopsy samples under a microscope to determine if a nodule is cancerous and its type.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Molecular Tests">
      <data key="d0">Molecular Tests</data>
      <data key="d1">method</data>
      <data key="d2">Tests that analyze genetic or molecular markers to help determine if a nodule is cancerous and whether surgery is necessary.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Papillary Carcinoma">
      <data key="d0">Papillary Carcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">The most common type of thyroid cancer, a differentiated thyroid cancer that grows and spreads slowly.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Follicular Carcinoma">
      <data key="d0">Follicular Carcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">A type of differentiated thyroid cancer, the second most common, that grows and spreads slowly.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Oncocytic Carcinoma">
      <data key="d0">Oncocytic Carcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">A type of differentiated thyroid cancer, also known as Hürthle cell carcinoma, that grows and spreads slowly.&lt;SEP&gt;An uncommon type of thyroid cancer, formerly known as Hürthle cell carcinoma, more likely to spread to lymph nodes by the time it is found.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-151</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Medullary Thyroid Cancer">
      <data key="d0">Medullary Thyroid Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">The third most common type of thyroid cancer, which can be inherited and is the focus of a specific chapter.&lt;SEP&gt;A type of thyroid cancer that does not take up iodine and is not effectively treated with RAI therapy.&lt;SEP&gt;A type of thyroid cancer that may have RET gene fusion.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-148&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Anaplastic Thyroid Cancer">
      <data key="d0">Anaplastic Thyroid Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">The most aggressive and rare type of thyroid cancer, most often affecting older adults.&lt;SEP&gt;A rare and aggressive type of thyroid cancer that is almost always treated with radiation therapy and does not respond to RAI.&lt;SEP&gt;The least common and most aggressive type of thyroid cancer, often treated with chemotherapy in combination with radiation therapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-148&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-149</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Differentiated Thyroid Cancers">
      <data key="d0">Differentiated Thyroid Cancers</data>
      <data key="d1">concept</data>
      <data key="d2">A group of thyroid cancers including papillary, follicular, and oncocytic carcinomas that grow and spread slowly.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Lobectomy">
      <data key="d0">Lobectomy</data>
      <data key="d1">method</data>
      <data key="d2">A surgical procedure that removes the lobe of the thyroid containing the cancerous nodule and the isthmus.&lt;SEP&gt;Surgical removal of one lobe of the thyroid gland.&lt;SEP&gt;Surgical removal of one lobe of the thyroid, a treatment option for cancer that hasn't spread beyond the thyroid.&lt;SEP&gt;A surgical procedure to remove one lobe of the thyroid gland, used for certain thyroid cancers.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-150&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-151&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Total Thyroidectomy">
      <data key="d0">Total Thyroidectomy</data>
      <data key="d1">method</data>
      <data key="d2">A surgical procedure that removes the entire thyroid gland, often with nearby lymph nodes if cancer is suspected.&lt;SEP&gt;Surgical removal of the entire thyroid gland.&lt;SEP&gt;Surgical removal of the entire thyroid, recommended for suspected follicular or oncocytic tumors that have grown beyond the thyroid or are larger than 4 cm.&lt;SEP&gt;A surgical procedure to remove the entire thyroid gland, often used to treat thyroid cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-150&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-151&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Neck Dissection">
      <data key="d0">Neck Dissection</data>
      <data key="d1">method</data>
      <data key="d2">Surgical removal of lymph nodes in the neck that are known or suspected to contain cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Thyroid Hormone Replacement Therapy">
      <data key="d0">Thyroid Hormone Replacement Therapy</data>
      <data key="d1">method</data>
      <data key="d2">Treatment using medication to replace thyroid hormones after thyroid removal, often lifelong after total thyroidectomy.&lt;SEP&gt;Treatment with levothyroxine to replace thyroid hormones after thyroid surgery.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-150</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Levothyroxine">
      <data key="d0">Levothyroxine</data>
      <data key="d1">artifact</data>
      <data key="d2">A medication commonly used for thyroid hormone replacement therapy, with brand names such as Levoxyl and Synthroid.&lt;SEP&gt;A thyroid hormone replacement therapy medication, commonly used for thyroid cancer treatment, taken as a pill once a day on an empty stomach.&lt;SEP&gt;A synthetic thyroid hormone used for replacement therapy.&lt;SEP&gt;A thyroid hormone replacement therapy used to keep TSH levels low or normal after thyroid surgery.&lt;SEP&gt;A thyroid hormone replacement medication taken to keep TSH levels down after thyroid removal.&lt;SEP&gt;A medication taken to keep TSH levels down in thyroid cancer patients.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-148&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-150&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-151&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-153</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Radioactive Iodine (RAI) Uptake Test">
      <data key="d0">Radioactive Iodine (RAI) Uptake Test</data>
      <data key="d1">method</data>
      <data key="d2">A test that measures how much radioactive iodine is taken up by the thyroid, used to evaluate thyroid function.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Hypoparathyroidism">
      <data key="d0">Hypoparathyroidism</data>
      <data key="d1">concept</data>
      <data key="d2">A condition of low levels of calcium in the blood, a potential long-term side effect of thyroid removal.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Follicular Lesions">
      <data key="d0">Follicular Lesions</data>
      <data key="d1">concept</data>
      <data key="d2">Lesions in the thyroid that may be benign or malignant, where fine-needle biopsy cannot determine cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Oncocytic Tumors">
      <data key="d0">Oncocytic Tumors</data>
      <data key="d1">concept</data>
      <data key="d2">Tumors in the thyroid that may be benign or malignant, where fine-needle biopsy cannot determine cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Incision">
      <data key="d0">Incision</data>
      <data key="d1">concept</data>
      <data key="d2">A surgical cut made in the skin.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
