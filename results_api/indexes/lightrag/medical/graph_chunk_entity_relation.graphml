      <data key="d1">concept</data>
      <data key="d2">A family of genes including FLI1, ERG, ETV1, ETV4, and FEV that can fuse with EWSR1 in Ewing sarcoma.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-156</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="FLI1 gene">
