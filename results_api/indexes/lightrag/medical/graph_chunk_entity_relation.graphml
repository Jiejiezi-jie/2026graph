    </node>
    <node id="Pituitary Gland">
      <data key="d0">Pituitary Gland</data>
      <data key="d1">naturalobject</data>
      <data key="d2">An endocrine gland in the brain that can be affected by radiation therapy to the head and neck.&lt;SEP&gt;An endocrine gland in the head that can be affected by radiation therapy.&lt;SEP&gt;A gland near the base of the brain that produces thyroid-stimulating hormone.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-028&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-128&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-146</data>
