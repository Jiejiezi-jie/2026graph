    <node id="Worldwide">
      <data key="d0">Worldwide</data>
      <data key="d1">location</data>
      <data key="d2">Refers to the entire world.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-011</data>
