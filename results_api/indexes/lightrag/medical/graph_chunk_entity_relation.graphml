    <node id="Tall-Cell/Columnar Cell">
      <data key="d0">Tall-Cell/Columnar Cell</data>
      <data key="d1">disease</data>
      <data key="d2">A subtype of papillary thyroid cancer with tall or columnar cells, often more aggressive.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-150</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Hobnail">
      <data key="d0">Hobnail</data>
      <data key="d1">disease</data>
      <data key="d2">A subtype of papillary thyroid cancer with hobnail-shaped cells, often more aggressive.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-150</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Diffuse Sclerosing">
      <data key="d0">Diffuse Sclerosing</data>
      <data key="d1">disease</data>
      <data key="d2">A subtype of papillary thyroid cancer with diffuse sclerosing features, often more aggressive.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-150</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Completion Thyroidectomy">
      <data key="d0">Completion Thyroidectomy</data>
      <data key="d1">method</data>
      <data key="d2">A second surgery to remove the remaining thyroid tissue after a lobectomy.&lt;SEP&gt;A second surgery to remove the remaining thyroid tissue, recommended when pathologic examination finds concerning or high-risk features after an initial lobectomy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-150&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-151</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Noninvasive Follicular Thyroid Neoplasm With Papillary-Like Nuclear Features">
      <data key="d0">Noninvasive Follicular Thyroid Neoplasm With Papillary-Like Nuclear Features</data>
      <data key="d1">concept</data>
      <data key="d2">A low-risk, noninvasive thyroid tumor previously known as encapsulated follicular variant of papillary thyroid cancer; no further treatment is needed after surgical removal.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-151</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Follicular Thyroid Carcinoma">
      <data key="d0">Follicular Thyroid Carcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">The second most common type of thyroid cancer, known for invading blood vessels in and around the thyroid.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-151</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Fine-Needle Aspiration">
      <data key="d0">Fine-Needle Aspiration</data>
      <data key="d1">method</data>
      <data key="d2">A biopsy technique that can only suggest follicular or oncocytic cancer, not diagnose it definitively.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-151</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Radioactive Iodine Therapy">
      <data key="d0">Radioactive Iodine Therapy</data>
      <data key="d1">method</data>
      <data key="d2">A treatment using radioactive iodine to kill thyroid cancer cells left in the body after surgery.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-151</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Thyroglobulin">
      <data key="d0">Thyroglobulin</data>
      <data key="d1">data</data>
      <data key="d2">A protein level measured after surgery to help decide if RAI therapy is needed.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-151</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Pathologic Examination">
      <data key="d0">Pathologic Examination</data>
      <data key="d1">method</data>
      <data key="d2">Examination of removed tissues by a pathologist to determine the nature of the tumor and guide further treatment.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-151</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Neck Ultrasound">
      <data key="d0">Neck Ultrasound</data>
      <data key="d1">method</data>
      <data key="d2">Imaging test recommended 6 to 12 months after total thyroidectomy for follow-up.&lt;SEP&gt;Imaging technique using sound waves to visualize the neck area, used to monitor for thyroid cancer recurrence.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-151&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Whole-Body RAI Imaging">
      <data key="d0">Whole-Body RAI Imaging</data>
      <data key="d1">method</data>
      <data key="d2">Imaging test to look for remaining thyroid cancer cells after RAI therapy.&lt;SEP&gt;Imaging after radioactive iodine therapy to detect remaining cancer cells.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-151&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Hürthle Cell Carcinoma">
      <data key="d0">Hürthle Cell Carcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">Former name for oncocytic carcinoma, an uncommon type of thyroid cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-151</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Encapsulated Follicular Variant Of Papillary Thyroid Cancer">
      <data key="d0">Encapsulated Follicular Variant Of Papillary Thyroid Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Previous name for noninvasive follicular thyroid neoplasm with papillary-like nuclear features (NIFTP).</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-151</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Differentiated High-Grade Carcinoma">
      <data key="d0">Differentiated High-Grade Carcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">A type of thyroid tumor that is a factor in recommending RAI therapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-151</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="TSH">
      <data key="d0">TSH</data>
      <data key="d1">data</data>
      <data key="d2">Thyroid-stimulating hormone; its level is kept low or normal with levothyroxine therapy.&lt;SEP&gt;Thyroid-stimulating hormone, which is kept at a low level in thyroid cancer patients through levothyroxine.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-151&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-153</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Thyroglobulin (Tg)">
      <data key="d0">Thyroglobulin (Tg)</data>
      <data key="d1">data</data>
      <data key="d2">A protein produced by thyroid tissue; its level in blood is used to monitor for recurrence after total thyroidectomy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Anti-Thyroglobulin Antibodies (Tg ab)">
      <data key="d0">Anti-Thyroglobulin Antibodies (Tg ab)</data>
      <data key="d1">data</data>
      <data key="d2">Antibodies that can interfere with Tg measurement; their levels are monitored in blood tests.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Lenvatinib (Lenvima)">
      <data key="d0">Lenvatinib (Lenvima)</data>
      <data key="d1">artifact</data>
      <data key="d2">A targeted therapy drug used for advanced thyroid cancer that cannot be removed surgically and is progressing.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Sorafenib (Nexavar)">
      <data key="d0">Sorafenib (Nexavar)</data>
      <data key="d1">artifact</data>
      <data key="d2">A targeted therapy drug recommended for advanced thyroid cancer that cannot be removed surgically and is progressing.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Cabozantinib (Cabometyx)">
      <data key="d0">Cabozantinib (Cabometyx)</data>
      <data key="d1">artifact</data>
      <data key="d2">A targeted therapy drug recommended for thyroid cancer that progresses after treatment with lenvatinib or sorafenib.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="No Evidence of Disease (NED)">
      <data key="d0">No Evidence of Disease (NED)</data>
      <data key="d1">concept</data>
      <data key="d2">A state where follow-up test results are normal, indicating no detectable cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="ALK Gene Fusion">
      <data key="d0">ALK Gene Fusion</data>
      <data key="d1">data</data>
      <data key="d2">A genetic alteration in the ALK gene that can be a target for therapy in some cancers.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="BRAF Gene Mutation">
      <data key="d0">BRAF Gene Mutation</data>
      <data key="d1">data</data>
      <data key="d2">A mutation in the BRAF gene that can be a target for therapy in some cancers.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Mismatch Repair Deficiency (dMMR)">
      <data key="d0">Mismatch Repair Deficiency (dMMR)</data>
      <data key="d1">data</data>
      <data key="d2">A defect in DNA repair mechanisms that can be a biomarker for immunotherapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="TSH-Stimulated Testing">
      <data key="d0">TSH-Stimulated Testing</data>
      <data key="d1">method</data>
      <data key="d2">Testing while thyroid hormone is stopped to stimulate TSH and detect cancer recurrence.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Chapter 7: Survivorship">
      <data key="d0">Chapter 7: Survivorship</data>
      <data key="d1">content</data>
      <data key="d2">A chapter in a document providing information on survivorship care for cancer patients.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
