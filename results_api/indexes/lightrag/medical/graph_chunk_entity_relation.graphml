    <node id="Immune-Related Adverse Events (irAEs)">
      <data key="d0">Immune-Related Adverse Events (irAEs)</data>
      <data key="d1">concept</data>
      <data key="d2">Side effects of immunotherapy that are related to the immune system's activity, such as inflammation in various organs.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-010</data>
