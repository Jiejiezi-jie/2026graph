    <node id="Surgical Menopause">
      <data key="d0">Surgical Menopause</data>
      <data key="d1">concept</data>
      <data key="d2">Menopause caused by surgical removal of both ovaries, leading to a sudden drop in estrogen.&lt;SEP&gt;Menopause caused by surgical removal of the ovaries.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-045&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-140</data>
