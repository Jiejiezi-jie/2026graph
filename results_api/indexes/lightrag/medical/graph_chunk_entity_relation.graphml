    </node>
    <node id="Photodynamic Therapy">
      <data key="d0">Photodynamic Therapy</data>
      <data key="d1">method</data>
      <data key="d2">A treatment that uses a light-sensitive drug applied to the skin, which becomes active when exposed to light to kill cancer cells.&lt;SEP&gt;A treatment that uses light-sensitive drugs and light to kill cancer cells.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-007&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-011</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682867</data>
      <data key="d6" />
    </node>
    <node id="Cryotherapy">
      <data key="d0">Cryotherapy</data>
      <data key="d1">method</data>
      <data key="d2">A treatment that freezes and destroys precancerous and cancerous cells using a very cold liquid or tool, often liquid nitrogen.&lt;SEP&gt;A treatment that freezes and destroys cancer cells using very cold liquid or a tool.&lt;SEP&gt;A treatment that uses extreme cold to destroy abnormal tissue.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-007&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-008&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-011</data>
