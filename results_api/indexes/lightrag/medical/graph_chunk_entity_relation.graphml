    <node id="Next-Generation Sequencing">
      <data key="d0">Next-Generation Sequencing</data>
      <data key="d1">method</data>
      <data key="d2">A method to determine a portion of a person's DNA sequence, showing if a gene has mutations that might affect how the gene works.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-037</data>
      <data key="d4">unknown_source</data>
