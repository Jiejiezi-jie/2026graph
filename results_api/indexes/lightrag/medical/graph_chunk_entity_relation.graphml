      <data key="d0">Extra-Mediastinal Disease</data>
      <data key="d1">concept</data>
      <data key="d2">Cancer found outside the mediastinum, which indicates a diagnosis of DLBCL, not otherwise specified.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-146</data>
