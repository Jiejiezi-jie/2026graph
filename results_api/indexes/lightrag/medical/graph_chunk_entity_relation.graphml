      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="Stage II">
      <data key="d0">Stage II</data>
      <data key="d1">concept</data>
      <data key="d2">Invasive breast cancer stage.&lt;SEP&gt;A more advanced stage of cancer than stage I.&lt;SEP&gt;A stage of anal cancer that is nonmetastatic and treated with chemoradiation.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-108&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-190</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="Stage III">
      <data key="d0">Stage III</data>
      <data key="d1">concept</data>
      <data key="d2">Invasive breast cancer stage with more extensive lymph node involvement.&lt;SEP&gt;A more advanced stage of cancer than stage II.&lt;SEP&gt;A stage of anal cancer that is nonmetastatic and treated with chemoradiation.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-108&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-190</data>
