    <node id="Contrast">
      <data key="d0">Contrast</data>
      <data key="d1">artifact</data>
      <data key="d2">Substances used to enhance images in imaging tests, taken orally or intravenously, and excreted in urine.&lt;SEP&gt;A substance used in imaging tests to make pictures clearer, injected or ingested.&lt;SEP&gt;A substance used in imaging to make pictures clearer, injected or ingested, may cause allergic reactions.&lt;SEP&gt;A substance used in CT scans to make pictures clearer, injected into a vein and mixed with a liquid to drink.&lt;SEP&gt;A substance used in imaging to make pictures clearer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-003&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-059&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-060&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-123&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-134&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-147</data>
      <data key="d4">unknown_source</data>
