    </node>
    <node id="Talazoparib">
      <data key="d0">Talazoparib</data>
      <data key="d1">artifact</data>
      <data key="d2">A PARP inhibitor, also known as Talzenna, used for breast cancer with BRCA1 or BRCA2 mutations and HER2- status.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-111</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
