    </node>
    <node id="Hernia">
      <data key="d0">Hernia</data>
      <data key="d1">concept</data>
      <data key="d2">A condition where organs push through weakened tissues or muscles after surgery.&lt;SEP&gt;A potential complication of colectomy where organs push through tissues or muscles weakened by surgery.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-124&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-125</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
