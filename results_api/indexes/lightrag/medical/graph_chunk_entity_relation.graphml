      <data key="d1">organization</data>
      <data key="d2">A website providing online support for quitting smoking.&lt;SEP&gt;An online resource providing support for quitting smoking.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-012&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-030&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-051&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-129&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-135&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-136&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-178&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-179</data>
