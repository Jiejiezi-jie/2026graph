      <data key="d0">Inability to Do Everyday Activities</data>
      <data key="d1">concept</data>
      <data key="d2">Loss of ability to perform daily tasks, a possible symptom of primary CNS lymphoma.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-113</data>
