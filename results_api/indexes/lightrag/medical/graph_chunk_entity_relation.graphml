    <node id="Non-Invasive Bladder Cancer">
      <data key="d0">Non-Invasive Bladder Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Early-stage bladder cancer confined to the inner layer; usually curable.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-175</data>
