    <node id="Calcipotriene">
      <data key="d0">Calcipotriene</data>
      <data key="d1">artifact</data>
      <data key="d2">A form of vitamin D cream often used with 5-fluorouracil to treat actinic keratosis, activating the skin's immune system.&lt;SEP&gt;A vitamin D analog cream used in combination with 5-fluorouracil to treat actinic keratosis by activating the skin's immune system.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-007&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-008</data>
