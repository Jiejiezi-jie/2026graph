    <node id="Ductal Carcinoma In Situ">
      <data key="d0">Ductal Carcinoma In Situ</data>
      <data key="d1">concept</data>
      <data key="d2">A noninvasive breast cancer found in the cells lining the milk ducts, also called DCIS or intraductal carcinoma.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-097</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
