      <data key="d0">Nivolumab</data>
      <data key="d1">artifact</data>
      <data key="d2">A checkpoint inhibitor drug (Opdivo) used for dMMR/MSI-H cancers, sometimes with ipilimumab.&lt;SEP&gt;The generic name for Opdivo, a checkpoint inhibitor used for bladder cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-125&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-183</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
