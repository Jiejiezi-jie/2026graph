      <data key="d0">Pelvic Lymph Node</data>
      <data key="d1">location</data>
      <data key="d2">A lymph node in the pelvic area where prostate cancer can spread, as indicated by imaging.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-084</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683077</data>
      <data key="d6" />
    </node>
    <node id="Germline Testing">
      <data key="d0">Germline Testing</data>
      <data key="d1">method</data>
      <data key="d2">A type of genetic test that looks for inherited mutations in genes like BRCA1, BRCA2, ATM, etc., using blood, urine, or saliva samples.&lt;SEP&gt;Another name for hereditary gene testing, looking for inherited mutations.&lt;SEP&gt;Testing for inherited genetic mutations.&lt;SEP&gt;A type of genetic testing that looks for inherited mutations present in every cell of the body, recommended for certain high-risk individuals.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-084&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-092&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-093&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-178</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683077</data>
      <data key="d6" />
    </node>
    <node id="ATM">
      <data key="d0">ATM</data>
      <data key="d1">gene</data>
      <data key="d2">A gene that, when mutated, is associated with increased cancer risk.&lt;SEP&gt;A gene involved in DNA repair; mutations are linked to increased cancer risk, including prostate cancer.&lt;SEP&gt;A gene involved in DNA repair.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-084&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-085&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-092</data>
