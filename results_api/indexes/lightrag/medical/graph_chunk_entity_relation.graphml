    <node id="Alpelisib">
      <data key="d0">Alpelisib</data>
      <data key="d1">artifact</data>
      <data key="d2">A PIK3CA inhibitor, also known as Piqray, used in breast cancer treatment.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-111</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
    </node>
    <node id="CTLA-4">
      <data key="d0">CTLA-4</data>
      <data key="d1">concept</data>
      <data key="d2">An 'off switch' on immune cells that tumors take advantage of; targeted by immunotherapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-111</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
      <data key="d6" />
