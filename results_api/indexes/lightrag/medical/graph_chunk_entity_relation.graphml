    <node id="B Cells">
      <data key="d0">B Cells</data>
      <data key="d1">concept</data>
      <data key="d2">Lymphocytes that make antibodies to fight infections.&lt;SEP&gt;A type of lymphocyte that makes antibodies. B-cell ALL starts in these cells.&lt;SEP&gt;A type of white blood cell (B lymphocytes) that matures in bone marrow and works in the bloodstream; in CLL, abnormal B cells grow out of control.&lt;SEP&gt;A type of white blood cell that produces antibodies; also known as B lymphocytes.&lt;SEP&gt;A type of lymphocyte that makes antibodies to fight infections.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-057&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-065&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-168&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-171&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-172</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683063</data>
      <data key="d6" />
    </node>
    <node id="T Cells">
      <data key="d0">T Cells</data>
      <data key="d1">concept</data>
      <data key="d2">Lymphocytes that help fight infections, kill tumor cells, and control immune responses.&lt;SEP&gt;A type of lymphocyte that helps fight infections, kill tumor cells, and control immune responses. T-cell ALL starts in these cells.&lt;SEP&gt;A type of lymphocyte that helps kill tumor cells and helps control immune responses.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-057&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-065&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-172</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683063</data>
      <data key="d6" />
    </node>
    <node id="Antibodies">
      <data key="d0">Antibodies</data>
      <data key="d1">concept</data>
      <data key="d2">Proteins made by B cells that help fight infections.&lt;SEP&gt;Proteins made by B cells that help fight infection.&lt;SEP&gt;Proteins used in immunophenotyping to detect antigens.&lt;SEP&gt;Proteins made by B cells that fight infection by latching onto and destroying invading viruses or bacteria.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-057&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-065&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-070&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-172</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683063</data>
      <data key="d6" />
    </node>
    <node id="Lymph Tissue">
      <data key="d0">Lymph Tissue</data>
      <data key="d1">location</data>
      <data key="d2">Includes lymph vessels and lymph nodes, where lymphocytes are found.&lt;SEP&gt;Tissue including lymph vessels and lymph nodes where lymphocytes are found.&lt;SEP&gt;Includes lymph vessels and lymph nodes; contains lymphocytes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-057&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-065&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-076</data>
