      <data key="d1">concept</data>
      <data key="d2">A deficiency in DNA repair mechanisms; BRCA mutations are a form of HRD.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-043</data>
      <data key="d4">unknown_source</data>
