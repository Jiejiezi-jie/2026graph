    </node>
    <node id="Endoscopy Procedures">
      <data key="d0">Endoscopy Procedures</data>
      <data key="d1">method</data>
      <data key="d2">Procedures to visually examine the esophagus.&lt;SEP&gt;Procedures using an endoscope to visually examine the digestive tract.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-021&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-163</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682968</data>
