      <data key="d1">substance</data>
      <data key="d2">A radiotracer made of fluoride and glucose used in FDG-PET/CT scans to identify cancer.&lt;SEP&gt;A radiotracer used in FDG PET-CT, made of fluoride and glucose.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-053&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-103</data>
