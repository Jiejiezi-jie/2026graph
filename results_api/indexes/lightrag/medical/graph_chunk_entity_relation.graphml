    <node id="Base of Skull">
      <data key="d0">Base of Skull</data>
      <data key="d1">location</data>
      <data key="d2">The base of the skull is the bottom part of the skull; nasopharyngeal cancer can spread to this area.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-131</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Roof of Mouth">
      <data key="d0">Roof of Mouth</data>
      <data key="d1">location</data>
      <data key="d2">The roof of the mouth is the palate; nasopharyngeal cancer can spread to this area.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-131</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Parapharyngeal Space">
      <data key="d0">Parapharyngeal Space</data>
      <data key="d1">location</data>
      <data key="d2">A triangular area near the pharynx, between the base of the skull and the hyoid bone, containing fat, blood vessels, nerves, lymph nodes, and parts of the salivary gland.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-132</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Ovary">
      <data key="d0">Ovary</data>
      <data key="d1">location</data>
      <data key="d2">An organ that makes eggs and hormones, part of the female reproductive system.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-132</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Ectocervix">
      <data key="d0">Ectocervix</data>
      <data key="d1">location</data>
      <data key="d2">The outer part of the cervix that extends into the vagina, lined with squamous cells.&lt;SEP&gt;The outer part of the cervix extending into the vagina, lined with squamous cells.&lt;SEP&gt;The rounded, bottom part of the cervix.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-132&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-133&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-134</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Endocervix">
      <data key="d0">Endocervix</data>
      <data key="d1">location</data>
      <data key="d2">The inner part of the cervix forming a canal between the vagina and the uterus, lined with columnar cells.&lt;SEP&gt;The canal between the vagina and the body of the uterus, lined with glandular cells.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-132&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-133</data>
