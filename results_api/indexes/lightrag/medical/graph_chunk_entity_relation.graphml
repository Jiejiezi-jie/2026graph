    <node id="Diabetes">
      <data key="d0">Diabetes</data>
      <data key="d1">concept</data>
      <data key="d2">A chronic metabolic disease characterized by high blood sugar levels.&lt;SEP&gt;A health condition that increases the risk of pancreatic cancer.&lt;SEP&gt;A health condition that increases the risk of developing pancreatic cancer.&lt;SEP&gt;A metabolic disease characterized by high blood sugar.&lt;SEP&gt;A health condition that may run in families.&lt;SEP&gt;A condition that may increase the risk of liver cancer, often associated with NAFLD.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-003&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-077&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-078&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-090&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-105&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-160</data>
