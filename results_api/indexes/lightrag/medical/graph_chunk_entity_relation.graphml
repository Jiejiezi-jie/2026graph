      <data key="d13" />
    </edge>
    <edge source="Prostate Cancer" target="Digital Rectal Exam">
      <data key="d7">6.0</data>
      <data key="d8">The digital rectal exam is used to detect prostate abnormalities that may indicate cancer.&lt;SEP&gt;Digital rectal exam can detect signs of prostate cancer such as hardened areas.&lt;SEP&gt;Digital rectal exam is used to detect abnormalities in the prostate that may indicate cancer.&lt;SEP&gt;An abnormal digital rectal exam can be a sign of prostate cancer.&lt;SEP&gt;A digital rectal exam is a simple way to check the prostate for abnormalities that may indicate cancer.&lt;SEP&gt;The digital rectal exam is used to check the prostate for signs of cancer, such as irregular or hardened areas.</data>
      <data key="d9">check,detect,detection,detects,screening,screens for</data>
      <data key="d10">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-081&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-082&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-083&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-084&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-085&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-089</data>
