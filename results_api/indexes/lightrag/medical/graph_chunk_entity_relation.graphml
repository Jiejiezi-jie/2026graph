    </node>
    <node id="DRE">
      <data key="d0">DRE</data>
      <data key="d1">method</data>
      <data key="d2">Digital rectal examination, a recommended test after anal cancer diagnosis.&lt;SEP&gt;Digital rectal exam, used to check treatment results and for surveillance.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-194</data>
