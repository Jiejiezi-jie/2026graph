    <node id="Basal Cell Carcinoma">
      <data key="d0">Basal Cell Carcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">Another name for basal cell skin cancer, abbreviated as BCC.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-000</data>
      <data key="d4">unknown_source</data>
