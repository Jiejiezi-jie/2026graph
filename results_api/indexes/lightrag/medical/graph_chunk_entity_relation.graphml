    <node id="Testing for CBCL">
      <data key="d0">Testing for CBCL</data>
      <data key="d1">concept</data>
      <data key="d2">The process of testing for cutaneous B-cell lymphoma, including general health tests, skin exam, blood tests, imaging tests, biopsy, immunophenotyping, biomarker and genetic changes, and TNM scores.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-172</data>
