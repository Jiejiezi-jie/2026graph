      <data key="d0">Metastasis (M)</data>
      <data key="d1">concept</data>
      <data key="d2">The spread of cancer to distant sites in the body, part of TNM staging.&lt;SEP&gt;M describes whether cancer has spread to distant organs or parts of the body.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-055&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-131</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683063</data>
