      <data key="d1">concept</data>
      <data key="d2">DNA from tumor cells found in the bloodstream, detected via cell-free DNA testing.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-055</data>
