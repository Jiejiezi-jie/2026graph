      <data key="d12">1788683104</data>
      <data key="d13" />
    </edge>
    <edge source="Cervical Cancer" target="Stage 1B1 Cervical Cancer">
      <data key="d7">1.0</data>
      <data key="d8">Stage 1B1 is a stage of cervical cancer where the tumor is larger than 5 mm but smaller than 2 cm.</data>
      <data key="d9">stage classification</data>
      <data key="d10">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-136</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1788683104</data>
      <data key="d13" />
    </edge>
    <edge source="Cervical Cancer" target="Stage 1B2 Cervical Cancer">
      <data key="d7">1.0</data>
      <data key="d8">Stage 1B2 is a stage of cervical cancer where the tumor is between 2 and 4 cm and confined to the cervix.</data>
      <data key="d9">stage classification</data>
      <data key="d10">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-136</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1788683104</data>
