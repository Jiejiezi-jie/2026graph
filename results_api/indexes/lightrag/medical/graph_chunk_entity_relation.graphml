    <node id="NCCN Patient Guides for Cancer app">
      <data key="d0">NCCN Patient Guides for Cancer app</data>
      <data key="d1">artifact</data>
      <data key="d2">Mobile application offering patient guides for cancer.&lt;SEP&gt;A mobile application providing patient guides, including information on immunotherapy side effects.&lt;SEP&gt;A mobile application offering patient guides for cancer from the National Comprehensive Cancer Network.&lt;SEP&gt;An app providing patient guides for cancer.&lt;SEP&gt;A mobile application providing patient guides for cancer, including information on distress and side effects like nausea and vomiting.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-017&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-048&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-052&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-116&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137</data>
