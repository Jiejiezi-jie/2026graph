    <node id="Blood Chemistry Profile">
      <data key="d0">Blood Chemistry Profile</data>
      <data key="d1">method</data>
      <data key="d2">A blood test measuring levels of chemicals affected by organs and tissues, providing information about organ function and nutrient intake.&lt;SEP&gt;A blood test that measures levels of different chemicals in the blood to assess organ function.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-043&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-134</data>
