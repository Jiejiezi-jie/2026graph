    </node>
    <node id="High-risk CSCC">
      <data key="d0">High-risk CSCC</data>
      <data key="d1">concept</data>
      <data key="d2">A category of squamous cell skin cancer that is more likely to recur or spread, treated with surgery or radiation.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-012</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682894</data>
      <data key="d6" />
    </node>
    <node id="Very High-risk CSCC">
      <data key="d0">Very High-risk CSCC</data>
      <data key="d1">concept</data>
      <data key="d2">A category of squamous cell skin cancer with the highest risk of recurrence or spread, often treated with Mohs surgery or PDEMA.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-012</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682894</data>
      <data key="d6" />
    </node>
    <node id="Shave Excision">
      <data key="d0">Shave Excision</data>
      <data key="d1">method</data>
      <data key="d2">A surgical treatment option for low-risk, local CSCC, involving shaving off the tumor.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-012</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682894</data>
