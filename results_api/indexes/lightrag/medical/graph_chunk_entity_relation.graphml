    <node id="American Joint Committee on Cancer (AJCC)">
      <data key="d0">American Joint Committee on Cancer (AJCC)</data>
      <data key="d1">organization</data>
      <data key="d2">Organization that developed a staging system for ovarian cancer.&lt;SEP&gt;An organization that created a staging system for cancer.&lt;SEP&gt;An organization that created a staging system for cancer, including anatomic and prognostic staging.&lt;SEP&gt;An organization that developed the TNM system for staging colon cancer.&lt;SEP&gt;An organization that developed the TNM staging system for cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-045&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-055&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-106&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-125&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-187</data>
