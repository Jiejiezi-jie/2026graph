      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Estrogen Receptor (ER)">
      <data key="d0">Estrogen Receptor (ER)</data>
      <data key="d1">concept</data>
      <data key="d2">A protein found on some cancer cells that binds to estrogen, influencing growth.&lt;SEP&gt;A protein found on some breast cancer cells that binds to estrogen and can drive cancer growth.&lt;SEP&gt;A protein on cancer cells that can drive growth; its expression guides systemic treatment.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-100&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-109</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Progesterone Receptor (PR)">
      <data key="d0">Progesterone Receptor (PR)</data>
      <data key="d1">concept</data>
      <data key="d2">A protein found on some cancer cells that binds to progesterone, influencing growth.&lt;SEP&gt;A protein found on some breast cancer cells that binds to progesterone and can drive cancer growth.&lt;SEP&gt;A protein on cancer cells that can drive growth; its expression guides systemic treatment.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-100&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-109</data>
