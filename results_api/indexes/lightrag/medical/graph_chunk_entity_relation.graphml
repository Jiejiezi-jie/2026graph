      <data key="d0">Skin of the Breast</data>
      <data key="d1">location</data>
      <data key="d2">The skin covering the breast, which can be invaded by T4 tumors.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-107</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683080</data>
