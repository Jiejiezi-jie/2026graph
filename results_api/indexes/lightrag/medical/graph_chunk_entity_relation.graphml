      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Close Monitoring">
      <data key="d0">Close Monitoring</data>
      <data key="d1">method</data>
      <data key="d2">A management strategy for anal precancer involving regular observation without immediate treatment.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-188</data>
      <data key="d4">unknown_source</data>
