    <node id="Visceral Peritoneum">
      <data key="d0">Visceral Peritoneum</data>
      <data key="d1">concept</data>
      <data key="d2">Another name for the serosa, the outer membrane covering the gallbladder and bile ducts.&lt;SEP&gt;Another name for the serosa, specifically the membrane covering the abdominal organs.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-023&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-024</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682976</data>
