      <data key="d0">Ashkenazi Jewish Ancestry</data>
      <data key="d1">concept</data>
      <data key="d2">An ethnic background associated with higher risk of certain genetic mutations, including BRCA1 and BRCA2.&lt;SEP&gt;An ethnic background associated with higher risk of certain genetic mutations.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-085&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-092</data>
      <data key="d4">unknown_source</data>
