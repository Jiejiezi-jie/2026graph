      <data key="d0">Head</data>
      <data key="d1">location</data>
      <data key="d2">The upper part of the human body, where skin cancer is considered higher risk.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-011</data>
