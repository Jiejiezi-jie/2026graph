    </node>
    <node id="Guide 1">
      <data key="d0">Guide 1</data>
      <data key="d1">content</data>
      <data key="d2">A guide referenced for biomarker-based therapy options in recurrent thyroid cancer.&lt;SEP&gt;A list of tests used to plan treatment of CLL.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-170</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Oncocytic Thyroid Cancer">
      <data key="d0">Oncocytic Thyroid Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">A type of thyroid cancer that can be treated with RAI therapy if it takes up iodine.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-152</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Bone Cancer">
      <data key="d0">Bone Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">A group of cancers that start in the bone or cartilage, also known as primary bone cancer.&lt;SEP&gt;Bone cancer is a rare type of cancer that occurs in bones, with various types such as chondrosarcoma, chordoma, Ewing sarcoma, giant cell tumor of bone, and osteosarcoma.&lt;SEP&gt;A type of cancer that forms in bones, with various subtypes.&lt;SEP&gt;Cancer that originates in bone; staging uses TNM and grade.&lt;SEP&gt;Cancer that originates in the bone, staged using T, N, M, and G scores.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-153&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-154&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-157&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-158&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Primary Bone Cancer">
      <data key="d0">Primary Bone Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Cancers that start in the bone, as opposed to metastatic cancers that spread to the bone from other parts of the body.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-153</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Secondary Bone Malignancy">
      <data key="d0">Secondary Bone Malignancy</data>
      <data key="d1">concept</data>
      <data key="d2">Metastatic cancer that starts in another part of the body and travels to the bones.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-153</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Soft Tissue Sarcoma">
      <data key="d0">Soft Tissue Sarcoma</data>
      <data key="d1">concept</data>
      <data key="d2">A type of sarcoma that starts in soft tissues like fat, muscles, nerves, tendons, and blood vessels.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-153</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Bone Sarcoma">
      <data key="d0">Bone Sarcoma</data>
      <data key="d1">concept</data>
      <data key="d2">A type of sarcoma that starts in bone cells, such as osteosarcomas.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-153</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Osteosarcoma">
      <data key="d0">Osteosarcoma</data>
      <data key="d1">concept</data>
      <data key="d2">A type of bone cancer that starts in cells in areas of rapid bone growth, near growth plates.&lt;SEP&gt;The more common type of bone cancer, treated with a combination of therapies.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-153&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-154</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Ewing Sarcoma">
      <data key="d0">Ewing Sarcoma</data>
      <data key="d1">concept</data>
      <data key="d2">A type of bone cancer that starts in the bone marrow and commonly occurs in the diaphysis of long bones or flat bones.&lt;SEP&gt;A type of bone cancer that begins treatment with systemic therapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-153&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-154</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Chondrosarcoma">
      <data key="d0">Chondrosarcoma</data>
      <data key="d1">concept</data>
      <data key="d2">A type of bone cancer that starts in cells that form cartilage.&lt;SEP&gt;A type of bone cancer that is typically treated with surgery to remove the tumor.&lt;SEP&gt;A type of bone cancer that may have IDH1 mutations.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-153&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-154&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-157</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Chordoma">
      <data key="d0">Chordoma</data>
      <data key="d1">concept</data>
      <data key="d2">A type of bone cancer that starts in notochordal cells that form the spine and vertebrae.&lt;SEP&gt;A type of bone cancer that may be treated with surgery or radiation therapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-153&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-154</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Giant Cell Tumor Of Bone">
      <data key="d0">Giant Cell Tumor Of Bone</data>
      <data key="d1">concept</data>
      <data key="d2">An overgrowth of cells in the metaphysis that extends into the epiphysis of a bone.&lt;SEP&gt;A usually non-cancerous bone tumor that requires aggressive treatment to prevent bone damage.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-153&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-154</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Multiple Myeloma">
      <data key="d0">Multiple Myeloma</data>
      <data key="d1">concept</data>
      <data key="d2">A type of cancer that affects plasma cells, mentioned as a separate condition from primary bone cancers.&lt;SEP&gt;A type of blood cancer that is a risk factor for anal cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-153&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-186</data>
