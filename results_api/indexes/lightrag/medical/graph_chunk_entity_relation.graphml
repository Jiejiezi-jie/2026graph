    <node id="Chemistry Profile">
      <data key="d0">Chemistry Profile</data>
      <data key="d1">method</data>
      <data key="d2">A blood test measuring various chemicals in the blood, used in suspected ovarian cancer.&lt;SEP&gt;A group of blood tests providing information about kidney, liver, and other organ function.&lt;SEP&gt;A group of blood tests providing information about organ function, also known as comprehensive metabolic panel.&lt;SEP&gt;A blood test recommended as part of initial testing for colon cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-044&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-059&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-122&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-123</data>
