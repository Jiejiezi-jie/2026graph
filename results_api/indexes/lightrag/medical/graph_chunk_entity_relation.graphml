      <data key="d1">artifact</data>
      <data key="d2">Substance injected into cervix to identify sentinel nodes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Bowel">
      <data key="d0">Bowel</data>
      <data key="d1">location</data>
      <data key="d2">Organ near the cervix that can be affected by radiation.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
