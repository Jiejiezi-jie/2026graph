      <data key="d1">method</data>
      <data key="d2">A type of radiation used in small doses to make pictures of the inside of the body.&lt;SEP&gt;An imaging technique that uses radiation to create images of the inside of the body.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-155&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-178</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
