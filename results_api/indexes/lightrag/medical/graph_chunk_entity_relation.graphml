      <data key="d1">concept</data>
      <data key="d2">A stage of cervical cancer where the cancer has grown into the lower third of the vagina.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-136</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Stage 3B Cervical Cancer">
      <data key="d0">Stage 3B Cervical Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of cervical cancer where the cancer has grown into the pelvic wall and/or caused kidney swelling or dysfunction.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-136</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Stage 3C Cervical Cancer">
      <data key="d0">Stage 3C Cervical Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of cervical cancer where there is cancer in pelvic or para-aortic lymph nodes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-136</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Stage 4A Cervical Cancer">
      <data key="d0">Stage 4A Cervical Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of cervical cancer where the cancer has spread to nearby organs such as the bladder or rectum.&lt;SEP&gt;A stage of cervical cancer where imaging is recommended 3 to 6 months after treatment.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-136&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-143</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Stage 4B Cervical Cancer">
      <data key="d0">Stage 4B Cervical Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of cervical cancer where the cancer is metastatic, having spread to distant sites like liver, lungs, abdomen, bone, or distant lymph nodes.&lt;SEP&gt;A metastatic stage of cervical cancer where imaging is used to assess response to systemic therapy.&lt;SEP&gt;Cervical cancer that has metastasized to distant organs at the time of diagnosis.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-136&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-143&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-144</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Cancer Navigator">
      <data key="d0">Cancer Navigator</data>
      <data key="d1">person</data>
      <data key="d2">A professional who helps patients navigate cancer care, including support for distress.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-136</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Talk Therapy">
      <data key="d0">Talk Therapy</data>
      <data key="d1">method</data>
      <data key="d2">A therapeutic approach involving conversation with a professional to address emotional and psychological issues.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-136</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Medication">
      <data key="d0">Medication</data>
      <data key="d1">concept</data>
      <data key="d2">Drugs used to treat symptoms or conditions, including those for anxiety and depression.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-136</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Health Insurance">
      <data key="d0">Health Insurance</data>
      <data key="d1">concept</data>
      <data key="d2">Coverage that pays for medical expenses, which may be lacking or limited for some cancer patients.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-136</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Side effects">
      <data key="d0">Side effects</data>
      <data key="d1">concept</data>
      <data key="d2">Unwanted effects of cancer treatment, such as nausea and vomiting, which should be managed in collaboration with the care team.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Cervical cancer">
      <data key="d0">Cervical cancer</data>
      <data key="d1">disease</data>
      <data key="d2">A cancer that forms in the cervix, often diagnosed by cervical biopsy, and treated with various methods including surgery, radiation, and chemotherapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Cervical biopsy">
      <data key="d0">Cervical biopsy</data>
      <data key="d1">method</data>
      <data key="d2">A procedure to remove samples of cervical tissue for testing for dysplasia and cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Cone biopsy">
      <data key="d0">Cone biopsy</data>
      <data key="d1">method</data>
      <data key="d2">A procedure that removes a cone-shaped portion of the cervix, used for diagnosis and treatment of early cervical cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Fertility-sparing treatment">
      <data key="d0">Fertility-sparing treatment</data>
      <data key="d1">concept</data>
      <data key="d2">Treatment options that preserve fertility, possible for cancer confined to the cervix.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="FIGO system">
      <data key="d0">FIGO system</data>
      <data key="d1">method</data>
      <data key="d2">A system used to stage cervical cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="External beam radiation therapy">
      <data key="d0">External beam radiation therapy</data>
      <data key="d1">method</data>
      <data key="d2">A type of radiation therapy that delivers radiation from outside the body.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Clinical trials">
      <data key="d0">Clinical trials</data>
      <data key="d1">event</data>
      <data key="d2">Research studies that test new treatments or procedures.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Minimally invasive surgery">
      <data key="d0">Minimally invasive surgery</data>
      <data key="d1">method</data>
      <data key="d2">Surgery performed through small cuts, often laparoscopic, with less pain and scarring.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Trachelectomy">
      <data key="d0">Trachelectomy</data>
      <data key="d1">method</data>
      <data key="d2">Surgery to remove the cervix, which may be fertility-sparing, with types simple and radical.&lt;SEP&gt;Surgery that removes the cervix, a fertility-sparing surgery that may also remove the upper part of the vagina.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-140</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Extrafascial hysterectomy">
      <data key="d0">Extrafascial hysterectomy</data>
      <data key="d1">method</data>
      <data key="d2">A simple hysterectomy removing only the uterus and cervix, often used for stage IA1 cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Modified radical hysterectomy">
      <data key="d0">Modified radical hysterectomy</data>
      <data key="d1">method</data>
      <data key="d2">A hysterectomy removing the uterus, cervix, part of connective tissue, and a small portion of the vagina.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Radical hysterectomy">
      <data key="d0">Radical hysterectomy</data>
      <data key="d1">method</data>
      <data key="d2">A hysterectomy removing the uterus, cervix, much connective tissue, and top part of the vagina.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Ovary preservation">
      <data key="d0">Ovary preservation</data>
      <data key="d1">concept</data>
      <data key="d2">The option to keep ovaries during hysterectomy to avoid surgical menopause.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Surgical menopause">
      <data key="d0">Surgical menopause</data>
      <data key="d1">concept</data>
      <data key="d2">Menopause caused by surgical removal of both ovaries, leading to sudden drop in estrogen.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Vaginal atrophy">
      <data key="d0">Vaginal atrophy</data>
      <data key="d1">concept</data>
      <data key="d2">A condition where the vaginal lining becomes thin, dry, and inflamed, often due to lack of estrogen.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Lymph node dissection">
      <data key="d0">Lymph node dissection</data>
      <data key="d1">method</data>
      <data key="d2">Surgical removal of lymph nodes to check for cancer spread.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Lymph nodes">
      <data key="d0">Lymph nodes</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Bean-shaped glands throughout the body that filter lymph fluid and fight infection.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Cardiovascular disease">
      <data key="d0">Cardiovascular disease</data>
      <data key="d1">concept</data>
      <data key="d2">Disease of the heart and blood vessels; a long-term risk of estrogen deficiency.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-137</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Atrophy">
      <data key="d0">Atrophy</data>
      <data key="d1">concept</data>
      <data key="d2">A condition in which the lining of the vagina becomes thin, dry, and inflamed.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Pelvic Nodes">
      <data key="d0">Pelvic Nodes</data>
      <data key="d1">location</data>
      <data key="d2">Lymph nodes closest to the cervix, first site of cervical cancer spread.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Para-Aortic Nodes">
      <data key="d0">Para-Aortic Nodes</data>
      <data key="d1">location</data>
      <data key="d2">Lymph nodes in the abdomen that may be removed in cervical cancer staging.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Pre-Treatment Surgical Staging">
      <data key="d0">Pre-Treatment Surgical Staging</data>
      <data key="d1">method</data>
      <data key="d2">Removal and testing of lymph nodes before treatment to guide decisions for advanced cervical cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Laparoscopic Surgical Staging">
      <data key="d0">Laparoscopic Surgical Staging</data>
      <data key="d1">method</data>
      <data key="d2">Minimally invasive approach to access and remove lymph nodes for staging.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Intensity-Modulated Radiation Therapy">
      <data key="d0">Intensity-Modulated Radiation Therapy</data>
      <data key="d1">method</data>
      <data key="d2">Advanced EBRT using many small beams of different strengths to deliver high dose to tumor while sparing normal tissue.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Stereotactic Body Radiation Therapy">
      <data key="d0">Stereotactic Body Radiation Therapy</data>
      <data key="d1">method</data>
      <data key="d2">Highly specialized EBRT for metastatic cervical cancer, delivering high doses in few sessions.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Menopausal Hormone Therapy">
      <data key="d0">Menopausal Hormone Therapy</data>
      <data key="d1">method</data>
      <data key="d2">Hormone therapy to lessen side effects of radiation-induced menopause, formerly called HRT.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Simulation">
      <data key="d0">Simulation</data>
      <data key="d1">method</data>
      <data key="d2">Planning session before EBRT to determine treatment position and create a treatment plan.&lt;SEP&gt;A planning session for radiation therapy where the patient is positioned and imaging scans are taken to create a tailored radiation plan.&lt;SEP&gt;A planning session before radiation therapy to determine treatment positions and doses.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-148&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Skin Redness">
      <data key="d0">Skin Redness</data>
      <data key="d1">concept</data>
      <data key="d2">Common side effect of EBRT.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Diarrhea">
      <data key="d0">Diarrhea</data>
      <data key="d1">concept</data>
      <data key="d2">Common side effect of EBRT.&lt;SEP&gt;A short-term side effect of radiation therapy for anal cancer.&lt;SEP&gt;A common side effect of chemotherapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-190</data>
