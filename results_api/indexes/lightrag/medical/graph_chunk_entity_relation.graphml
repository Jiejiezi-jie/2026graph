    <node id="Cell-Free DNA Testing">
      <data key="d0">Cell-Free DNA Testing</data>
      <data key="d1">method</data>
      <data key="d2">A blood test that looks for circulating tumor DNA (ctDNA) to monitor treatment response and cancer recurrence, though not a standard recommended test.</data>
