      <data key="d1">naturalobject</data>
      <data key="d2">The area of a bone that widens to form a joint.&lt;SEP&gt;The end of a bone, covered with cartilage to make a joint.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-153&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-157</data>
