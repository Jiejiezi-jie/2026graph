      <data key="d13" />
    </edge>
    <edge source="Cervical Cancer" target="Transformation Zone">
      <data key="d7">2.0</data>
      <data key="d8">Most cervical cancers and pre-cancers start in the transformation zone of the ectocervix.&lt;SEP&gt;Most cervical cancers start in the transformation zone.</data>
      <data key="d9">location,origin</data>
      <data key="d10">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-133&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-134</data>
