      <data key="d0">Erythrocytes</data>
      <data key="d1">concept</data>
      <data key="d2">Another name for red blood cells.&lt;SEP&gt;Another name for red blood cells, which carry oxygen throughout the body.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-057&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-065&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-074&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-076</data>
