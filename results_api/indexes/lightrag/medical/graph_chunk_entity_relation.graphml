    <node id="Primary Care Provider">
      <data key="d0">Primary Care Provider</data>
      <data key="d1">person</data>
      <data key="d2">A healthcare professional who may first suspect lung cancer.&lt;SEP&gt;A physician who gives a wide range of care, including prevention and treatment.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-020&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-099</data>
      <data key="d4">unknown_source</data>
