      <data key="d0">Non-Mediastinal Gray Zone Lymphoma</data>
      <data key="d1">concept</data>
      <data key="d2">A type of gray zone lymphoma that occurs outside the mediastinum, often in older persons with more advanced disease.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-145</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
