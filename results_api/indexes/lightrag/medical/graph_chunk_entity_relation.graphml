      <data key="d0">Alkaline Phosphatase</data>
      <data key="d1">data</data>
      <data key="d2">An enzyme measured in blood tests; elevated levels may indicate cancer spread.&lt;SEP&gt;An enzyme made by the liver, measured in a liver function test.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-100&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-176</data>
