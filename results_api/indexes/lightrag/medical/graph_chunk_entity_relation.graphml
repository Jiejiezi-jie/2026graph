    <node id="Thyroid">
      <data key="d0">Thyroid</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A butterfly-shaped gland in the front of the neck that produces hormones essential for regulating body functions.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-146</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
