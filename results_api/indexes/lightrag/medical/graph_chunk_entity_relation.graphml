    <node id="Geneticists">
      <data key="d0">Geneticists</data>
      <data key="d1">person</data>
      <data key="d2">Doctors who study how traits are passed down from parents to children through genes and counsel people at risk.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-007</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682867</data>
      <data key="d6" />
    </node>
    <node id="Oncology Nurses">
      <data key="d0">Oncology Nurses</data>
      <data key="d1">person</data>
      <data key="d2">Nurses who provide hands-on care, such as giving systemic therapy, managing care, and helping cope with side effects.&lt;SEP&gt;Nurses who provide hands-on care to cancer patients.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-007&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-108</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682867</data>
      <data key="d6" />
    </node>
    <node id="Lymph Node Biopsy">
      <data key="d0">Lymph Node Biopsy</data>
      <data key="d1">method</data>
      <data key="d2">A procedure to test for cancer spread to lymph nodes.&lt;SEP&gt;A procedure to biopsy enlarged lymph nodes near a squamous cell skin cancer tumor to check for cancer cells.&lt;SEP&gt;A biopsy of a lymph node, possibly done if BPDCN is suspected.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-007&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-008&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-035</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682867</data>
      <data key="d6" />
    </node>
    <node id="Imaging Scans">
      <data key="d0">Imaging Scans</data>
      <data key="d1">method</data>
      <data key="d2">Scans done if cancer goes deeper into the skin or has spread to other parts of the body.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-007</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682867</data>
      <data key="d6" />
    </node>
    <node id="Liquid Nitrogen">
      <data key="d0">Liquid Nitrogen</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A very cold liquid often used in cryotherapy to freeze and destroy precancerous and cancerous cells.&lt;SEP&gt;A substance used to freeze semen in sperm banking.&lt;SEP&gt;A substance used to freeze semen and eggs for fertility preservation.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-007&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-123&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-188</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682867</data>
