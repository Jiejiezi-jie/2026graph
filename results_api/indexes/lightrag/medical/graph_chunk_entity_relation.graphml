    <node id="FDG PET-CT">
      <data key="d0">FDG PET-CT</data>
      <data key="d1">method</data>
      <data key="d2">A PET-CT scan using F-18 fluorodeoxyglucose (FDG) as a radiotracer, requiring fasting for at least 4 hours, helpful when other imaging is unclear, can find cancer in lymph nodes and distant sites.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-103</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
