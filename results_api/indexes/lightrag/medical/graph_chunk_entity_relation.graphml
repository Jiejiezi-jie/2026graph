    <node id="Nodular Lymphocyte-Predominant Hodgkin Lymphoma">
      <data key="d0">Nodular Lymphocyte-Predominant Hodgkin Lymphoma</data>
      <data key="d1">concept</data>
      <data key="d2">A rare form of Hodgkin lymphoma known for popcorn-shaped cells, usually slow-growing but can transform into aggressive cancers like DLBCL.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-023</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682976</data>
      <data key="d6" />
    </node>
    <node id="Diffuse Large B-Cell Lymphoma">
      <data key="d0">Diffuse Large B-Cell Lymphoma</data>
      <data key="d1">concept</data>
      <data key="d2">A fast-growing cancer that NLPHL can transform into.&lt;SEP&gt;An aggressive lymphoma that may be a transformation of follicular lymphoma.&lt;SEP&gt;A more aggressive cancer that can develop from Richter transformation.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-023&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-024&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-169</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682976</data>
      <data key="d6" />
    </node>
    <node id="Excisional Lymph Node Biopsy">
      <data key="d0">Excisional Lymph Node Biopsy</data>
      <data key="d1">method</data>
      <data key="d2">A procedure to remove one or more whole lymph nodes for testing to diagnose Hodgkin lymphoma.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-023</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682976</data>
      <data key="d6" />
    </node>
    <node id="Bile Duct Cancer">
      <data key="d0">Bile Duct Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Cancer that occurs in the bile ducts, with stages described in the text.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-023</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682976</data>
