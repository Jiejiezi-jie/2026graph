    <node id="Genetic Counseling">
      <data key="d0">Genetic Counseling</data>
      <data key="d1">method</data>
      <data key="d2">Guidance and testing for hereditary cancer risk.&lt;SEP&gt;A service provided by genetic counselors to help individuals decide about and interpret genetic testing for inherited cancer risk.</data>
