      <data key="d0">Cystoscopy Procedure</data>
      <data key="d1">event</data>
      <data key="d2">A medical procedure to look inside the urethra and bladder for signs of cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-176</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
