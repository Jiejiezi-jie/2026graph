    <node id="Complete Blood Count (CBC)">
      <data key="d0">Complete Blood Count (CBC)</data>
      <data key="d1">method</data>
      <data key="d2">A blood test measuring red blood cells, white blood cells, and platelets.&lt;SEP&gt;A blood test measuring white blood cells, red blood cells, and platelets.&lt;SEP&gt;A blood test that measures levels of red blood cells, white blood cells, and platelets.&lt;SEP&gt;A blood test that measures different components of blood.&lt;SEP&gt;A blood test that measures red blood cells, white blood cells, and platelets.&lt;SEP&gt;A blood test measuring levels of red blood cells, white blood cells, and platelets.&lt;SEP&gt;A blood test measuring counts of white blood cells, red blood cells, and platelets.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-043&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-059&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-068&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-100&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-101&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-134&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-143&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-155&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-170</data>
