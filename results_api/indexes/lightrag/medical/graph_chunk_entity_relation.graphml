    </node>
    <node id="Mammogram">
      <data key="d0">Mammogram</data>
      <data key="d1">method</data>
      <data key="d2">A picture of the inside of the breast made using x-rays, used for screening or diagnosis.&lt;SEP&gt;A screening test using low dose x-rays to examine the breast, available in 2D digital or 3D tomosynthesis forms.&lt;SEP&gt;An imaging test used to screen for breast cancer.&lt;SEP&gt;X-ray imaging of the breast, used to guide biopsies.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-097&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-098&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-099&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-103</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Screening Mammogram">
      <data key="d0">Screening Mammogram</data>
      <data key="d1">method</data>
      <data key="d2">A mammogram done on a regular basis when there are no signs or symptoms of breast cancer.&lt;SEP&gt;A mammogram performed regularly when there are no signs or symptoms of breast cancer.&lt;SEP&gt;A mammogram performed as a routine screening for breast cancer, different from a diagnostic mammogram.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-097&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-102&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-106</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Diagnostic Mammogram">
      <data key="d0">Diagnostic Mammogram</data>
      <data key="d1">method</data>
      <data key="d2">A mammogram used for those with symptoms or to take a closer look at an abnormal area found in a screening mammogram.&lt;SEP&gt;An X-ray of the breast used to diagnose abnormalities.&lt;SEP&gt;An imaging test that uses x-rays to examine specific areas of the breast, often for evaluating symptoms or abnormal screening results.&lt;SEP&gt;An imaging test that includes detailed pictures of both breasts, different from a screening mammogram.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-097&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-100&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-102&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-106</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Tomosynthesis">
      <data key="d0">Tomosynthesis</data>
      <data key="d1">method</data>
      <data key="d2">A 3-dimensional (3D) mammogram technique.&lt;SEP&gt;A 3D mammography technique that creates detailed images of the breast.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-097&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-102</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Lymphatic Fluid">
      <data key="d0">Lymphatic Fluid</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A clear fluid that gives cells water and food and helps fight germs, draining from breast tissue into lymph vessels.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-097</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="2D Digital Mammogram">
      <data key="d0">2D Digital Mammogram</data>
      <data key="d1">method</data>
      <data key="d2">A standard two-dimensional digital mammogram technique.&lt;SEP&gt;A standard two-dimensional mammogram using low dose x-rays to examine the breast.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-097&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-098</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="3D Mammogram">
      <data key="d0">3D Mammogram</data>
      <data key="d1">method</data>
      <data key="d2">A three-dimensional mammogram technique also known as tomosynthesis.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-097</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Estrogen Receptor Status">
      <data key="d0">Estrogen Receptor Status</data>
      <data key="d1">concept</data>
      <data key="d2">The presence or absence of estrogen receptors on cancer cells, important for treatment planning.&lt;SEP&gt;A test result indicating whether breast cancer cells have receptors for the hormone estrogen, which helps guide treatment decisions.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-097&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-098</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="3D Mammogram (Tomosynthesis)">
      <data key="d0">3D Mammogram (Tomosynthesis)</data>
      <data key="d1">method</data>
      <data key="d2">A three-dimensional mammogram that provides more detailed images of the breast.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-098</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="DCIS">
      <data key="d0">DCIS</data>
      <data key="d1">concept</data>
      <data key="d2">Ductal Carcinoma In Situ, a non-invasive breast cancer where abnormal cells are found in the lining of the breast milk ducts but have not spread outside the ducts.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-098</data>
