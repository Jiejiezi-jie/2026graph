      <data key="d13" />
    </edge>
    <edge source="Cervical Cancer" target="Autoimmune Diseases">
      <data key="d7">1.0</data>
      <data key="d8">Certain autoimmune diseases are risk factors for cervical cancer.</data>
      <data key="d9">risk factor</data>
      <data key="d10">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-133</data>
      <data key="d11">unknown_source</data>
