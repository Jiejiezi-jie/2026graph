      <data key="d0">Non-Muscle Invasive Bladder Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">A type of bladder cancer that has not invaded the muscle layer, for which biomarker tests may be used for surveillance.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-176</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Intravesical Therapy">
      <data key="d0">Intravesical Therapy</data>
      <data key="d1">method</data>
      <data key="d2">A treatment for bladder cancer where medication is delivered directly into the bladder.&lt;SEP&gt;A treatment that fills the bladder with liquid medication to destroy cancer cells.&lt;SEP&gt;A treatment often done in combination with TURBT, involving the delivery of therapeutic agents directly into the bladder.&lt;SEP&gt;A treatment that delivers medicine directly into the bladder via a catheter inserted through the urethra, used to destroy cancer cells not visible or hard to reach.&lt;SEP&gt;A treatment for bladder cancer that can cause side effects such as bladder lining inflammation, frequent urination, pain or burning when urinating, blood in urine, and infection.&lt;SEP&gt;The use of cancer medicine placed directly into the bladder through a catheter, using a process called instillation.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-176&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-180&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-181&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-182&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-184&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-185</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
