    <node id="Tumor (T)">
      <data key="d0">Tumor (T)</data>
      <data key="d1">concept</data>
      <data key="d2">The extent and size of the primary tumor, part of TNM staging.&lt;SEP&gt;T describes the size and extent of the primary tumor.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-055&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-131</data>
