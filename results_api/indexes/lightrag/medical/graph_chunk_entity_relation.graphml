      <data key="d0">Quality Of Life</data>
      <data key="d1">concept</data>
      <data key="d2">Overall satisfaction with well-being and ability to participate in regular activities.&lt;SEP&gt;Overall well-being and life satisfaction, which may be lower after cancer treatment.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-090&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-195</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Diagnostic Tests">
      <data key="d0">Diagnostic Tests</data>
      <data key="d1">method</data>
      <data key="d2">Tests used to confirm cancer, determine if it is localized or advanced, plan treatment, and detect recurrence.&lt;SEP&gt;Tests and procedures used to diagnose and monitor glioma.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-090&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-165</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="PSMA-PET">
      <data key="d0">PSMA-PET</data>
      <data key="d1">method</data>
      <data key="d2">A type of PET scan that targets prostate-specific membrane antigen (PSMA) on prostate cancer cells.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-090</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Prostate-Specific Membrane Antigen">
      <data key="d0">Prostate-Specific Membrane Antigen</data>
      <data key="d1">concept</data>
      <data key="d2">A protein found on the surface of prostate cancer cells.&lt;SEP&gt;A protein found on the surface of prostate cancer cells, often overexpressed, used as a target for imaging and therapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-090&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-091</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="PSMA-PET Scan">
      <data key="d0">PSMA-PET Scan</data>
      <data key="d1">method</data>
      <data key="d2">An imaging technique that uses tracers targeting prostate-specific membrane antigen to detect prostate cancer, especially for recurrence and metastatic cases.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-091</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Transrectal Ultrasound (TRUS)">
      <data key="d0">Transrectal Ultrasound (TRUS)</data>
      <data key="d1">method</data>
      <data key="d2">An ultrasound procedure where a probe is inserted into the rectum to visualize the prostate, often used to guide biopsies.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-091</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="MRI-TRUS Fusion">
      <data key="d0">MRI-TRUS Fusion</data>
      <data key="d1">method</data>
      <data key="d2">A technique that combines saved MRI images with real-time ultrasound to provide a detailed view for precise prostate biopsies.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-091</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
