      <data key="d1">concept</data>
      <data key="d2">Mild dysplasia, corresponding to CIN 1.&lt;SEP&gt;Mild dysplasia (CIN 1) on the cervix.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-132&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-133</data>
