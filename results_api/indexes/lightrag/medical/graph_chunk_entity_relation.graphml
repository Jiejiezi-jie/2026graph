    <node id="United States">
      <data key="d0">United States</data>
      <data key="d1">location</data>
      <data key="d2">Country where about 3 million cases of basal cell skin cancer are diagnosed every year.&lt;SEP&gt;A country in North America.&lt;SEP&gt;Country where Pap smears have resulted in lower rates of cervical cancer.&lt;SEP&gt;Country where the 9-valent HPV vaccine is available.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-000&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-011&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-132&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-133</data>
