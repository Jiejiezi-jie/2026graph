    <node id="Paraneoplastic Syndromes">
      <data key="d0">Paraneoplastic Syndromes</data>
      <data key="d1">concept</data>
      <data key="d2">Abnormal body responses to lung cancer that can cause symptoms.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-020</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682946</data>
