    <node id="Androgen">
      <data key="d0">Androgen</data>
      <data key="d1">concept</data>
      <data key="d2">A hormone made by adrenal glands, testicles, and ovaries; can be converted to estrogen.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-111</data>
