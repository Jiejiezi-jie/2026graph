      <data key="d0">Intrahepatic Bile Duct Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">A type of bile duct cancer with specific staging guidelines.&lt;SEP&gt;A type of cancer that occurs in the bile ducts within the liver, with stages defined by tumor size and spread.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-023&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-024</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682976</data>
      <data key="d6" />
    </node>
    <node id="Gallbladder">
      <data key="d0">Gallbladder</data>
      <data key="d1">artifact</data>
      <data key="d2">An organ that stores bile, with layers including epithelium, lamina propria, muscle, perimuscular fibrous tissue, and serosa.&lt;SEP&gt;A small, pear-shaped organ under the liver that stores bile.&lt;SEP&gt;An organ in the digestive system.&lt;SEP&gt;An organ that stores bile produced by the liver.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-023&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-161&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-162</data>
