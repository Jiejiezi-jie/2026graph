      <data key="d0">Cystectomy</data>
      <data key="d1">method</data>
      <data key="d2">Surgery to remove the bladder, with types including radical and partial cystectomy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-181</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Radical Cystectomy">
      <data key="d0">Radical Cystectomy</data>
      <data key="d1">method</data>
      <data key="d2">A major surgery that removes the entire bladder, nearby lymph nodes, and sometimes other organs; the most common surgery for muscle-invasive bladder cancer.&lt;SEP&gt;The most widely used surgery for muscle-invasive bladder cancer. It involves removing the bladder, nearby lymph nodes, and other organs in the pelvis.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-181&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-185</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Partial Cystectomy">
      <data key="d0">Partial Cystectomy</data>
      <data key="d1">method</data>
      <data key="d2">A surgical procedure to remove part of the bladder, rarely used for bladder cancer treatment.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-181</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Urinary Diversion">
      <data key="d0">Urinary Diversion</data>
      <data key="d1">method</data>
      <data key="d2">An additional surgical procedure to create a new way for urine to exit the body after bladder removal.&lt;SEP&gt;A surgical procedure that creates a new way for urine to leave the body after bladder removal, with types including the Indiana pouch.&lt;SEP&gt;A surgical procedure included with a radical cystectomy to provide a new way for urine to leave the body.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-181&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-182&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-185</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Neobladder">
      <data key="d0">Neobladder</data>
      <data key="d1">method</data>
      <data key="d2">A type of urinary diversion where a segment of small intestine replaces the bladder, allowing urine to exit through the urethra.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-181</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Continent Cutaneous Pouch">
      <data key="d0">Continent Cutaneous Pouch</data>
      <data key="d1">method</data>
      <data key="d2">A type of urinary diversion using a portion of the large intestine to create a pouch, with a stoma and catheter for emptying.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-181</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Urinary Incontinence">
      <data key="d0">Urinary Incontinence</data>
      <data key="d1">concept</data>
      <data key="d2">Involuntary leakage of urine, a possible side effect after neobladder surgery.&lt;SEP&gt;A side effect of bladder cancer treatment involving trouble controlling the flow of urine.&lt;SEP&gt;A condition characterized by trouble controlling the flow of urine, where urine may come out unexpectedly. It can be managed with pelvic floor exercises.&lt;SEP&gt;Inability to hold urine, a possible side effect of radiation therapy for anal cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-181&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-184&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-185&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-194</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Indiana University">
      <data key="d0">Indiana University</data>
      <data key="d1">organization</data>
      <data key="d2">The institution where surgeons developed the Indiana pouch urinary diversion.&lt;SEP&gt;The university where surgeons developed the Indiana pouch procedure.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-181&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-182</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Vas Deferens">
      <data key="d0">Vas Deferens</data>
      <data key="d1">other</data>
      <data key="d2">A tube that carries sperm away from the testicles; part of it may be removed during radical cystectomy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-181</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Abdominal Wall">
      <data key="d0">Abdominal Wall</data>
      <data key="d1">other</data>
      <data key="d2">The wall of the abdomen where a stoma is created in some urinary diversions.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-181</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Belly Button">
      <data key="d0">Belly Button</data>
      <data key="d1">other</data>
      <data key="d2">A location where a stoma can be made in continent cutaneous pouch to be less noticeable.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-181</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Bacillus Calmette-Guérin (BCG)">
      <data key="d0">Bacillus Calmette-Guérin (BCG)</data>
      <data key="d1">method</data>
      <data key="d2">A type of intravesical therapy using a weakened bacterium to trigger the immune system to attack bladder cancer cells, commonly used for high-grade non-muscle-invasive bladder cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-182</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Intravesical Chemotherapy">
      <data key="d0">Intravesical Chemotherapy</data>
      <data key="d1">method</data>
      <data key="d2">A type of intravesical therapy using chemotherapy drugs to kill cancer cells in the bladder, often given after TURBT or as an alternative to BCG.&lt;SEP&gt;A localized chemotherapy treatment that affects only the inside of the bladder.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-182&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-183</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="BCG Shortage">
      <data key="d0">BCG Shortage</data>
      <data key="d1">event</data>
      <data key="d2">A period of reduced availability of BCG treatment in the United States and worldwide, affecting patients with non-muscle-invasive bladder cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-182</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Bladder Removal Surgery">
      <data key="d0">Bladder Removal Surgery</data>
      <data key="d1">method</data>
      <data key="d2">A surgical procedure to remove the bladder, sometimes offered as an option when BCG treatment is not available or effective.&lt;SEP&gt;A treatment for bladder cancer that can cause side effects such as bleeding, blood clots, kidney problems, infection, sexual dysfunction, incontinence, and problems from urinary diversion.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-182&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-184</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Systemic Chemotherapy">
      <data key="d0">Systemic Chemotherapy</data>
      <data key="d1">method</data>
      <data key="d2">A whole-body cancer treatment that uses drugs to kill cancer cells throughout the body, often administered intravenously.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-183</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Dose-Dense Chemotherapy">
      <data key="d0">Dose-Dense Chemotherapy</data>
      <data key="d1">method</data>
      <data key="d2">A method of speeding up chemotherapy by shortening the time between treatment doses.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-183</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="ddMVAC">
      <data key="d0">ddMVAC</data>
      <data key="d1">method</data>
      <data key="d2">A combination chemotherapy regimen for bladder cancer consisting of dose-dense methotrexate, vinblastine, doxorubicin, and cisplatin.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-183</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
      <data key="d6" />
    </node>
    <node id="Checkpoint Inhibitors">
      <data key="d0">Checkpoint Inhibitors</data>
      <data key="d1">method</data>
      <data key="d2">A type of immunotherapy that blocks natural braking mechanisms to allow the immune system to fight cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-183</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683089</data>
