    <node id="Special Camera">
      <data key="d0">Special Camera</data>
      <data key="d1">artifact</data>
      <data key="d2">A device used to take pictures of tracer distribution in bones to detect areas of damage.&lt;SEP&gt;A camera used in bone scans to take pictures of the tracer in bones.&lt;SEP&gt;Camera used to see lymph nodes containing dye or substance.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-084&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-101&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
