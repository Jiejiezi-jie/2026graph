    </node>
    <node id="Microsatellite">
      <data key="d0">Microsatellite</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Short, repeated strings of DNA that can become unstable when mismatch repair is deficient.&lt;SEP&gt;Short, repeated strings of DNA.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-030&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-054&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-130</data>
