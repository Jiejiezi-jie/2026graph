    <node id="HER2 Expression">
      <data key="d0">HER2 Expression</data>
      <data key="d1">concept</data>
      <data key="d2">A biomarker involving the HER2 protein, tested in ovarian cancer.&lt;SEP&gt;A biomarker indicating the level of HER2 protein on tumor cells.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-043&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-044</data>
