    <node id="FIGO">
      <data key="d0">FIGO</data>
      <data key="d1">organization</data>
      <data key="d2">The International Federation of Gynecology and Obstetrics, which defines the staging system for ovarian cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Stage 1A">
      <data key="d0">Stage 1A</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of ovarian cancer where cancer is in one ovary, the capsule is intact, and no cancer cells are found in ascites or washings.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Stage 1B">
      <data key="d0">Stage 1B</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of ovarian cancer where cancer is in both ovaries, capsules are intact, and no cancer cells are found in ascites or washings.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Stage 1C">
      <data key="d0">Stage 1C</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of ovarian cancer where cancer is in one or both ovaries with additional features such as surgical spill, capsule rupture, or cancer cells in ascites/washings.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Stage 2A">
      <data key="d0">Stage 2A</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of ovarian cancer where cancer has spread to the uterus and/or fallopian tubes.&lt;SEP&gt;A stage of cervical cancer where the cancer has spread to the upper vagina but not to the pelvic wall.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-141</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Stage 2B">
      <data key="d0">Stage 2B</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of ovarian cancer where cancer has spread to other pelvic organs like the bladder, colon, or rectum.&lt;SEP&gt;A stage of cervical cancer where the tumor extends to the pelvic wall.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Stage 3A1">
      <data key="d0">Stage 3A1</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of ovarian cancer where cancer has spread to retroperitoneal lymph nodes, with substages based on lymph node size.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Stage 3A2">
      <data key="d0">Stage 3A2</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of ovarian cancer where cancer has spread to the abdominal lining, visible only under a microscope.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Stage 3B">
      <data key="d0">Stage 3B</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of ovarian cancer with visible cancer on the abdominal lining, smaller than 2 cm.&lt;SEP&gt;A subgroup of Stage 3 bladder cancer with the same traits as Stage 3A but has spread to multiple lymph nodes in the pelvis, not to distant nodes or organs.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-179</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Stage 3C">
      <data key="d0">Stage 3C</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of ovarian cancer with visible cancer on the abdominal lining larger than 2 cm, possibly spreading to the liver or spleen surface.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Stage 4">
      <data key="d0">Stage 4</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of ovarian cancer where cancer has spread to distant parts of the body, including malignant pleural effusion or spread to internal organs.&lt;SEP&gt;Bladder cancer that has grown through the bladder wall and may have spread to lymph nodes or organs far from the bladder. It has two subgroups: Stage 4A and Stage 4B.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-179</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Neoadjuvant Therapy">
      <data key="d0">Neoadjuvant Therapy</data>
      <data key="d1">method</data>
      <data key="d2">Chemotherapy given before surgery to shrink tumors.&lt;SEP&gt;Systemic treatment given before surgery to shrink the tumor or reduce cancer burden.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-110</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Adjuvant Chemotherapy">
      <data key="d0">Adjuvant Chemotherapy</data>
      <data key="d1">method</data>
      <data key="d2">Chemotherapy given after surgery to eliminate remaining cancer cells.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Taxane">
      <data key="d0">Taxane</data>
      <data key="d1">method</data>
      <data key="d2">A class of chemotherapy drugs including paclitaxel and docetaxel, often used with platinum-based drugs.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Oxaliplatin">
      <data key="d0">Oxaliplatin</data>
      <data key="d1">artifact</data>
      <data key="d2">A platinum-based chemotherapy drug used in cancer treatment.&lt;SEP&gt;A chemotherapy drug that can cause nerve damage (neuropathy).&lt;SEP&gt;A platinum-based chemotherapy drug used in FOLFOX regimen for metastatic anal cancer.&lt;SEP&gt;A platinum-based chemotherapy drug that can cause nerve damage to fingers and toes with extended use.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-062&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-192&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-193</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Docetaxel">
      <data key="d0">Docetaxel</data>
      <data key="d1">artifact</data>
      <data key="d2">A taxane chemotherapy drug used in cancer treatment.&lt;SEP&gt;A taxane chemotherapy drug.&lt;SEP&gt;A chemotherapy drug used in the modified DCF regimen for metastatic anal cancer.&lt;SEP&gt;A chemotherapy drug that is part of the modified DCF regimen.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-110&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-192&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-193</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Avastin">
      <data key="d0">Avastin</data>
      <data key="d1">artifact</data>
      <data key="d2">Brand name for bevacizumab.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Peripheral Neuropathy">
      <data key="d0">Peripheral Neuropathy</data>
      <data key="d1">concept</data>
      <data key="d2">A side effect of paclitaxel causing pain, tingling, and numbness in hands and feet.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Surgical Spill">
      <data key="d0">Surgical Spill</data>
      <data key="d1">event</data>
      <data key="d2">The rupture of the ovarian capsule during surgery, leading to stage 1C1 classification.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Malignant Pleural Effusion">
      <data key="d0">Malignant Pleural Effusion</data>
      <data key="d1">concept</data>
      <data key="d2">Cancer cells in the fluid around the lungs, characteristic of stage 4A ovarian cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Retroperitoneal Lymph Nodes">
      <data key="d0">Retroperitoneal Lymph Nodes</data>
      <data key="d1">location</data>
      <data key="d2">Lymph nodes in the back of the abdomen, involved in stage 3A1 ovarian cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Washings">
      <data key="d0">Washings</data>
      <data key="d1">method</data>
      <data key="d2">Fluid samples taken from the abdominal cavity during surgery to check for cancer cells.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Stage 1C1">
      <data key="d0">Stage 1C1</data>
      <data key="d1">concept</data>
      <data key="d2">A substage of stage 1C ovarian cancer where the capsule broke during surgery (surgical spill).</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Stage 1C2">
      <data key="d0">Stage 1C2</data>
      <data key="d1">concept</data>
      <data key="d2">A substage of stage 1C ovarian cancer where the capsule broke before surgery or cancer is on the outer surface of the ovary or fallopian tube.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Stage 1C3">
      <data key="d0">Stage 1C3</data>
      <data key="d1">concept</data>
      <data key="d2">A substage of stage 1C ovarian cancer where cancer cells are found in ascites or washings.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Stage 3A1 (i)">
      <data key="d0">Stage 3A1 (i)</data>
      <data key="d1">concept</data>
      <data key="d2">A substage of stage 3A1 where cancer in lymph nodes is 10 millimeters or smaller.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Stage 3A1 (ii)">
      <data key="d0">Stage 3A1 (ii)</data>
      <data key="d1">concept</data>
      <data key="d2">A substage of stage 3A1 where cancer in lymph nodes is larger than 10 millimeters.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Stage 4A">
      <data key="d0">Stage 4A</data>
      <data key="d1">concept</data>
      <data key="d2">A substage of stage 4 ovarian cancer characterized by malignant pleural effusion.&lt;SEP&gt;A stage of cervical cancer where the tumor invades the bladder or rectum or extends beyond the pelvis.&lt;SEP&gt;A subgroup of Stage 4 bladder cancer that has invaded the wall of the pelvis or abdomen, or spread to lymph nodes far from the bladder.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-179</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Stage 4B">
      <data key="d0">Stage 4B</data>
      <data key="d1">concept</data>
      <data key="d2">A substage of stage 4 ovarian cancer where cancer has spread to the inside of the liver or spleen, distant lymph nodes, or other organs outside the abdomen.&lt;SEP&gt;A subgroup of Stage 4 bladder cancer that has spread to far away lymph nodes and organs like bones, liver, or lungs, representing metastatic bladder cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-179</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="High-grade Serous Tumor">
      <data key="d0">High-grade Serous Tumor</data>
      <data key="d1">concept</data>
      <data key="d2">A type of ovarian tumor that is aggressive and typically requires six cycles of chemotherapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Low-grade Tumor">
      <data key="d0">Low-grade Tumor</data>
      <data key="d1">concept</data>
      <data key="d2">A type of ovarian tumor that is less aggressive, and observation may be an option for stage 1A or 1B.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Intraperitoneal Chemotherapy">
      <data key="d0">Intraperitoneal Chemotherapy</data>
      <data key="d1">method</data>
      <data key="d2">Chemotherapy delivered directly into the abdomen through a catheter and port, allowing higher drug doses to cancer cells in the belly.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-047</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Intravenous Chemotherapy">
      <data key="d0">Intravenous Chemotherapy</data>
      <data key="d1">method</data>
      <data key="d2">Chemotherapy delivered into the bloodstream through a vein, often via a port.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-047</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="CA-125">
      <data key="d0">CA-125</data>
      <data key="d1">data</data>
      <data key="d2">A tumor marker tested in blood before each chemotherapy cycle to monitor ovarian cancer.&lt;SEP&gt;A tumor marker that may be checked regularly after treatment if it was originally high.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-047&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-048</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Tumor Markers">
      <data key="d0">Tumor Markers</data>
      <data key="d1">concept</data>
      <data key="d2">Substances in blood that may indicate cancer, including CA-125, used for monitoring.&lt;SEP&gt;Proteins that may be tested in blood or biopsy tissue.&lt;SEP&gt;Proteins in blood or biopsy tissue that may indicate cancer growth or spread.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-047&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-104&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-105</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Myelodysplastic Syndrome">
      <data key="d0">Myelodysplastic Syndrome</data>
      <data key="d1">concept</data>
      <data key="d2">A rare but serious side effect where bone marrow does not produce enough healthy blood cells, can progress to AML.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-047</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="PARP Inhibitors">
      <data key="d0">PARP Inhibitors</data>
      <data key="d1">artifact</data>
      <data key="d2">Oral targeted therapies used for maintenance therapy, effective in HRD-positive cancers including BRCA-mutated ones.&lt;SEP&gt;Targeted therapies used against cancers with specific molecular markers.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-047&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-092</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Olaparib">
      <data key="d0">Olaparib</data>
      <data key="d1">artifact</data>
      <data key="d2">A PARP inhibitor (Lynparza) used for maintenance therapy, alone or with bevacizumab, for up to 2 years.&lt;SEP&gt;A PARP inhibitor used as maintenance therapy for ovarian cancer, can be given for up to 2 years total.&lt;SEP&gt;A PARP inhibitor, also known as Lynparza, used for breast cancer with BRCA1 or BRCA2 mutations and HER2- status.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-047&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-048&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-111</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Niraparib">
      <data key="d0">Niraparib</data>
      <data key="d1">artifact</data>
      <data key="d2">A PARP inhibitor (Zejula) used for maintenance therapy, alone for up to 3 years.&lt;SEP&gt;A PARP inhibitor used as maintenance therapy for ovarian cancer, can be given alone for up to 3 years.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-047&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-048</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Rucaparib">
      <data key="d0">Rucaparib</data>
      <data key="d1">artifact</data>
      <data key="d2">A PARP inhibitor (Rubraca) used for maintenance therapy, alone for up to 2 years.&lt;SEP&gt;A PARP inhibitor used as maintenance therapy for ovarian cancer, can be given alone for up to 2 years.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-047&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-048</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Homologous Recombination Deficiency">
      <data key="d0">Homologous Recombination Deficiency</data>
      <data key="d1">concept</data>
      <data key="d2">A condition in cancer cells that makes them sensitive to PARP inhibitors, often associated with BRCA mutations.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-047</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Pelvic and Rectovaginal Exam">
      <data key="d0">Pelvic and Rectovaginal Exam</data>
      <data key="d1">method</data>
      <data key="d2">A gynecological exam that may be done during monitoring to assess ovarian cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-047</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Nausea and Vomiting">
      <data key="d0">Nausea and Vomiting</data>
      <data key="d1">concept</data>
      <data key="d2">Common side effects of chemotherapy and PARP inhibitors, which can be managed with options from the care team.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-047</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Fatigue">
      <data key="d0">Fatigue</data>
      <data key="d1">concept</data>
      <data key="d2">A common side effect of chemotherapy and PARP inhibitors.&lt;SEP&gt;Common side effect of EBRT.&lt;SEP&gt;A common and debilitating symptom of glioma, not related to sleep or activity.&lt;SEP&gt;A symptom that is more than just being tired, can be physical, cognitive, or emotional, and can be caused by external or internal sources.&lt;SEP&gt;A short-term side effect of radiation therapy for anal cancer.&lt;SEP&gt;A common general effect after cancer treatment, characterized by tiredness.&lt;SEP&gt;A common symptom experienced by cancer survivors.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-047&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-165&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-166&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-195&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-196</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
      <data key="d6" />
    </node>
    <node id="Hair Loss">
      <data key="d0">Hair Loss</data>
      <data key="d1">concept</data>
      <data key="d2">A common side effect of chemotherapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-047</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
