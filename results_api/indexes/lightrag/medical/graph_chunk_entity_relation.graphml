      <data key="d5">1788682996</data>
      <data key="d6" />
    </node>
    <node id="Intrauterine Devices (IUDs)">
      <data key="d0">Intrauterine Devices (IUDs)</data>
      <data key="d1">artifact</data>
      <data key="d2">Long-acting reversible contraceptive devices inserted into the uterus.&lt;SEP&gt;Small, T-shaped devices inserted into the uterus to prevent pregnancy.&lt;SEP&gt;A type of birth control that may be an option.&lt;SEP&gt;Long-acting reversible contraceptive devices inserted into the uterus, which may be an option during treatment.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-028&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-052&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-128&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-154</data>
