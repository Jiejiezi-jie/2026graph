    <node id="Primary Liver Cancer">
      <data key="d0">Primary Liver Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Cancer that originates in the liver.&lt;SEP&gt;Cancer that starts in the liver. There are several types, with HCC being the most common.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-160</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Secondary Liver Cancer">
      <data key="d0">Secondary Liver Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Cancer that spreads to the liver from another part of the body.&lt;SEP&gt;Cancer that spreads to the liver from other parts of the body.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-160</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Hepatocellular Carcinoma (HCC)">
      <data key="d0">Hepatocellular Carcinoma (HCC)</data>
      <data key="d1">concept</data>
      <data key="d2">The most common type of primary liver cancer in adults.&lt;SEP&gt;The most common type of primary liver cancer in adults, and the focus of the patient guideline.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-160</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Fibrolamellar Hepatocellular Carcinoma (FLHC)">
      <data key="d0">Fibrolamellar Hepatocellular Carcinoma (FLHC)</data>
      <data key="d1">concept</data>
      <data key="d2">A subtype of HCC that affects few people and usually occurs at a younger age.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Intrahepatic Cholangiocarcinoma">
      <data key="d0">Intrahepatic Cholangiocarcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">A cancer of the bile ducts, the second most common primary liver cancer in adults.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Mixed-Type Tumor">
      <data key="d0">Mixed-Type Tumor</data>
      <data key="d1">concept</data>
      <data key="d2">A rare liver tumor made of both hepatocellular carcinoma and cholangiocarcinoma.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Metastatic Liver Cancer">
      <data key="d0">Metastatic Liver Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Liver cancer that has spread to distant sites, often the lung or bone.&lt;SEP&gt;Liver cancer that has spread to distant sites, most often the lung or bone.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-160</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Spinal Column">
      <data key="d0">Spinal Column</data>
      <data key="d1">location</data>
      <data key="d2">The spine, which is supported by the pelvis.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Abdominal Organs">
      <data key="d0">Abdominal Organs</data>
      <data key="d1">location</data>
      <data key="d2">Organs in the abdomen, which are protected by the pelvis.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Liver Lobes">
      <data key="d0">Liver Lobes</data>
      <data key="d1">location</data>
      <data key="d2">The two lobes (right and left) of the liver.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Hepatic Ducts">
      <data key="d0">Hepatic Ducts</data>
      <data key="d1">location</data>
      <data key="d2">Ducts that carry bile from the liver, including left and right hepatic ducts and common hepatic duct.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Cystic Duct">
      <data key="d0">Cystic Duct</data>
      <data key="d1">location</data>
      <data key="d2">A duct that connects the gallbladder to the common hepatic duct.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Common Bile Duct">
      <data key="d0">Common Bile Duct</data>
      <data key="d1">location</data>
      <data key="d2">A duct formed by the junction of the common hepatic duct and cystic duct, leading to the small intestine.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Pancreatic Duct">
      <data key="d0">Pancreatic Duct</data>
      <data key="d1">location</data>
      <data key="d2">A duct that joins the common bile duct before entering the small intestine.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Duodenum">
      <data key="d0">Duodenum</data>
      <data key="d1">location</data>
      <data key="d2">The first part of the small intestine, near the gallbladder.&lt;SEP&gt;The first part of the small intestine, receiving chyme from the stomach.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-162</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Hepatic Vein">
      <data key="d0">Hepatic Vein</data>
      <data key="d1">location</data>
      <data key="d2">A vein that carries blood from the liver to the inferior vena cava.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Metastatic Colon Cancer">
      <data key="d0">Metastatic Colon Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Colon cancer that has spread to the liver.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Cirrhosis">
      <data key="d0">Cirrhosis</data>
      <data key="d1">concept</data>
      <data key="d2">Scarring of the liver, a type of chronic liver disease where liver cells are replaced by scar tissue. It is a risk factor for liver cancer and an indication for screening.&lt;SEP&gt;A condition that increases the risk of developing liver cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-160&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-161</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Hepatitis B Virus (HBV)">
      <data key="d0">Hepatitis B Virus (HBV)</data>
      <data key="d1">creature</data>
      <data key="d2">A virus that causes hepatitis B, which can lead to chronic hepatitis, cirrhosis, liver failure, and liver cancer. It is spread through contact with blood and bodily fluids.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-160</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Hepatitis C Virus (HCV)">
      <data key="d0">Hepatitis C Virus (HCV)</data>
      <data key="d1">creature</data>
      <data key="d2">A virus that causes hepatitis C, which can lead to chronic hepatitis, cirrhosis, liver failure, and liver cancer. It is spread through contact with blood and bodily fluids.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-160</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Non-Alcoholic Fatty Liver Disease (NAFLD)">
      <data key="d0">Non-Alcoholic Fatty Liver Disease (NAFLD)</data>
      <data key="d1">concept</data>
      <data key="d2">A condition characterized by fat accumulation in the liver not due to alcohol, often associated with obesity, diabetes, and high cholesterol. It can lead to cirrhosis and liver cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-160</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Genetic Hemochromatosis">
      <data key="d0">Genetic Hemochromatosis</data>
      <data key="d1">concept</data>
      <data key="d2">An inherited condition causing the liver to store too much iron from food, which is a risk factor for liver cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-160</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Stage 4 Primary Biliary Cholangitis">
      <data key="d0">Stage 4 Primary Biliary Cholangitis</data>
      <data key="d1">concept</data>
      <data key="d2">A late stage of primary biliary cholangitis, a chronic liver disease, which is a risk factor for liver cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-160</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Alpha-1-Antitrypsin Deficiency">
      <data key="d0">Alpha-1-Antitrypsin Deficiency</data>
      <data key="d1">concept</data>
      <data key="d2">A genetic condition that can cause liver disease and is a risk factor for liver cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-160</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Liver Cancer Screening">
      <data key="d0">Liver Cancer Screening</data>
      <data key="d1">method</data>
      <data key="d2">Regular testing to detect liver cancer early in at-risk individuals, using ultrasound and alpha-fetoprotein (AFP) tests every 6 months.&lt;SEP&gt;Regular tests to detect liver cancer early in people without symptoms who are at risk.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-160&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-161</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Alpha-Fetoprotein (AFP) Test">
      <data key="d0">Alpha-Fetoprotein (AFP) Test</data>
      <data key="d1">method</data>
      <data key="d2">A blood test that measures the level of alpha-fetoprotein, a protein that may be elevated in liver cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-160</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Nodules">
      <data key="d0">Nodules</data>
      <data key="d1">concept</data>
      <data key="d2">Small, round areas of tissue in the liver that may be detected by ultrasound; not all are cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-160</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Hepatitis">
      <data key="d0">Hepatitis</data>
      <data key="d1">concept</data>
      <data key="d2">A type of liver disease caused by viruses such as HBV and HCV, which can lead to chronic hepatitis, cirrhosis, liver failure, and liver cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-160</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="High Weight">
      <data key="d0">High Weight</data>
      <data key="d1">concept</data>
      <data key="d2">Obesity or being overweight, which is a risk factor for NAFLD and liver cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-160</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Fats">
      <data key="d0">Fats</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Nutrients that the liver breaks down.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-160</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Hepatocellular Carcinoma">
      <data key="d0">Hepatocellular Carcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">A type of liver cancer that is the focus of the book.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-161</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Chronic Hepatitis B">
      <data key="d0">Chronic Hepatitis B</data>
      <data key="d1">concept</data>
      <data key="d2">A condition that increases the risk of developing liver cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-161</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Chyme">
      <data key="d0">Chyme</data>
      <data key="d1">concept</data>
      <data key="d2">The liquid form of food after digestion in the stomach.&lt;SEP&gt;The semi-fluid mass of partly digested food passed from the stomach to the small intestine.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-161&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-162</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Cardia">
      <data key="d0">Cardia</data>
      <data key="d1">artifact</data>
      <data key="d2">The opening where the esophagus connects to the stomach.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-162</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Fundus">
      <data key="d0">Fundus</data>
      <data key="d1">artifact</data>
      <data key="d2">The upper part of the stomach that bulges above the esophageal opening, storing undigested food and gases.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-162</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Body">
      <data key="d0">Body</data>
      <data key="d1">artifact</data>
      <data key="d2">The main part of the stomach.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-162</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Antrum">
      <data key="d0">Antrum</data>
      <data key="d1">artifact</data>
      <data key="d2">The lower portion of the stomach where food mixes with enzymes and acid.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-162</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Pylorus">
      <data key="d0">Pylorus</data>
      <data key="d1">artifact</data>
      <data key="d2">A valve connecting the stomach to the duodenum, regulating passage of chyme.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-162</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Esophagogastric Junction (EGJ)">
      <data key="d0">Esophagogastric Junction (EGJ)</data>
      <data key="d1">artifact</data>
      <data key="d2">The junction where the esophagus joins the stomach, also known as gastroesophageal junction (GEJ).</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-162</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Muscle Layer">
      <data key="d0">Muscle Layer</data>
      <data key="d1">location</data>
      <data key="d2">A layer of soft tissue that helps move food through the stomach, also called muscularis propria.&lt;SEP&gt;A layer of the stomach wall, part of the five main layers.&lt;SEP&gt;The layer of the bladder wall that muscle-invasive cancer has invaded.&lt;SEP&gt;The layer of the bladder wall that cancer must invade to be considered muscle-invasive.&lt;SEP&gt;The muscular layer of the bladder wall; invasion into this layer determines treatment aggressiveness.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-162&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-163&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-174&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-179&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-180</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Subserosa">
      <data key="d0">Subserosa</data>
      <data key="d1">artifact</data>
      <data key="d2">A layer of connective tissue supporting the serosa.&lt;SEP&gt;A layer of the stomach wall, part of the five main layers.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-162&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-163</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Intestinal Type">
      <data key="d0">Intestinal Type</data>
      <data key="d1">concept</data>
      <data key="d2">A type of stomach adenocarcinoma where cells stick together and form tube- and gland-shaped structures; more likely to have targetable mutations.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-162</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Diffuse Type">
      <data key="d0">Diffuse Type</data>
      <data key="d1">concept</data>
      <data key="d2">A type of stomach adenocarcinoma where cells do not stick together and appear scattered; less common.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-162</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Enzymes">
      <data key="d0">Enzymes</data>
      <data key="d1">concept</data>
      <data key="d2">Proteins that speed up chemical reactions, such as breaking down food in the stomach.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-162</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Acid">
      <data key="d0">Acid</data>
      <data key="d1">concept</data>
      <data key="d2">Hydrochloric acid in the stomach that helps break down food.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-162</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Nerve Cells">
      <data key="d0">Nerve Cells</data>
      <data key="d1">artifact</data>
      <data key="d2">Cells that transmit nerve impulses, found in the submucosa.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-162</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Surface Epithelium">
      <data key="d0">Surface Epithelium</data>
      <data key="d1">artifact</data>
      <data key="d2">The thin, moist layer of cells forming the interior stomach lining; it produces mucus.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-162</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Muscularis Mucosae">
      <data key="d0">Muscularis Mucosae</data>
      <data key="d1">artifact</data>
      <data key="d2">A thin strip of muscle that separates the mucosa from the submucosa.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-162</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Stomach Glands">
      <data key="d0">Stomach Glands</data>
      <data key="d1">artifact</data>
      <data key="d2">Glands in the lamina propria that produce enzymes, acid, mucus, and hormones.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-162</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Early-Stage Stomach Cancer">
      <data key="d0">Early-Stage Stomach Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of stomach cancer where the tumor has not grown beyond the mucosa layer of the stomach wall and is not in any lymph nodes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-163</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Locoregional Stomach Cancer">
      <data key="d0">Locoregional Stomach Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of stomach cancer where the cancer has invaded deeper layers of the stomach wall and may have spread to nearby lymph nodes or organs.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-163</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Metastatic Stomach Cancer">
      <data key="d0">Metastatic Stomach Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">A stage of stomach cancer where the cancer has spread to distant parts of the body, such as the liver, peritoneum, or distant lymph nodes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-163</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Stomach Wall">
      <data key="d0">Stomach Wall</data>
      <data key="d1">concept</data>
      <data key="d2">The anatomical structure of the stomach composed of five layers: mucosa, submucosa, muscle, subserosa, and serosa.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-163</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="H. pylori">
      <data key="d0">H. pylori</data>
      <data key="d1">creature</data>
      <data key="d2">A type of bacteria that can infect the stomach and is a risk factor for stomach cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-163</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Testing for Stomach Cancer">
      <data key="d0">Testing for Stomach Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">The process of diagnosing and staging stomach cancer through various tests and procedures.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-163</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Glioma">
      <data key="d0">Glioma</data>
      <data key="d1">concept</data>
      <data key="d2">A type of brain tumor that arises from glial cells.&lt;SEP&gt;A type of tumor that grows in the brain, developing from glial cells. It is the most common malignant brain tumor in adults and can be challenging to treat.&lt;SEP&gt;A type of tumor that develops from glial cells in the brain or spinal cord. It can disrupt brain function and is often difficult to treat because it invades normal brain tissue.&lt;SEP&gt;A type of brain tumor that can cause vision problems, sensory disturbances, and is linked to blood clots in the legs and lungs. It is identified using imaging tests like MRI.&lt;SEP&gt;A type of tumor that starts in the glial cells of the brain or central nervous system, classified by histology, grade, and biomarkers.&lt;SEP&gt;A type of tumor that arises from glial cells in the brain or spine, graded from 1 to 4 based on aggressiveness.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-163&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-164&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-165&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-166&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-167&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-168</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Brain Tumor">
      <data key="d0">Brain Tumor</data>
      <data key="d1">concept</data>
      <data key="d2">An abnormal growth of cells in the brain, which can be benign or malignant.&lt;SEP&gt;An abnormal growth of cells in the brain. Gliomas are a type of brain tumor.&lt;SEP&gt;An abnormal growth of cells in the brain that can cause various symptoms such as nausea, vomiting, thinking and speech problems, weakness, personality changes, and vision problems.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-163&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-164&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-166</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Peritoneum">
      <data key="d0">Peritoneum</data>
      <data key="d1">concept</data>
      <data key="d2">The abdominal lining, a common site for metastasis in stomach cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-163</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Glial Cells">
      <data key="d0">Glial Cells</data>
      <data key="d1">concept</data>
      <data key="d2">Brain cells that support the function of nerve cells in the central nervous system. Gliomas develop from these cells.&lt;SEP&gt;Support cells in the brain and spinal cord from which gliomas develop.&lt;SEP&gt;Supporting cells in the central nervous system from which gliomas originate.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-164&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-165&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-167</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Astrocytomas">
      <data key="d0">Astrocytomas</data>
      <data key="d1">concept</data>
      <data key="d2">A type of glioma that looks like star-shaped glial cells called astrocytes. They are one of the three most common types of gliomas.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-164</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Oligodendrogliomas">
      <data key="d0">Oligodendrogliomas</data>
      <data key="d1">concept</data>
      <data key="d2">A type of glioma that looks like oligodendrocytes, which protect electrical signaling in nerve cells. One of the three most common types.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-164</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Glioblastomas">
      <data key="d0">Glioblastomas</data>
      <data key="d1">concept</data>
      <data key="d2">The most destructive and dangerous type of glioma tumor, arising from precursor cells that develop into cells like astrocytes and oligodendrocytes.&lt;SEP&gt;The most common type of grade 4 gliomas, characterized by rapid growth and spread.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-164&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-168</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Astrocytes">
      <data key="d0">Astrocytes</data>
      <data key="d1">concept</data>
      <data key="d2">Star-shaped glial cells that maintain the chemical environment for communication between nerve cells.&lt;SEP&gt;Glial cells in the brain that astrocytomas resemble.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-164&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-167</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Oligodendrocytes">
      <data key="d0">Oligodendrocytes</data>
      <data key="d1">concept</data>
      <data key="d2">Glial cells that protect electrical signaling in nerve cells.&lt;SEP&gt;Glial cells in the brain that oligodendrogliomas resemble.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-164&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-167</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Adults">
      <data key="d0">Adults</data>
      <data key="d1">other</data>
      <data key="d2">Individuals aged 18 and older. Gliomas occur more often in adults than in children, and the book discusses gliomas only in adults.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-164</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Astrocytoma">
      <data key="d0">Astrocytoma</data>
      <data key="d1">concept</data>
      <data key="d2">A common type of glioma tumor.&lt;SEP&gt;A type of glioma that resembles astrocytes, often characterized by IDH mutations.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-165&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-167</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Oligodendroglioma">
      <data key="d0">Oligodendroglioma</data>
      <data key="d1">concept</data>
      <data key="d2">A common type of glioma tumor.&lt;SEP&gt;A type of glioma that resembles oligodendrocytes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-165&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-167</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Glioblastoma">
      <data key="d0">Glioblastoma</data>
      <data key="d1">concept</data>
      <data key="d2">A common and aggressive type of glioma tumor.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-165</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Headache">
      <data key="d0">Headache</data>
      <data key="d1">symptom</data>
      <data key="d2">A common symptom of glioma, often worse in the morning and may occur with nausea.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-165</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Seizure">
      <data key="d0">Seizure</data>
      <data key="d1">symptom</data>
      <data key="d2">A frequent symptom in people with brain tumors, often an early sign of glioma.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-165</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Nausea And Vomiting">
      <data key="d0">Nausea And Vomiting</data>
      <data key="d1">symptom</data>
      <data key="d2">Symptoms caused by increased pressure on the brain from the tumor.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-165</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Thinking And Speech Problems">
      <data key="d0">Thinking And Speech Problems</data>
      <data key="d1">symptom</data>
      <data key="d2">Includes confusion, memory loss, and speech difficulties.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-165</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Weakness Or Movement Problems">
      <data key="d0">Weakness Or Movement Problems</data>
      <data key="d1">symptom</data>
      <data key="d2">Muscle weakness on one side of the body or difficulty with walking or balance.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-165</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Personality Or Mood Changes">
      <data key="d0">Personality Or Mood Changes</data>
      <data key="d1">symptom</data>
      <data key="d2">Changes in behavior or mood due to brain tumor.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-165</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Low-Grade Glioma">
      <data key="d0">Low-Grade Glioma</data>
      <data key="d1">concept</data>
      <data key="d2">A slow-growing glioma that may not cause symptoms for years.&lt;SEP&gt;Gliomas with grades 1 and 2, which grow slowly.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-165&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-167</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="High-Grade Glioma">
      <data key="d0">High-Grade Glioma</data>
      <data key="d1">concept</data>
      <data key="d2">A fast-growing glioma that can cause symptoms within weeks or months.&lt;SEP&gt;Gliomas with grades 3 and 4, which grow more quickly and are more aggressive.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-165&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-167</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Caregivers">
      <data key="d0">Caregivers</data>
      <data key="d1">person</data>
      <data key="d2">Individuals who provide physical, mental, and emotional support to patients.&lt;SEP&gt;Individuals who provide care and support to patients, and are encouraged to ask questions.&lt;SEP&gt;Individuals who provide care and support to cancer patients.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-165&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-173&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-195</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Patients">
      <data key="d0">Patients</data>
      <data key="d1">person</data>
      <data key="d2">Individuals diagnosed with glioma who receive treatment and care.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-165</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Blood Clots">
      <data key="d0">Blood Clots</data>
      <data key="d1">concept</data>
      <data key="d2">A condition linked to high-grade gliomas, occurring in the legs and lungs, causing leg swelling, chest pain, and shortness of breath.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-166</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Parietal Lobe">
      <data key="d0">Parietal Lobe</data>
      <data key="d1">location</data>
      <data key="d2">A region of the brain responsible for intelligence, language, reading, sensation, and sensory perception.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-166</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Occipital Lobe">
      <data key="d0">Occipital Lobe</data>
      <data key="d1">location</data>
      <data key="d2">A region of the brain responsible for vision and color perception.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-166</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Neuropathologist">
      <data key="d0">Neuropathologist</data>
      <data key="d1">person</data>
      <data key="d2">A specialist who examines tissue samples under a microscope to determine if a tumor is malignant or benign, and performs molecular testing to identify tumor type and grade.&lt;SEP&gt;A specialist who tests tissue samples for biomarkers to provide details about gliomas.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-167&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-168</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="IDH Gene">
      <data key="d0">IDH Gene</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A gene that can have mutations in certain gliomas, such as astrocytomas, serving as a biomarker.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-167</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="CT Imaging">
      <data key="d0">CT Imaging</data>
      <data key="d1">artifact</data>
      <data key="d2">Computed tomography imaging, used in conjunction with a computerized navigation system to guide biopsies.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-167</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Craniotomy">
      <data key="d0">Craniotomy</data>
      <data key="d1">method</data>
      <data key="d2">A surgical opening in the skull to access the brain, used in open biopsies and resections.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-167</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="IDH-Mutant">
      <data key="d0">IDH-Mutant</data>
      <data key="d1">concept</data>
      <data key="d2">A biomarker indicating a mutation in the IDH gene, used in classifying astrocytomas.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-167</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Grade 1 Gliomas">
      <data key="d0">Grade 1 Gliomas</data>
      <data key="d1">concept</data>
      <data key="d2">Slow-growing, usually benign tumors that can often be treated with surgery alone, more common in children than adults.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-168</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Grade 2 Gliomas">
      <data key="d0">Grade 2 Gliomas</data>
      <data key="d1">concept</data>
      <data key="d2">Tumors with somewhat abnormal cells that grow slowly, can invade normal tissue, and may recur as higher-grade gliomas.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-168</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Grade 3 Gliomas">
      <data key="d0">Grade 3 Gliomas</data>
      <data key="d1">concept</data>
      <data key="d2">High-grade tumors with cells that don't look like normal cells, grow quickly, invade nearby tissue, and require additional therapy after surgery.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-168</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Grade 4 Gliomas">
      <data key="d0">Grade 4 Gliomas</data>
      <data key="d1">concept</data>
      <data key="d2">High-grade tumors with very abnormal cells that grow and spread very quickly, including glioblastomas.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-168</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Chronic Lymphocytic Leukemia (CLL)">
      <data key="d0">Chronic Lymphocytic Leukemia (CLL)</data>
      <data key="d1">concept</data>
      <data key="d2">A type of blood cancer that grows slowly, occurring in lymphocytes, and may not require treatment for years.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-168</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Lymph System">
      <data key="d0">Lymph System</data>
      <data key="d1">concept</data>
      <data key="d2">The lymphatic system, which contains many B cells and plays a key role in fighting infections.&lt;SEP&gt;A system that plays a key role in fighting infections, including tonsils, thymus, spleen, lymph vessels, and lymph nodes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-168&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-169</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Cancer Care">
      <data key="d0">Cancer Care</data>
      <data key="d1">concept</data>
      <data key="d2">The overall management and treatment of cancer, including diagnosis, therapy, and supportive care.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-168</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Small Lymphocytic Lymphoma">
      <data key="d0">Small Lymphocytic Lymphoma</data>
      <data key="d1">concept</data>
      <data key="d2">The same cancer as CLL but primarily found in lymph nodes and spleen. It is considered SLL when fewer than 5,000 cancerous cells are in the blood.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-169</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Richter Transformation">
      <data key="d0">Richter Transformation</data>
      <data key="d1">concept</data>
      <data key="d2">A rare complication of CLL that can lead to more aggressive cancers like diffuse large B-cell lymphoma or Hodgkin lymphoma.&lt;SEP&gt;A condition where CLL transforms into an aggressive lymphoma.&lt;SEP&gt;A condition described in Chapter 5 of the book, which patients are advised to read if diagnosed with it.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-169&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-171&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-172</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Minimal Residual Disease">
      <data key="d0">Minimal Residual Disease</data>
      <data key="d1">concept</data>
      <data key="d2">A condition where treatment results in mostly healthy blood cells, though not a cure.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-169</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="Blood Smear">
      <data key="d0">Blood Smear</data>
      <data key="d1">method</data>
      <data key="d2">A method where a drop of blood is examined under a microscope to look for abnormal cells.&lt;SEP&gt;A test where a drop of blood is examined under a microscope.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-169&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-170</data>
