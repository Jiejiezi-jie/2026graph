      <data key="d0">Germline mutations</data>
      <data key="d1">concept</data>
      <data key="d2">Gene mutations inherited from birth parents that can increase cancer risk and be passed to children.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-156</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
