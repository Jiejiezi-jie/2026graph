    <node id="Ultrasound-Guided Fine-Needle Aspiration (US-FNA)">
      <data key="d0">Ultrasound-Guided Fine-Needle Aspiration (US-FNA)</data>
      <data key="d1">method</data>
      <data key="d2">A biopsy procedure using ultrasound guidance and fine-needle aspiration.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-103</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Radioactive Material">
      <data key="d0">Radioactive Material</data>
      <data key="d1">artifact</data>
      <data key="d2">A substance injected into the area where a breast tumor is located to help find sentinel lymph nodes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-104</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Dye">
      <data key="d0">Dye</data>
      <data key="d1">artifact</data>
      <data key="d2">A substance injected with radioactive material to help find sentinel lymph nodes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-104</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Open Biopsy">
      <data key="d0">Open Biopsy</data>
      <data key="d1">method</data>
      <data key="d2">A surgical procedure to remove a tumor to confirm histology.&lt;SEP&gt;A type of standard biopsy for gliomas, as opposed to stereotactic biopsy, though not detailed in the text.&lt;SEP&gt;A surgical procedure involving a craniotomy to remove a piece of skull bone and then a piece of the tumor for diagnosis.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-104&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-166&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-167</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Hormone Receptor">
      <data key="d0">Hormone Receptor</data>
      <data key="d1">concept</data>
      <data key="d2">A protein found inside or on the surface of a cell that hormones bind to, causing changes within the cell.&lt;SEP&gt;Receptor status is part of biomarker testing for breast cancer.&lt;SEP&gt;Proteins on cells that bind to hormones; status affects treatment.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-104&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-105&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-108</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Progesterone">
      <data key="d0">Progesterone</data>
      <data key="d1">concept</data>
      <data key="d2">A hormone that plays a role in the menstrual cycle and pregnancy and can stimulate breast cancer growth.&lt;SEP&gt;A hormone made mainly by the ovaries; can cause breast cancer to grow.&lt;SEP&gt;A female sex hormone produced mainly by the ovaries.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-104&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-111&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-112</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Hormone Receptor Testing">
      <data key="d0">Hormone Receptor Testing</data>
      <data key="d1">method</data>
      <data key="d2">Testing done on new tumors to determine the presence of estrogen and progesterone receptors.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-104</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Hormone Receptor-Positive Breast Cancer">
      <data key="d0">Hormone Receptor-Positive Breast Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Breast cancer that has estrogen and/or progesterone receptors, often treated with endocrine therapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-104</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Endocrine Therapy">
      <data key="d0">Endocrine Therapy</data>
      <data key="d1">method</data>
      <data key="d2">Treatment that blocks estrogen receptor signaling in hormone receptor-positive breast cancer.&lt;SEP&gt;Systemic therapy that blocks hormones that fuel cancer growth.&lt;SEP&gt;Drug therapy that blocks or lowers hormones to treat hormone receptor-positive breast cancer.&lt;SEP&gt;A treatment that blocks estrogen or progesterone to treat hormone receptor-positive breast cancer; also called hormone therapy.&lt;SEP&gt;A cancer treatment that alters hormone levels to slow or stop cancer growth.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-104&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-109&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-110&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-111&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-112</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Hormone Receptor-Negative Breast Cancer">
      <data key="d0">Hormone Receptor-Negative Breast Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Breast cancer that does not have either estrogen or progesterone receptors.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-104</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
