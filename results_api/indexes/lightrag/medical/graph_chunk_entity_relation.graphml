    </node>
    <node id="Frequent Urination">
      <data key="d0">Frequent Urination</data>
      <data key="d1">concept</data>
      <data key="d2">Common side effect of EBRT.&lt;SEP&gt;A symptom of bladder cancer characterized by needing to urinate often.&lt;SEP&gt;A short-term side effect of radiation therapy for anal cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-174&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189</data>
