    <node id="Tis">
      <data key="d0">Tis</data>
      <data key="d1">concept</data>
      <data key="d2">Carcinoma in situ, an intraductal tumor stage in intrahepatic bile duct cancer.&lt;SEP&gt;Carcinoma in situ, where cancerous cells are found only in the squamous cell layer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-024&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-032</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682976</data>
