    <node id="T-Cell Lymphocytes">
      <data key="d0">T-Cell Lymphocytes</data>
      <data key="d1">concept</data>
      <data key="d2">A type of lymphocyte that matures in the thymus and is involved in immune response. T-ALL starts in these cells.&lt;SEP&gt;A type of lymphocyte that matures in the thymus and is involved in cell-mediated immunity.&lt;SEP&gt;A type of lymphocyte that is involved in T-ALL.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-058&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-066&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-075</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683065</data>
      <data key="d6" />
    </node>
    <node id="B-Cell Lymphocytes">
      <data key="d0">B-Cell Lymphocytes</data>
      <data key="d1">concept</data>
      <data key="d2">A type of lymphocyte that produces antibodies. B-ALL affects these cells.&lt;SEP&gt;A type of lymphocyte that matures in the bone marrow and is involved in antibody production.&lt;SEP&gt;A type of lymphocyte that is involved in B-ALL.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-058&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-066&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-075</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683065</data>
      <data key="d6" />
    </node>
    <node id="BCR::ABL1-Negative B-ALL">
      <data key="d0">BCR::ABL1-Negative B-ALL</data>
      <data key="d1">concept</data>
      <data key="d2">A subtype of B-ALL that does not have the BCR::ABL1 gene rearrangement.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-058</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683065</data>
      <data key="d6" />
    </node>
    <node id="BCR::ABL1-Like B-ALL">
      <data key="d0">BCR::ABL1-Like B-ALL</data>
      <data key="d1">concept</data>
      <data key="d2">A subtype of B-ALL that has a gene expression profile similar to BCR::ABL1-positive B-ALL but lacks the BCR::ABL1 fusion.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-058</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683065</data>
      <data key="d6" />
    </node>
    <node id="BCR::ABL1-Positive B-ALL">
      <data key="d0">BCR::ABL1-Positive B-ALL</data>
      <data key="d1">concept</data>
      <data key="d2">A subtype of B-ALL that has the BCR::ABL1 gene rearrangement, leading to the production of the BCR::ABL protein.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-058</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683065</data>
      <data key="d6" />
    </node>
    <node id="Hyperplastic Polyps">
      <data key="d0">Hyperplastic Polyps</data>
      <data key="d1">concept</data>
      <data key="d2">Polyps that rarely turn into cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-058&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-121</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683065</data>
      <data key="d6" />
    </node>
    <node id="Inflammatory Polyps">
      <data key="d0">Inflammatory Polyps</data>
      <data key="d1">concept</data>
      <data key="d2">Polyps that rarely turn into cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-058&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-121</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683065</data>
      <data key="d6" />
    </node>
    <node id="Rectal Wall">
      <data key="d0">Rectal Wall</data>
      <data key="d1">location</data>
      <data key="d2">The wall of the rectum, made of layers of tissue. Cancer starts in the innermost layer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-058</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683065</data>
      <data key="d6" />
    </node>
    <node id="Stool">
      <data key="d0">Stool</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Waste material that is held in the rectum and exits through the anus.&lt;SEP&gt;Body waste that may contain blood after biopsy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-058&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-092</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683065</data>
