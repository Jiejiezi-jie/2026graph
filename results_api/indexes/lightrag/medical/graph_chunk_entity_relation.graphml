      <data key="d0">Metaphysis</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The area of a bone that grows rapidly, where bone tumors often occur.&lt;SEP&gt;The region of a bone between the physis and diaphysis.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-153&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-157</data>
