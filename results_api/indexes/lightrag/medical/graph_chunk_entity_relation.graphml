    </node>
    <node id="American Joint Committee">
      <data key="d0">American Joint Committee</data>
      <data key="d1">organization</data>
      <data key="d2">An organization likely involved in cancer staging guidelines.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-124</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Open Method">
      <data key="d0">Open Method</data>
      <data key="d1">method</data>
      <data key="d2">A surgical technique for colectomy that involves a large cut in the abdomen.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-124</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Minimally Invasive Method">
      <data key="d0">Minimally Invasive Method</data>
      <data key="d1">method</data>
      <data key="d2">A surgical technique for colectomy using small cuts and tools to remove part of the colon.&lt;SEP&gt;A surgical approach used to access and remove lymph nodes during surgical staging.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-124&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-142</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="One-Stage Colectomy">
      <data key="d0">One-Stage Colectomy</data>
      <data key="d1">method</data>
      <data key="d2">A colectomy that also unblocks the bowel in cases of bowel blockage.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-124</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Colectomy With Colostomy">
      <data key="d0">Colectomy With Colostomy</data>
      <data key="d1">method</data>
      <data key="d2">A colectomy that includes a colostomy, typically needed for a short time.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-124</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Stoma Bag">
      <data key="d0">Stoma Bag</data>
      <data key="d1">artifact</data>
      <data key="d2">A bag attached to the skin over the stoma to collect stool.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-124</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Bowel Obstruction">
      <data key="d0">Bowel Obstruction</data>
      <data key="d1">concept</data>
      <data key="d2">A blockage of the bowel, possibly due to scar tissue after surgery.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-124</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Stage 0 Colon Cancer">
      <data key="d0">Stage 0 Colon Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">The earliest stage of colon cancer, with abnormal cells on the innermost layer of the colon wall, also called carcinoma in situ.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-125</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Stage 1 Colon Cancer">
      <data key="d0">Stage 1 Colon Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Colon cancer that has grown into the second or third layer of the colon wall, without lymph node involvement or distant spread.&lt;SEP&gt;A stage of colon cancer where colonoscopy is recommended 1 year after surgery, then every 3 to 5 years if normal.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-125&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-126</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Stage 2 Colon Cancer">
      <data key="d0">Stage 2 Colon Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Colon cancer that has grown into or beyond the fourth layer of the colon wall, without lymph node involvement or distant spread.&lt;SEP&gt;A stage of colon cancer requiring surveillance including physical exams, CEA blood tests, and CT scans.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-125&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-126</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Stage 3 Colon Cancer">
      <data key="d0">Stage 3 Colon Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Colon cancer that has spread to nearby lymph nodes or has tumor deposits in the fat around the colon.&lt;SEP&gt;A stage of colon cancer requiring surveillance including physical exams, CEA blood tests, and CT scans.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-125&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-126</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Stage 4 Colon Cancer">
      <data key="d0">Stage 4 Colon Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Colon cancer that has spread to areas outside the colon and nearby lymph nodes, often to the liver and/or lungs.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-125</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
