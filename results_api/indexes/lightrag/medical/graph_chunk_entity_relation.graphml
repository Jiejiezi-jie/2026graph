    <node id="Premenopause">
      <data key="d0">Premenopause</data>
      <data key="d1">concept</data>
      <data key="d2">The period when a person has menstrual periods and the ovaries are the main source of estrogen and progesterone.&lt;SEP&gt;The stage before menopause when the ovaries are the main source of estrogen and progesterone.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-111&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-112</data>
