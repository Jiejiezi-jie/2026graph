    <node id="Neurological Symptoms">
      <data key="d0">Neurological Symptoms</data>
      <data key="d1">concept</data>
      <data key="d2">Symptoms such as headaches, nausea, vomiting, or seizures caused by pressure on the CNS.&lt;SEP&gt;Symptoms related to the nervous system, such as headaches, nausea, vomiting, seizures, and changes in personality or behavior.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-112&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-113</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Menstrual Periods">
      <data key="d0">Menstrual Periods</data>
      <data key="d1">concept</data>
      <data key="d2">The monthly shedding of the uterine lining; may stop during cancer treatment and for up to 2 years after, but often return in those 35 and under.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-112</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Disease">
      <data key="d0">Disease</data>
      <data key="d1">concept</data>
      <data key="d2">A condition that impairs normal functioning.&lt;SEP&gt;A condition that the body fights with immune cells.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-112&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-138</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Mononucleosis">
      <data key="d0">Mononucleosis</data>
      <data key="d1">concept</data>
      <data key="d2">An illness caused by the Epstein-Barr virus.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-112</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Immunosuppressive Medications">
      <data key="d0">Immunosuppressive Medications</data>
      <data key="d1">artifact</data>
      <data key="d2">Drugs that suppress the immune system, often required after organ transplant.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-112</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683082</data>
      <data key="d6" />
    </node>
    <node id="Personality Changes">
      <data key="d0">Personality Changes</data>
      <data key="d1">concept</data>
      <data key="d2">Alterations in behavior or character, a possible symptom of primary CNS lymphoma.&lt;SEP&gt;Changes in personality or behavior that can occur as a symptom of primary CNS lymphoma.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-112&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-113</data>
