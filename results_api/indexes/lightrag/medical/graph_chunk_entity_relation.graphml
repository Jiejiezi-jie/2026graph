    <node id="Hereditary Condition">
      <data key="d0">Hereditary Condition</data>
      <data key="d1">concept</data>
      <data key="d2">A genetic mutation passed from parent to child that can increase the risk of developing adrenal tumors.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-002</data>
