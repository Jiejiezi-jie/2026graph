    <node id="Family Members">
      <data key="d0">Family Members</data>
      <data key="d1">person</data>
      <data key="d2">Blood relatives whose health history is relevant for assessing familial risk of diseases.&lt;SEP&gt;Relatives who might carry the same mutations.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-003&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-105</data>
