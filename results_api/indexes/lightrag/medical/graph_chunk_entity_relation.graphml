    <node id="Cytology">
      <data key="d0">Cytology</data>
      <data key="d1">concept</data>
      <data key="d2">The examination of cells using a microscope, performed by a pathologist to confirm cancer.&lt;SEP&gt;The examination of cells using a microscope, performed by a pathologist to confirm the presence of cancer.&lt;SEP&gt;A test that studies urine under a microscope to look for cancer cells.</data>
