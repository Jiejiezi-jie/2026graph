      <data key="d0">Increased Risk of Infection</data>
      <data key="d1">concept</data>
      <data key="d2">A common side effect of chemotherapy due to lowered immunity.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-047</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683054</data>
