    <node id="Chapter 3: Types Of Treatment">
      <data key="d0">Chapter 3: Types Of Treatment</data>
      <data key="d1">content</data>
      <data key="d2">A chapter in the book that discusses types of treatment for basal cell skin cancer.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-000</data>
