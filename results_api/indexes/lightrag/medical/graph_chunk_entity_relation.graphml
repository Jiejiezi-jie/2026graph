    <node id="Ewing sarcoma">
      <data key="d0">Ewing sarcoma</data>
      <data key="d1">concept</data>
      <data key="d2">A type of cancer characterized by specific gene fusions, often involving EWSR1 and ETS family genes.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-156</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
      <data key="d6" />
    </node>
    <node id="EWSR1 gene">
      <data key="d0">EWSR1 gene</data>
      <data key="d1">concept</data>
      <data key="d2">A gene on chromosome 22 that fuses with ETS family genes in Ewing sarcoma.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-156</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683087</data>
