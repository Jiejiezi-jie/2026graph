      <data key="d0">Those Assigned Female at Birth</data>
      <data key="d1">person</data>
      <data key="d2">Individuals whose sex assigned at birth is female; the book covers screening recommendations for this group.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-098</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788683079</data>
      <data key="d6" />
    </node>
    <node id="Breast Specialist">
      <data key="d0">Breast Specialist</data>
      <data key="d1">person</data>
      <data key="d2">A healthcare provider who is an expert in breast health and disease.&lt;SEP&gt;An expert in breast health and disease.&lt;SEP&gt;A medical professional specializing in breast health, to whom patients may be referred for difficult diagnoses like inflammatory breast cancer.</data>
