    <node id="Barrier Methods">
      <data key="d0">Barrier Methods</data>
      <data key="d1">method</data>
      <data key="d2">Contraceptive methods that physically block sperm from reaching the egg, such as condoms, diaphragms, cervical caps, and contraceptive sponge.&lt;SEP&gt;Contraceptive methods that physically block sperm from reaching an egg, including condoms, diaphragms, cervical caps, and contraceptive sponges.&lt;SEP&gt;Contraceptive methods including condoms, diaphragms, cervical caps, and contraceptive sponge.&lt;SEP&gt;Contraceptive methods that physically block sperm; includes condoms, diaphragms, cervical caps, and contraceptive sponge.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-028&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-052&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-101&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-128&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-155</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682996</data>
      <data key="d6" />
    </node>
    <node id="Condoms">
      <data key="d0">Condoms</data>
      <data key="d1">artifact</data>
      <data key="d2">Barrier contraceptive devices worn on the penis to prevent pregnancy and sexually transmitted infections.&lt;SEP&gt;Sheath-like barriers worn on the penis or inside the vagina to prevent pregnancy and sexually transmitted infections.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-028&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-052</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682996</data>
      <data key="d6" />
    </node>
    <node id="Diaphragms">
      <data key="d0">Diaphragms</data>
      <data key="d1">artifact</data>
      <data key="d2">Barrier contraceptive devices inserted into the vagina to cover the cervix.&lt;SEP&gt;Reusable, dome-shaped cups inserted into the vagina to cover the cervix and prevent sperm from entering the uterus.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-028&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-052</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682996</data>
      <data key="d6" />
    </node>
    <node id="Cervical Caps">
      <data key="d0">Cervical Caps</data>
      <data key="d1">artifact</data>
      <data key="d2">Barrier contraceptive devices placed over the cervix.&lt;SEP&gt;Small, thimble-shaped devices inserted into the vagina to cover the cervix and block sperm.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-028&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-052</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682996</data>
      <data key="d6" />
    </node>
    <node id="Contraceptive Sponge">
      <data key="d0">Contraceptive Sponge</data>
      <data key="d1">artifact</data>
      <data key="d2">A barrier contraceptive device inserted into the vagina to cover the cervix and release spermicide.&lt;SEP&gt;Soft, foam-like device containing spermicide that is inserted into the vagina to prevent pregnancy.&lt;SEP&gt;A barrier contraceptive device inserted into the vagina.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-028&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-052&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-155</data>
