      <data key="d0">Aquaphor</data>
      <data key="d1">artifact</data>
      <data key="d2">An over-the-counter ointment used to soothe skin and help with healing during radiation therapy.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-189</data>
