    <node id="Penis">
      <data key="d0">Penis</data>
      <data key="d1">location</data>
      <data key="d2">The male reproductive organ, a site for HPV infection.&lt;SEP&gt;A part of the male reproductive system.&lt;SEP&gt;Part of the male reproductive system through which semen is released during ejaculation.&lt;SEP&gt;The male organ through which the urethra opens, relevant for cystoscopy insertion.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-052&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-079&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-087&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-176</data>
