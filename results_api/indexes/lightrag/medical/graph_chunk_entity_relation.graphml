    <node id="Bile Ducts">
      <data key="d0">Bile Ducts</data>
      <data key="d1">artifact</data>
      <data key="d2">Tubes that carry bile, with layers similar to the gallbladder.&lt;SEP&gt;Thin tubes that carry bile from the liver to the gallbladder and small intestine.</data>
      <data key="d3">doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-023&lt;SEP&gt;doc-3d7a4f05339f0e3f3870b407d21d9c8a-chunk-159</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788682976</data>
