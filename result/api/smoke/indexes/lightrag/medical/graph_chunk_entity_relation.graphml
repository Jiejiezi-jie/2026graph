  <graph edgedefault="undirected">
    <node id="Basal Cell Carcinoma">
      <data key="d0">Basal Cell Carcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">A common type of skin cancer that is the subject of the text.</data>
      <data key="d3">doc-7e278c8064848a055817975088ed08f8-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788532589</data>
      <data key="d6" />
    </node>
    <node id="Ultraviolet Radiation">
      <data key="d0">Ultraviolet Radiation</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A form of radiation that can damage DNA in skin cells and is a major risk factor for basal cell carcinoma.</data>
      <data key="d3">doc-7e278c8064848a055817975088ed08f8-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788532589</data>
      <data key="d6" />
    </node>
    <node id="DNA">
      <data key="d0">DNA</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The genetic material in skin cells that can be damaged by ultraviolet radiation.</data>
      <data key="d3">doc-7e278c8064848a055817975088ed08f8-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788532589</data>
      <data key="d6" />
    </node>
    <node id="Skin Cells">
      <data key="d0">Skin Cells</data>
      <data key="d1">other</data>
      <data key="d2">Cells in the skin that can be damaged by ultraviolet radiation, potentially leading to cancer.</data>
      <data key="d3">doc-7e278c8064848a055817975088ed08f8-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788532589</data>
      <data key="d6" />
    </node>
    <node id="Organ Transplant Recipients">
      <data key="d0">Organ Transplant Recipients</data>
      <data key="d1">person</data>
      <data key="d2">Individuals who have received organ transplants and take immunosuppressive medicines.</data>
      <data key="d3">doc-7e278c8064848a055817975088ed08f8-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788532589</data>
      <data key="d6" />
    </node>
    <node id="Immunosuppressive Medicines">
      <data key="d0">Immunosuppressive Medicines</data>
      <data key="d1">artifact</data>
      <data key="d2">Medications taken by organ transplant recipients to prevent graft rejection, which weaken immune surveillance.</data>
      <data key="d3">doc-7e278c8064848a055817975088ed08f8-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788532589</data>
      <data key="d6" />
    </node>
    <node id="Immunosuppression">
      <data key="d0">Immunosuppression</data>
      <data key="d1">concept</data>
      <data key="d2">The state of weakened immune surveillance resulting from immunosuppressive medicines, increasing the risk of basal cell carcinoma.</data>
      <data key="d3">doc-7e278c8064848a055817975088ed08f8-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788532589</data>
      <data key="d6" />
    </node>
    <node id="Mohs Surgery">
      <data key="d0">Mohs Surgery</data>
      <data key="d1">method</data>
      <data key="d2">A surgical technique that removes thin layers of cancer-containing skin, commonly used for high-risk basal cell carcinoma in cosmetically sensitive areas.</data>
      <data key="d3">doc-7e278c8064848a055817975088ed08f8-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788532589</data>
      <data key="d6" />
    </node>
