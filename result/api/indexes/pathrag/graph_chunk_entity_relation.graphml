    </node>
    <node id="&quot;HEART RATE&quot;">
      <data key="d0">"CATEGORY"</data>
      <data key="d1">"Heart Rate is a vital sign measuring the number of heartbeats per minute, checked during physical exam."&lt;SEP&gt;"Heart rate is a body function regulated by thyroid hormones."</data>
      <data key="d2">chunk-717174ace5855cc823d51c46c9a70648&lt;SEP&gt;chunk-18b5e32980f3efa0cd012e2abab9b9fc</data>
