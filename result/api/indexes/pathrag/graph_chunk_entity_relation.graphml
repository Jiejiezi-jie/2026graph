      <data key="d3">7.0</data>
      <data key="d4">"EBRT may be used to treat metastatic cervical cancer lesions, particularly in the liver, lungs, or bone."</data>
      <data key="d5">"radiation therapy, cancer treatment"</data>
      <data key="d6">chunk-9d0e32bdc49dbab9c2c953abf363e317</data>
    </edge>
