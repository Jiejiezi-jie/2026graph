      <data key="d3">8.0</data>
      <data key="d4">"Pelvic floor physical therapy is recommended before and after anal cancer treatment to support muscle function."</data>
      <data key="d5">"rehabilitation, treatment support"</data>
      <data key="d6">chunk-cf41d1c08e8df109ad214d831867a5d9</data>
    </edge>
    <edge source="&quot;PELVIC FLOOR PHYSICAL THERAPY&quot;" target="&quot;PHYSICAL THERAPIST&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Physical therapists deliver pelvic floor physical therapy techniques."</data>
      <data key="d5">"professional delivery, therapeutic intervention"</data>
      <data key="d6">chunk-cf41d1c08e8df109ad214d831867a5d9</data>
    </edge>
    <edge source="&quot;KARNOFSKY PERFORMANCE STATUS (KPS)&quot;" target="&quot;PERFORMANCE STATUS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"KPS provides a scale to rate a person's performance status, which is a factor in choosing a treatment plan."</data>
      <data key="d5">"health assessment, treatment planning"</data>
      <data key="d6">chunk-3fbf2f6a3c150687a59f814d94f1d150</data>
    </edge>
    <edge source="&quot;LYMPH NODE&quot;" target="&quot;BIOPSY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Lymph nodes are biopsied to check for cancer spread, often guided by imaging."</data>
      <data key="d5">"diagnosis, cancer spread"</data>
      <data key="d6">chunk-ea7b3f83164304ee4a562046eb0f5033</data>
    </edge>
    <edge source="&quot;LYMPH NODE&quot;" target="&quot;METASTASIS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Lymph nodes are common sites of metastasis, requiring biopsy to confirm cancer spread."</data>
      <data key="d5">"cancer spread, diagnosis"</data>
      <data key="d6">chunk-3d609bd1a55d409470c55ad55e2d125d</data>
    </edge>
    <edge source="&quot;LYMPH NODE&quot;" target="&quot;CANCER STAGING&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Lymph node status (N) is a key component of cancer staging, indicating whether cancer has spread to nearby lymph nodes."</data>
      <data key="d5">"staging, metastasis assessment"</data>
      <data key="d6">chunk-f8639a06098656be20a04fe129660616</data>
    </edge>
    <edge source="&quot;LYMPH NODE&quot;" target="&quot;PROSTATE CANCER&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Prostate cancer can spread to lymph nodes, as detected by imaging like PSMA-PET scans."</data>
      <data key="d5">"metastasis, cancer spread"</data>
      <data key="d6">chunk-975e540ddee1810d43caf8df4adcf205</data>
    </edge>
    <edge source="&quot;LYMPH NODE&quot;" target="&quot;CANCER&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Lymph nodes are common sites for cancer spread and are examined via imaging and biopsy to detect cancer."</data>
      <data key="d5">"cancer spread, diagnostic examination"</data>
      <data key="d6">chunk-9ad38c9dc069a8ff8df58c42f00eba23</data>
    </edge>
    <edge source="&quot;LYMPH NODE&quot;" target="&quot;LYMPH NODE DISSECTION&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Lymph node dissection involves removing lymph nodes to check for cancer spread."</data>
      <data key="d5">"anatomical structure, surgical procedure"</data>
      <data key="d6">chunk-7d994e430bb9890c905d7914fad9c118</data>
    </edge>
    <edge source="&quot;LYMPH NODE&quot;" target="&quot;SENTINEL LYMPH NODE BIOPSY&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Sentinel lymph node biopsy examines the first lymph node to which cancer spreads."&lt;SEP&gt;"Sentinel lymph nodes are the first lymph nodes to which cancer cells likely spread, and they are examined in the biopsy."</data>
      <data key="d5">"anatomical structure, biopsy procedure"&lt;SEP&gt;"anatomy, cancer staging"</data>
      <data key="d6">chunk-7d994e430bb9890c905d7914fad9c118&lt;SEP&gt;chunk-e9cc65c1c26b9e24bfb2c8c966f734a0</data>
    </edge>
    <edge source="&quot;PLACEBO&quot;" target="&quot;CLINICAL TRIALS&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Placebos are used in clinical trials, often combined with standard treatment or new drugs, and participants are informed before enrollment."</data>
      <data key="d5">"trial design, drug testing"</data>
      <data key="d6">chunk-541f1323a24c5990b4a6408e0c5442ab</data>
    </edge>
    <edge source="&quot;PLACEBO&quot;" target="&quot;STANDARD TREATMENT&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"In clinical trials, a placebo may be given with a standard treatment."</data>
      <data key="d5">"trial design, treatment"</data>
      <data key="d6">chunk-cd2be7a2ce722f07b19c80e6e1690a8e</data>
    </edge>
    <edge source="&quot;PLACEBO&quot;" target="&quot;NEW DRUG&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"In clinical trials, a new drug may be given with a standard treatment, and a placebo is rarely used alone."</data>
      <data key="d5">"trial design, treatment"</data>
      <data key="d6">chunk-cd2be7a2ce722f07b19c80e6e1690a8e</data>
    </edge>
    <edge source="&quot;PLACEBO&quot;" target="&quot;CLINICAL TRIAL&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"A placebo is used as a control in clinical trials to compare against the investigational treatment."&lt;SEP&gt;"Placebos are used in some clinical trials, almost never alone, and participants are informed."</data>
      <data key="d5">"research methodology, control"&lt;SEP&gt;"trial design, treatment"</data>
      <data key="d6">chunk-725b48dc82aad42ba3dc14f4b5207551&lt;SEP&gt;chunk-e74c94f9f2ff33172671e8742338c6d1</data>
    </edge>
    <edge source="&quot;SQUAMOUS CELL CARCINOMA (CSCC)&quot;" target="&quot;NCCN&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"NCCN provides guidelines for the prevention, diagnosis, and treatment of squamous cell carcinoma, including recommendations for high-risk individuals."</data>
      <data key="d5">"clinical guidelines, cancer management"</data>
      <data key="d6">chunk-3821a6febf2d21784059ac62a6e659c1</data>
    </edge>
    <edge source="&quot;SQUAMOUS CELL CARCINOMA (CSCC)&quot;" target="&quot;LYMPHOMA&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Lymphoma weakens the immune system, increasing the risk of developing squamous cell carcinoma."</data>
      <data key="d5">"immune suppression, cancer risk"</data>
      <data key="d6">chunk-3821a6febf2d21784059ac62a6e659c1</data>
    </edge>
    <edge source="&quot;SQUAMOUS CELL CARCINOMA (CSCC)&quot;" target="&quot;CHRONIC LYMPHOCYTIC LEUKEMIA&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Chronic lymphocytic leukemia weakens the immune system, increasing the risk of squamous cell carcinoma."</data>
      <data key="d5">"immune suppression, cancer risk"</data>
      <data key="d6">chunk-3821a6febf2d21784059ac62a6e659c1</data>
    </edge>
    <edge source="&quot;SQUAMOUS CELL CARCINOMA (CSCC)&quot;" target="&quot;HIV/AIDS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"HIV/AIDS weakens the immune system, increasing the risk of developing squamous cell carcinoma."</data>
      <data key="d5">"immune deficiency, cancer risk"</data>
      <data key="d6">chunk-3821a6febf2d21784059ac62a6e659c1</data>
    </edge>
    <edge source="&quot;SQUAMOUS CELL CARCINOMA (CSCC)&quot;" target="&quot;IMMUNOSUPPRESSANTS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Immunosuppressants, taken after organ transplantation, reduce the immune system's ability to fight cancer, increasing the risk of squamous cell carcinoma."</data>
      <data key="d5">"drug side effects, immune suppression"</data>
      <data key="d6">chunk-3821a6febf2d21784059ac62a6e659c1</data>
    </edge>
    <edge source="&quot;SQUAMOUS CELL CARCINOMA (CSCC)&quot;" target="&quot;ACTINIC KERATOSIS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Actinic keratosis is a precancerous condition that increases the risk of developing squamous cell carcinoma, as it can progress to skin cancer."</data>
      <data key="d5">"precancerous progression, risk factor"</data>
      <data key="d6">chunk-3821a6febf2d21784059ac62a6e659c1</data>
    </edge>
    <edge source="&quot;SQUAMOUS CELL CARCINOMA (CSCC)&quot;" target="&quot;MARJOLIN’S ULCER&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Marjolin’s ulcer is a form of squamous cell carcinoma that develops in scars or chronic wounds, making it a specific subtype of CSCC."</data>
      <data key="d5">"subtype, wound-related cancer"</data>
      <data key="d6">chunk-3821a6febf2d21784059ac62a6e659c1</data>
    </edge>
    <edge source="&quot;SQUAMOUS CELL CARCINOMA (CSCC)&quot;" target="&quot;XERODERMA PIGMENTOSUM (XP)&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Xeroderma pigmentosum is a genetic syndrome that increases the risk of developing squamous cell carcinoma due to inability to repair DNA damage from sunlight."</data>
      <data key="d5">"genetic risk, DNA damage"</data>
      <data key="d6">chunk-3821a6febf2d21784059ac62a6e659c1</data>
    </edge>
    <edge source="&quot;SQUAMOUS CELL CARCINOMA (CSCC)&quot;" target="&quot;RECESSIVE DYSTROPHIC EPIDERMOLYSIS BULLOSA (RDEB)&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Recessive dystrophic epidermolysis bullosa is a genetic syndrome that increases the risk of squamous cell carcinoma due to fragile skin and chronic wounds."</data>
      <data key="d5">"genetic risk, skin fragility"</data>
      <data key="d6">chunk-3821a6febf2d21784059ac62a6e659c1</data>
    </edge>
    <edge source="&quot;SQUAMOUS CELL CARCINOMA (CSCC)&quot;" target="&quot;WEAKENED IMMUNE SYSTEM&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"A weakened immune system increases the risk of developing squamous cell carcinoma, as the body has reduced ability to fight off cancer cells."</data>
      <data key="d5">"immune deficiency, cancer risk"</data>
      <data key="d6">chunk-3821a6febf2d21784059ac62a6e659c1</data>
    </edge>
    <edge source="&quot;SQUAMOUS CELL CARCINOMA (CSCC)&quot;" target="&quot;ENVIRONMENTAL TOXINS&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Exposure to environmental toxins such as tobacco smoke, exhaust, and arsenic can cause skin damage leading to squamous cell carcinoma."</data>
      <data key="d5">"toxin exposure, carcinogenesis"</data>
      <data key="d6">chunk-3821a6febf2d21784059ac62a6e659c1</data>
    </edge>
    <edge source="&quot;SQUAMOUS CELL CARCINOMA (CSCC)&quot;" target="&quot;SUN EXPOSURE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Sun exposure causes DNA damage in skin cells, which can lead to the development of squamous cell carcinoma."</data>
      <data key="d5">"UV radiation, DNA damage"</data>
      <data key="d6">chunk-3821a6febf2d21784059ac62a6e659c1</data>
    </edge>
    <edge source="&quot;SQUAMOUS CELL CARCINOMA (CSCC)&quot;" target="&quot;SCARS AND CHRONIC WOUNDS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Scars and chronic wounds can be sites where squamous cell carcinoma develops, particularly in the form of Marjolin’s ulcer."</data>
      <data key="d5">"wound healing, cancer development"</data>
      <data key="d6">chunk-3821a6febf2d21784059ac62a6e659c1</data>
    </edge>
    <edge source="&quot;SQUAMOUS CELL CARCINOMA (CSCC)&quot;" target="&quot;SKIN BIOPSY&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"A skin biopsy is the definitive diagnostic procedure for squamous cell carcinoma, as it allows for microscopic examination of tissue."</data>
      <data key="d5">"diagnosis, tissue sampling"</data>
      <data key="d6">chunk-3821a6febf2d21784059ac62a6e659c1</data>
    </edge>
