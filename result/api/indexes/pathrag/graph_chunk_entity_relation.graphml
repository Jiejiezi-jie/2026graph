      <data key="d4">"Smoking tobacco is a lifestyle factor that increases the chance of developing pancreatic cancer."</data>
      <data key="d5">"risk factor, lifestyle"</data>
      <data key="d6">chunk-6268b6efa690f6e094e443dca6b4cb52</data>
    </edge>
