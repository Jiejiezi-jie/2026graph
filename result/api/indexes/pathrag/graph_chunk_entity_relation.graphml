      <data key="d3">9.0</data>
      <data key="d4">"Pembrolizumab is used as first-line therapy for PD-L1-positive metastatic cervical cancer and as second-line therapy for cancers with specific biomarkers."</data>
      <data key="d5">"immunotherapy treatment"</data>
      <data key="d6">chunk-8ba71a5181f3814dffb21d3399441bea</data>
    </edge>
