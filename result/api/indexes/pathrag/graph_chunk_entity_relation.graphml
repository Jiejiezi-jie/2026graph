      <data key="d3">6.0</data>
      <data key="d4">"NCCN's website provides patient guidelines for lung cancer, including NSCLC resources."</data>
      <data key="d5">"resource, guidance"</data>
      <data key="d6">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="&quot;LUNG CANCER&quot;" target="&quot;TREATMENT&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Lung cancer treatment has improved over time, offering multiple options for patients."</data>
      <data key="d5">"treatment, medical care"</data>
      <data key="d6">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="&quot;LUNG CANCER&quot;" target="&quot;RISK ASSESSMENT&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Risk assessment helps determine an individual's chance of developing lung cancer, guiding screening."</data>
      <data key="d5">"risk evaluation, screening"</data>
      <data key="d6">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="&quot;LUNG CANCER&quot;" target="&quot;CANCER SCREENINGS&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Lung cancer screening is part of broader cancer screening efforts, though not recommended for everyone."</data>
      <data key="d5">"screening, prevention"</data>
      <data key="d6">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="&quot;LUNG CANCER&quot;" target="&quot;RESPIRATION&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Lung cancer can impair respiration by disrupting the lungs' ability to exchange gases."</data>
      <data key="d5">"disease impact, function"</data>
      <data key="d6">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="&quot;LUNG CANCER&quot;" target="&quot;OXYGEN&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Lung cancer can reduce oxygen delivery to the blood, affecting overall health."</data>
      <data key="d5">"disease impact, function"</data>
      <data key="d6">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="&quot;LUNG CANCER&quot;" target="&quot;CARBON DIOXIDE&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Lung cancer can impair carbon dioxide removal, leading to respiratory issues."</data>
      <data key="d5">"disease impact, function"</data>
      <data key="d6">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="&quot;LUNG CANCER&quot;" target="&quot;BLOODSTREAM&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Lung cancer cells can spread through the bloodstream to other parts of the body."</data>
      <data key="d5">"metastasis, spread"</data>
      <data key="d6">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="&quot;LUNG CANCER&quot;" target="&quot;LYMPH&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Lung cancer cells can spread through lymph fluid to other areas."</data>
      <data key="d5">"metastasis, spread"</data>
      <data key="d6">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="&quot;LUNG CANCER&quot;" target="&quot;NORMAL CELLS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Lung cancer cells crowd out normal cells, causing organ dysfunction."</data>
      <data key="d5">"cell competition, harm"</data>
      <data key="d6">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="&quot;LUNG CANCER&quot;" target="&quot;CELL GROWTH&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Lung cancer involves uncontrolled cell growth, leading to tumor formation."</data>
      <data key="d5">"pathology, growth"</data>
      <data key="d6">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="&quot;LUNG CANCER&quot;" target="&quot;TISSUE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Lung cancer can invade lung tissue as it grows."</data>
      <data key="d5">"invasion, spread"</data>
      <data key="d6">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="&quot;LUNG CANCER&quot;" target="&quot;ORGAN&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Lung cancer can cause organs to stop working if it spreads and overwhelms normal cells."</data>
      <data key="d5">"organ damage, dysfunction"</data>
      <data key="d6">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="&quot;CLINIC&quot;" target="&quot;TRANSURETHRAL RESECTION OF BLADDER TUMOR (TURBT)&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"TURBT may be performed in a clinic's operating room."</data>
      <data key="d5">"procedure, location"</data>
      <data key="d6">chunk-a158766f46bf752d6cdfe95c92f14547</data>
    </edge>
    <edge source="&quot;CATARACTS&quot;" target="&quot;RADIATION THERAPY&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Cataracts are a serious long-term side effect of radiation therapy for CSCC in the eye area."</data>
      <data key="d5">"side effect, treatment risk"</data>
      <data key="d6">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0</data>
    </edge>
