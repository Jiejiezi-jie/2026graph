      <data key="d3">9.0</data>
      <data key="d4">"The presence of the PD-L1 biomarker in metastatic cervical cancer determines the preferred first-line systemic therapy regimen."</data>
      <data key="d5">"biomarker-driven treatment"</data>
      <data key="d6">chunk-8ba71a5181f3814dffb21d3399441bea</data>
    </edge>
