      <data key="d1">"Lower jaw is a bone structure imaged in panoramic dental x-rays."</data>
      <data key="d2">chunk-705ff2bd04b2b58b98187f60f23a659e</data>
    </node>
    <node id="&quot;BRAIN TUMOR STORY&quot;">
