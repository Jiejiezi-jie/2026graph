      <data key="d1">"Clinical laboratory is certified to perform diagnostic tests."</data>
      <data key="d2">chunk-650982a589c2d527bc13923ccd0569ef</data>
    </node>
    <node id="&quot;DIESEL FUMES&quot;">
      <data key="d0">"CATEGORY"</data>
      <data key="d1">"Diesel fumes are a cancer-causing agent that increases lung cancer risk, especially in smokers. They are produced by diesel engines."</data>
      <data key="d2">chunk-7843955573cdc294b34e74019195fafb</data>
    </node>
