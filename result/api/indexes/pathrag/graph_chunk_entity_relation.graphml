      <data key="d2">chunk-7843955573cdc294b34e74019195fafb</data>
    </node>
    <node id="&quot;FOLLICULAR THYROID CARCINOMA (FTC)&quot;">
      <data key="d0">"CATEGORY"</data>
      <data key="d1">"Follicular thyroid carcinoma is the second most common type of thyroid cancer, known for invading blood vessels, and can only be diagnosed through pathologic examination or genetic testing, not needle biopsy alone."</data>
