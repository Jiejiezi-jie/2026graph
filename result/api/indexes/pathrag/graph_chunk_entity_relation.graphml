      <data key="d3">8.0</data>
      <data key="d4">"Bevacizumab may be added to first-line regimens for metastatic cervical cancer to enhance treatment effectiveness."</data>
      <data key="d5">"treatment combination"</data>
      <data key="d6">chunk-8ba71a5181f3814dffb21d3399441bea</data>
    </edge>
