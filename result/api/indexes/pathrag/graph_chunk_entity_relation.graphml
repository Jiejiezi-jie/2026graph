      <data key="d2">chunk-419f40f64b13b1b2d0fac3cfb9fde92a</data>
    </node>
    <node id="&quot;WORRY&quot;">
      <data key="d0">"CATEGORY"</data>
      <data key="d1">"Worry is a psychological state associated with cancer diagnosis that can be alleviated by clear information and support systems."&lt;SEP&gt;"Worry is an emotional response that can be part of distress in cancer patients."</data>
