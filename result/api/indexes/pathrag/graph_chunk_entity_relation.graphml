      <data key="d3">6.0</data>
      <data key="d4">"Temozolomide is an alternative or additional chemotherapy for CNS lymphoma."</data>
      <data key="d5">"alternative treatment, drug therapy"</data>
      <data key="d6">chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </edge>
