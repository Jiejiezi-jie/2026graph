      <data key="d2">chunk-d0f15711706bc171fed17a7fab91b4b6</data>
    </node>
    <node id="&quot;G1&quot;">
      <data key="d0">"CATEGORY"</data>
      <data key="d1">"G1 is a grade category indicating a low-grade tumor, which has a low risk of recurrence."&lt;SEP&gt;"G1 refers to well-differentiated cancer cells that look similar to normal cells, indicating a low grade."</data>
      <data key="d2">chunk-84367cc8f7a94b97b4b66a1ca127c15f&lt;SEP&gt;chunk-0d388da75afb5ea2d01c97e55cb2b872</data>
    </node>
