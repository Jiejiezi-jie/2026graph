    </node>
    <node id="&quot;BODY TEMPERATURE&quot;">
      <data key="d0">"CATEGORY"</data>
      <data key="d1">"Body Temperature is a vital sign measuring the body's heat, checked during physical exam."</data>
      <data key="d2">chunk-717174ace5855cc823d51c46c9a70648</data>
    </node>
    <node id="&quot;T-CELL LYMPHOCYTES&quot;">
