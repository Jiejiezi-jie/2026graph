      <data key="d3">7.0</data>
      <data key="d4">"Primary CNS lymphoma is a type of brain cancer, and other brain cancers can have similar symptoms, requiring differential diagnosis."</data>
      <data key="d5">"differential diagnosis, disease similarity"</data>
      <data key="d6">chunk-a0d4d6b091e033fd01aa721422b68ef5</data>
    </edge>
