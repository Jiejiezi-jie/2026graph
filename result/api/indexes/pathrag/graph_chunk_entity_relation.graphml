      <data key="d2">chunk-69e63736c94b8b08a565c3d8679d3b57</data>
    </node>
    <node id="&quot;SUBSTANCES&quot;">
      <data key="d0">"CATEGORY"</data>
      <data key="d1">"Substances in contrast material help improve imaging quality."</data>
      <data key="d2">chunk-5fa7c7369d88ae71c842152510867223</data>
    </node>
