      <data key="d2">chunk-5fa7c7369d88ae71c842152510867223</data>
    </node>
    <node id="&quot;FOLDERS&quot;">
      <data key="d0">"CATEGORY"</data>
      <data key="d1">"Folders are organizational tools within a medical binder for categorizing records by type."&lt;SEP&gt;"Folders are organizational tools within a medical binder to categorize records by type and date."</data>
      <data key="d2">chunk-0bd86bf8fc82f14fa5f7f51d924514e7&lt;SEP&gt;chunk-705ff2bd04b2b58b98187f60f23a659e</data>
    </node>
