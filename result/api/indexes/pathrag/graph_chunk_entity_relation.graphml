    <edge source="&quot;PELVIC FLOOR PHYSICAL THERAPY&quot;" target="&quot;KEGEL EXERCISES&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Kegel exercises are a component of pelvic floor physical therapy to strengthen muscles."</data>
      <data key="d5">"therapeutic technique, muscle strengthening"</data>
      <data key="d6">chunk-cf41d1c08e8df109ad214d831867a5d9</data>
    </edge>
