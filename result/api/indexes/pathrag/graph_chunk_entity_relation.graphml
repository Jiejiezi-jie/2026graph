    </node>
    <node id="&quot;LOCAL ANESTHETIC&quot;">
      <data key="d0">"CATEGORY"</data>
      <data key="d1">"Local anesthetic is a numbing medicine injected into the skin before a biopsy to minimize pain during the procedure, allowing for accurate sample collection."</data>
      <data key="d2">chunk-3821a6febf2d21784059ac62a6e659c1</data>
    </node>
