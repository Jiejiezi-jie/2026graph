      <data key="d3">9.0</data>
      <data key="d4">"Primary CNS lymphoma treatment begins with the induction phase, which aims to eliminate lymphoma cells."</data>
      <data key="d5">"treatment process, cancer management"</data>
      <data key="d6">chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </edge>
