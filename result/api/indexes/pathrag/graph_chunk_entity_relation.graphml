      <data key="d3">8.0</data>
      <data key="d4">"After induction, consolidation phase targets remaining cancer cells to prevent relapse."</data>
      <data key="d5">"treatment process, cancer management"</data>
      <data key="d6">chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </edge>
    <edge source="&quot;PRIMARY CNS LYMPHOMA&quot;" target="&quot;HIGH-DOSE CHEMOTHERAPY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"High-dose chemotherapy is a primary treatment approach for CNS lymphoma, using drugs like methotrexate."</data>
      <data key="d5">"treatment intensity, cancer therapy"</data>
      <data key="d6">chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </edge>
