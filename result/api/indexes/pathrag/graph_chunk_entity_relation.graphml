      <data key="d1">"Detection methods are techniques used to identify bladder cancer, including tests and procedures for diagnosis and monitoring."</data>
      <data key="d2">chunk-68217ea9e5382d1756c99b5152ea98db</data>
    </node>
    <node id="&quot;IMAGING TEST PROCEDURE&quot;">
