    <edge source="&quot;BASAL CELL SKIN CANCER&quot;" target="&quot;BLOND HAIR&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Blond hair is a risk factor for basal cell skin cancer, often associated with fair skin and increased UV sensitivity."</data>
      <data key="d5">"risk factor, susceptibility"</data>
      <data key="d6">chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </edge>
    <edge source="&quot;BASAL CELL SKIN CANCER&quot;" target="&quot;LIGHT EYE COLOR&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Light eye color is a risk factor for basal cell skin cancer, often associated with fair skin and increased UV sensitivity."</data>
      <data key="d5">"risk factor, susceptibility"</data>
      <data key="d6">chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </edge>
    <edge source="&quot;BASAL CELL SKIN CANCER&quot;" target="&quot;AGE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Age is a risk factor for basal cell skin cancer, as sun exposure accumulates over time, increasing risk."</data>
      <data key="d5">"risk factor, cumulative exposure"</data>
      <data key="d6">chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </edge>
    <edge source="&quot;BASAL CELL SKIN CANCER&quot;" target="&quot;HISTORY OF SKIN CANCER&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"A personal or family history of skin cancer increases the risk of developing basal cell skin cancer."</data>
      <data key="d5">"risk factor, genetic predisposition"</data>
      <data key="d6">chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </edge>
    <edge source="&quot;BASAL CELL SKIN CANCER&quot;" target="&quot;IMMUNE SUPPRESSION&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Immune suppression, from organ transplants or autoimmune diseases, increases the risk of basal cell skin cancer."</data>
      <data key="d5">"risk factor, immune function"</data>
      <data key="d6">chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </edge>
    <edge source="&quot;BASAL CELL SKIN CANCER&quot;" target="&quot;RECURRENCE&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Basal cell skin cancer can recur, meaning it returns to the original area or spreads, which is a key concern in treatment planning."&lt;SEP&gt;"Recurrence is when basal cell skin cancer returns to the original area or spreads, requiring ongoing monitoring and treatment."</data>
      <data key="d5">"cancer recurrence, treatment planning"&lt;SEP&gt;"disease progression, clinical outcome"</data>
      <data key="d6">chunk-f8eae4d6dadf6a6fbd339efa4dec2172&lt;SEP&gt;chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </edge>
    <edge source="&quot;BASAL CELL SKIN CANCER&quot;" target="&quot;METASTASIS&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Basal cell skin cancer can metastasize to lymph nodes or distant parts of the body, affecting treatment options."&lt;SEP&gt;"Metastasis is the spread of basal cell skin cancer to lymph nodes or distant parts, which is rare but possible."</data>
      <data key="d5">"cancer spread, treatment"&lt;SEP&gt;"disease progression, clinical outcome"</data>
      <data key="d6">chunk-f8eae4d6dadf6a6fbd339efa4dec2172&lt;SEP&gt;chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </edge>
    <edge source="&quot;BASAL CELL SKIN CANCER&quot;" target="&quot;LYMPH NODES&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Basal cell skin cancer can metastasize to lymph nodes, indicating a more advanced stage of the disease."</data>
      <data key="d5">"disease spread, clinical outcome"</data>
      <data key="d6">chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </edge>
    <edge source="&quot;BASAL CELL SKIN CANCER&quot;" target="&quot;FULL SKIN EXAMS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Full skin exams are recommended after treatment for basal cell skin cancer to monitor for recurrence or new cancers."</data>
      <data key="d5">"follow-up care, monitoring"</data>
      <data key="d6">chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </edge>
    <edge source="&quot;BASAL CELL SKIN CANCER&quot;" target="&quot;BIOPSY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Biopsy is a testing method used to diagnose basal cell skin cancer."</data>
      <data key="d5">"diagnosis, testing"</data>
      <data key="d6">chunk-f8eae4d6dadf6a6fbd339efa4dec2172</data>
    </edge>
    <edge source="&quot;BASAL CELL SKIN CANCER&quot;" target="&quot;IMAGING&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Imaging tests may be used in some cases to diagnose or assess basal cell skin cancer."</data>
      <data key="d5">"diagnosis, imaging"</data>
      <data key="d6">chunk-f8eae4d6dadf6a6fbd339efa4dec2172</data>
    </edge>
    <edge source="&quot;BASAL CELL SKIN CANCER&quot;" target="&quot;TREATMENT&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Treatment options for basal cell skin cancer are discussed, including various approaches based on risk and recurrence."</data>
      <data key="d5">"treatment, cancer management"</data>
      <data key="d6">chunk-f8eae4d6dadf6a6fbd339efa4dec2172</data>
    </edge>
    <edge source="&quot;BASAL CELL SKIN CANCER&quot;" target="&quot;UNITED STATES&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Basal cell skin cancer is diagnosed in about 3 million cases annually in the United States, indicating a significant prevalence of the disease in this country."</data>
      <data key="d5">"prevalence, epidemiology"</data>
      <data key="d6">chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </edge>
    <edge source="&quot;BASAL CELL SKIN CANCER&quot;" target="&quot;EPIDERMIS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Basal cell skin cancer occurs in the epidermis, specifically in the basal cells located in the lower part of this skin layer."</data>
      <data key="d5">"anatomical location, disease development"</data>
      <data key="d6">chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </edge>
    <edge source="&quot;BASAL CELL SKIN CANCER&quot;" target="&quot;BASAL CELLS&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Basal cell skin cancer develops when basal cells in the epidermis become abnormal and grow out of control, leading to the formation of cancerous lesions."</data>
      <data key="d5">"cellular origin, disease mechanism"</data>
      <data key="d6">chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </edge>
    <edge source="&quot;BASAL CELL SKIN CANCER&quot;" target="&quot;UV RADIATION&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"UV radiation from the sun or tanning beds is a primary cause of basal cell skin cancer, as it damages DNA in basal skin cells."</data>
      <data key="d5">"causation, risk factor"</data>
      <data key="d6">chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </edge>
    <edge source="&quot;BASAL CELL SKIN CANCER&quot;" target="&quot;SKIN LESIONS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Basal cell skin cancer often presents as skin lesions, which can appear as flat pale areas, red patches, shiny bumps, or open sores on the skin."</data>
      <data key="d5">"symptomatology, clinical presentation"</data>
      <data key="d6">chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </edge>
    <edge source="&quot;BASAL CELL SKIN CANCER&quot;" target="&quot;SURGERY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Surgery is the most common treatment for basal cell skin cancer, involving the removal of cancerous tissue to cure the disease."</data>
      <data key="d5">"treatment, medical intervention"</data>
      <data key="d6">chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </edge>
    <edge source="&quot;BASAL CELL SKIN CANCER&quot;" target="&quot;RADIATION THERAPY&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Radiation therapy is a treatment option for basal cell skin cancer, used in some cases to kill cancer cells with high-energy rays."&lt;SEP&gt;"Radiation therapy, especially at a young age, is a risk factor for basal cell skin cancer, as it can damage skin cells."</data>
      <data key="d5">"risk factor, medical history"&lt;SEP&gt;"treatment, medical intervention"</data>
      <data key="d6">chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </edge>
    <edge source="&quot;BASAL CELL SKIN CANCER&quot;" target="&quot;SYSTEMIC THERAPY&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Systemic therapy is a treatment approach for basal cell skin cancer, using drugs to target cancer cells throughout the body in certain cases."</data>
      <data key="d5">"treatment, medical intervention"</data>
      <data key="d6">chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </edge>
    <edge source="&quot;BASAL CELL SKIN CANCER&quot;" target="&quot;RISK FACTORS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Risk factors such as UV light exposure, fair skin, age, and immune suppression increase the likelihood of developing basal cell skin cancer."</data>
      <data key="d5">"risk assessment, disease susceptibility"</data>
      <data key="d6">chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </edge>
    <edge source="&quot;BASAL CELL SKIN CANCER&quot;" target="&quot;NCCN GUIDELINES FOR PATIENTS&quot;">
      <data key="d3">5.0</data>
      <data key="d4">"The NCCN Guidelines for Patients provide information on skin cancer types, including basal cell skin cancer, and are referenced for further patient education."</data>
      <data key="d5">"educational resource, patient guidance"</data>
      <data key="d6">chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </edge>
    <edge source="&quot;RISK GROUP&quot;" target="&quot;PROSTATE CANCER&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Risk group is determined by combining PSA level, Grade Group, tumor stage, and biopsy results to predict cancer outcome and guide treatment."</data>
      <data key="d5">"prognosis, treatment guidance"</data>
      <data key="d6">chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa</data>
    </edge>
    <edge source="&quot;RISK GROUP&quot;" target="&quot;PSA LEVEL&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"PSA level is a component used to determine the risk group for prostate cancer."</data>
      <data key="d5">"risk calculation, diagnostic input"</data>
      <data key="d6">chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa</data>
    </edge>
    <edge source="&quot;RISK GROUP&quot;" target="&quot;GRADE GROUP&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Grade Group is a key factor in determining the risk group for prostate cancer."</data>
      <data key="d5">"risk calculation, diagnostic input"</data>
      <data key="d6">chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa</data>
    </edge>
    <edge source="&quot;RISK GROUP&quot;" target="&quot;BIOPSY&quot;">
      <data key="d3">13.0</data>
      <data key="d4">"Biopsy results, including Gleason patterns, are used to determine risk group."&lt;SEP&gt;"Biopsy results, including Gleason patterns, contribute to the risk group determination."</data>
      <data key="d5">"diagnostic input, risk assessment"</data>
      <data key="d6">chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa</data>
    </edge>
    <edge source="&quot;RISK GROUP&quot;" target="&quot;TREATMENT&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Risk group determines treatment intensity, with higher risk leading to more aggressive therapy."</data>
      <data key="d5">"treatment planning, risk-based care"</data>
      <data key="d6">chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa</data>
    </edge>
    <edge source="&quot;RISK GROUP&quot;" target="&quot;PROGNOSIS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Risk group predicts the likely course and outcome of prostate cancer, forming the basis for prognosis."</data>
      <data key="d5">"prognosis, risk assessment"</data>
      <data key="d6">chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa</data>
    </edge>
    <edge source="&quot;RISK GROUP&quot;" target="&quot;TUMOR STAGE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Tumor stage is a component of risk group determination, along with PSA level and Grade Group."</data>
      <data key="d5">"risk calculation, diagnostic input"</data>
      <data key="d6">chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa</data>
    </edge>
    <edge source="&quot;LUNG CANCER&quot;" target="&quot;NON-SMALL CELL LUNG CANCER (NSCLC)&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Lung cancer encompasses NSCLC as a major subtype, which includes various carcinomas like adenocarcinoma and squamous cell carcinoma."</data>
      <data key="d5">"cancer subtypes, classification"</data>
      <data key="d6">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="&quot;LUNG CANCER&quot;" target="&quot;SMALL CELL LUNG CANCER (SCLC)&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Lung cancer includes SCLC as a distinct, aggressive subtype that is less common than NSCLC."</data>
      <data key="d5">"cancer subtypes, classification"</data>
      <data key="d6">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="&quot;LUNG CANCER&quot;" target="&quot;CARCINOMAS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Most lung cancers are carcinomas, which start in the cells lining the airways of the lungs."</data>
      <data key="d5">"cancer type, classification"</data>
      <data key="d6">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="&quot;LUNG CANCER&quot;" target="&quot;BRONCHIOLI&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Lung cancer cells can form from cells lining the bronchioli, smaller airways in the lungs."</data>
      <data key="d5">"anatomical origin, disease development"</data>
      <data key="d6">chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </edge>
    <edge source="&quot;LUNG CANCER&quot;" target="&quot;ALVEOLI&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Lung cancer cells can form from cells lining the alveoli, where oxygen transfer occurs."</data>
      <data key="d5">"anatomical origin, disease development"</data>
      <data key="d6">chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </edge>
    <edge source="&quot;LUNG CANCER&quot;" target="&quot;TRACHEA&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Lung cancer can develop in the trachea, which splits into bronchi, part of the airway system."</data>
      <data key="d5">"anatomical origin, disease development"</data>
      <data key="d6">chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </edge>
    <edge source="&quot;LUNG CANCER&quot;" target="&quot;TUMORS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Lung cancer cells grow out of control and form tumors, which can spread outside the lung."</data>
      <data key="d5">"disease manifestation, tumor formation"</data>
      <data key="d6">chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </edge>
    <edge source="&quot;LUNG CANCER&quot;" target="&quot;NSCLC&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"NSCLC is a type of lung cancer."</data>
      <data key="d5">"cancer classification"</data>
      <data key="d6">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
    </edge>
    <edge source="&quot;LUNG CANCER&quot;" target="&quot;BRONCHI&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Lung cancer cells can form from cells lining the bronchi, part of the airway system."</data>
      <data key="d5">"anatomical origin, disease development"</data>
      <data key="d6">chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </edge>
    <edge source="&quot;LUNG CANCER&quot;" target="&quot;NCCN&quot;">
      <data key="d3">7.0</data>
