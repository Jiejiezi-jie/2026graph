      <data key="d3">8.0</data>
      <data key="d4">"A radiologist analyzes imaging results to help identify primary CNS lymphoma and guide next steps."</data>
      <data key="d5">"diagnostic collaboration, image analysis"</data>
      <data key="d6">chunk-a0d4d6b091e033fd01aa721422b68ef5</data>
    </edge>
    <edge source="&quot;PRIMARY CNS LYMPHOMA&quot;" target="&quot;NEUROSURGEON&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"A neurosurgeon performs stereotactic biopsies to obtain tissue samples for diagnosing primary CNS lymphoma."</data>
      <data key="d5">"surgical procedure, diagnostic process"</data>
      <data key="d6">chunk-a0d4d6b091e033fd01aa721422b68ef5</data>
    </edge>
