      <data key="d3">16.0</data>
      <data key="d4">"The care team discusses treatment options and provides care for patients with primary CNS lymphoma."&lt;SEP&gt;"The care team uses imaging and biopsy results to plan treatment for primary CNS lymphoma."</data>
      <data key="d5">"care, treatment planning"&lt;SEP&gt;"treatment planning, multidisciplinary care"</data>
      <data key="d6">chunk-a0d4d6b091e033fd01aa721422b68ef5&lt;SEP&gt;chunk-4966a628b12ecec4187796598764cf23</data>
    </edge>
