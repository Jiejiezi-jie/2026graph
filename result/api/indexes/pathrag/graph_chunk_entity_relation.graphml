      <data key="d4">"Biomarker testing may be performed on metastatic cervical cancer tumors to determine eligibility for targeted therapies or immunotherapies."</data>
      <data key="d5">"diagnostic testing, personalized treatment"</data>
      <data key="d6">chunk-9d0e32bdc49dbab9c2c953abf363e317</data>
    </edge>
