      <data key="d2">chunk-650982a589c2d527bc13923ccd0569ef</data>
    </node>
    <node id="&quot;CARNEY COMPLEX&quot;">
      <data key="d0">"CATEGORY"</data>
      <data key="d1">"Carney complex is a hereditary condition associated with an increased risk of adrenal tumors."&lt;SEP&gt;"Carney complex is a hereditary syndrome linked to increased risk of thyroid cancer."</data>
      <data key="d2">chunk-18b5e32980f3efa0cd012e2abab9b9fc&lt;SEP&gt;chunk-7102a43dfb62e649d725bc95ba292688</data>
    </node>
    <node id="&quot;RECEPTOR STATUS&quot;">
