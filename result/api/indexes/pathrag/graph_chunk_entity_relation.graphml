      <data key="d3">6.0</data>
      <data key="d4">"The NCCN app offers patient guides for lung cancer, including information on SCLC."</data>
      <data key="d5">"resource, guidance"</data>
      <data key="d6">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
