      <data key="d3">5.0</data>
      <data key="d4">"Vincristine may be added to methotrexate and rituximab for induction therapy."</data>
      <data key="d5">"combination therapy, drug addition"</data>
      <data key="d6">chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </edge>
