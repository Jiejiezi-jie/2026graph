      <data key="d3">15.0</data>
      <data key="d4">"An eye exam is necessary for everyone diagnosed with primary CNS lymphoma to check for vitreoretinal lymphoma."&lt;SEP&gt;"An eye exam is used to check for lymphoma involvement in the eyes, which can occur in primary CNS lymphoma."</data>
      <data key="d5">"diagnosis, eye health"&lt;SEP&gt;"diagnosis, testing"</data>
      <data key="d6">chunk-fba176235a4410ba8723447134c92579&lt;SEP&gt;chunk-4966a628b12ecec4187796598764cf23</data>
    </edge>
