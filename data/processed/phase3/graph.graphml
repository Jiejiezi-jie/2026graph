      <data key="d18">0.95</data>
      <data key="d19">[{"confidence":0.95,"evidence_quote":"Dandy Dick, I denounce you! GEORGIANA. As the owner of the other half, _I_ denounce you!","source_chunk_id":"dd_act03s02_c0007"},{"confidence":0.95,"evidence_quote":"Dandy Dick, I denounce you! GEORGIANA. As the owner of the other half, _I_ denounce you!","source_chunk_id":"dd_act03s02_c0008"},{"confidence":0.9,"evidence_quote":"John sold you half of Dick, and I can swear I don't own a horse--and I don't--not a whole one. But half a horse is better than no bread, Tris--and we're partners. SIR TRISTRAM. [_Roaring with laughter._] Ho! ho! ha! ha! ha! GEORGIANA","source_chunk_id":"dd_act01_c0016"}]</data>
