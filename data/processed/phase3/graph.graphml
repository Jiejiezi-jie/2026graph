    <edge source="n_blore_bc324ff851ac" target="n_the_deanery_of_st_marvells_25cc7034d77b" id="e_n_blore_bc324ff851ac_f9a10ef284c720">
      <data key="d9">e_n_blore_bc324ff851ac_f9a10ef284c720</data>
      <data key="d10">Blore</data>
      <data key="d11">The Deanery of St. Marvells</data>
      <data key="d12">EMPLOYED_BY</data>
      <data key="d13">True</data>
      <data key="d14">Blore is a servant in the Deanery.</data>
      <data key="d15">["Blore is a servant in the Deanery."]</data>
      <data key="d16">BLORE. [_Rushing forward, snatching the basin from THE DEAN and sinking on to his knees._] No, no! Don't, don't! You wouldn't 'ang the holdest servant in the Deanery</data>
