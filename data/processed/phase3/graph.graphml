    <node id="n_arthur_w_pinero_e79bd27a36a1">
      <data key="d3">Arthur W. Pinero</data>
      <data key="d4">PERSON</data>
      <data key="d5">Author of Dandy Dick and other plays. | The dramatist who wrote Dandy Dick and The Schoolmistress. | Author of the play Dandy Dick.</data>
      <data key="d6">["Author of Dandy Dick and other plays.","The dramatist who wrote Dandy Dick and The Schoolmistress.","Author of the play Dandy Dick."]</data>
