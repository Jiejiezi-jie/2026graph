      <data key="d19">[{"confidence":0.95,"evidence_quote":"Dr. Jedd, the Dean of St. Marvells","source_chunk_id":"dd_act01_c0008"},{"confidence":0.95,"evidence_quote":"Dr. Jedd, the Dean of St. Marvells.","source_chunk_id":"dd_act03s01_c0010"},{"confidence":0.95,"evidence_quote":"The Very Reverend Augustin Jedd, Dean of St. Marvells.","source_chunk_id":"dd_act03s01_c0011"},{"confidence":0.9,"evidence_quote":"the Dean of St. Marvells","source_chunk_id":"dd_act03s02_c0010"},{"confidence":0.9,"evidence_quote":"Dr. Jedd, the Dean of St. Marvells","source_chunk_id":"dd_act03s02_c0009"},{"confidence":0.9,"evidence_quote":"THE DEAN. Mardon, you don't understand. My position in St. Marvells----","source_chunk_id":"dd_act01_c0014"},{"confidence":0.9,"evidence_quote":"THE DEAN. \"At the Deanery of St. Marvells, with the cares of a household","source_chunk_id":"dd_act01_c0010"},{"confidence":0.9,"evidence_quote":"THE DEAN. How could I face my simple children who have hitherto, not unreasonably, regarded me as faultless? How could I again walk erect in the streets of St. Marvells","source_chunk_id":"dd_act03s01_c0006"},{"confidence":0.85,"evidence_quote":"THE DEAN. Mardon, you don't understand. My position in St. Marvells----","source_chunk_id":"dd_act01_c0013"},{"confidence":0.6,"evidence_quote":"these terrible races at St. Marvells. _BLORE enters with a card._ THE DEAN","source_chunk_id":"dd_act01_c0012"}]</data>
