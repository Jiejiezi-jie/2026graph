    <node id="n_dandy_dick_play_3b5ef6517439">
      <data key="d3">Dandy Dick (play)</data>
      <data key="d4">CREATIVE_WORK</data>
      <data key="d5">A play in three acts by Arthur W. Pinero. | A farce written by Mr. Pinero for the old Court Theatre, produced on January 27th, 1887. | An original farce in three acts by A. W. Pinero, performed at the Royal Court Theatre. | A play by Arthur W. Pinero that was performed 171 times in London and later toured in the provinces and abroad.</data>
      <data key="d6">["A play in three acts by Arthur W. Pinero.","A farce written by Mr. Pinero for the old Court Theatre, produced on January 27th, 1887.","An original farce in three acts by A. W. Pinero, performed at the Royal Court Theatre.","A play by Arthur W. Pinero that was performed 171 times in London and later toured in the provinces and abroad."]</data>
      <data key="d7">["Dandy Dick"]</data>
